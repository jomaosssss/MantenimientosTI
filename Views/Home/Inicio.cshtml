            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-print me-1"></i> Impresoras
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaImpresoras" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha de reporte</th>
                                    <th>Zona</th>
                                    <th>Agencia</th>
                                    <th>Centro</th>
                                    <th>Núm. serie de impresora</th>
                                    <th>Usuario que reporta</th>
                                    <th>Núm. de orden</th>
                                    <th>Folio de atención</th>
                                    <th>Estatus</th>
                                    <th>Inf. del equipo</th>
                                    <th>Cancelaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Impresoras)
                                {
                                    <tr data-num-act-fijo="@item.NumActFijo" data-clave-agenda="@item.ClaveAgenda"
                                        data-tipo-equipo="IMPRESORA" class="@(item.TipoMantenimiento == "CORRECTIVO" ? "table-danger" : "")">
                                        <td data-order="@item.FechaProgramada.ToDateTime(TimeOnly.MinValue).Ticks">
                                            @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@item.Zona</td>
                                        <td>@item.Agencia</td>
                                        <td>@item.Centro</td>
                                        <td>@item.NumSerie</td>
                                        <td>@item.UsuarioReporta</td>
                                        <td>@item.ClaveAgenda</td>
                                        <td>@item.FolioAtencion</td>
                                        <td>
                                            <span class="badge bg-info estatus-agenda">@item.Estatus</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-info-equipo"
                                                    data-num-act-fijo="@item.NumActFijo"
                                                    data-clave-agenda="@item.ClaveAgenda">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estatus == "PENDIENTE")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <button class="btn btn-warning btn-sm btn-precancelar" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else if (item.Estatus == "PRE-CANCELADO")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="@item.ClaveAgenda" title="Confirmar Cancelación">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="@item.ClaveAgenda" title="Rechazar Cancelación">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <span class="text-muted fst-italic">En espera de aprobación</span>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MODALES -->
    <div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="modalInfoLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalInfoLabel">Información del Equipo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalInfoBody">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalPdfComputo" tabindex="-1" aria-labelledby="modalPdfComputoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPdfComputoLabel">Hoja de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formHojaServicioComputo">
                        <input type="hidden" id="numActFijoPdfComputo" name="numActFijo" />
                        <input type="hidden" id="fechaProgramadaPdfComputo" name="fechaProgramada" />

                        <div class="alert alert-info mb-3" id="seccionConfirmacion">
                            ¿El Equipo de Cómputo está asignado a:
                            <strong><span id="rpeAsignado"></span> - <span id="nombreAsignado"></span></strong>?
                        </div>

                        <div class="d-flex justify-content-between mt-4" id="botonesConfirmacion">
                            <button type="button" id="btnModificarComputo" class="btn btn-warning">
                                <i class="bi bi-pencil me-2"></i>No, Modificar
                            </button>
                            <button type="button" id="btnContinuarComputo" class="btn btn-success">
                                <i class="bi bi-check-circle me-2"></i>Sí, Descargar PDF
                            </button>
                        </div>

                        <div id="camposModificacion" style="display: none;" class="mt-3">
                            <div class="mb-3">
                                <label for="rpeComputo" class="form-label">RPE:</label>
                                <input type="text" class="form-control" id="rpeComputo" name="rpe" placeholder="Ingrese el nuevo RPE">
                            </div>
                            <div class="mb-3">
                                <label for="nombreComputo" class="form-label">Nombre:</label>
                                <input type="text" class="form-control" id="nombreComputo" name="nombre" placeholder="Ingrese el nuevo nombre">
                            </div>
                            <div class="d-grid">
                                <button type="button" id="btnDescargarComputo" class="btn btn-success">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalPdf" tabindex="-1" aria-labelledby="modalPdfLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPdfLabel">Hoja de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formHojaServicio">
                        <input type="hidden" id="numActFijoPdf" name="numActFijo" />
                        <input type="hidden" id="fechaProgramadaPdf" name="fechaProgramada" />
                        <input type="hidden" id="numCajeroPdf" name="numCajero" />
                        <div class="mb-3">
                            <label for="responsable" class="form-label">Responsable del mantenimiento:</label>
                            <select class="form-select" id="responsable" name="responsable" required>
                                <option value="TECNICO_DE_ZONA" selected>TÉCNICO DE ZONA</option>
                                <option value="TECNICO_EXTERNO">TÉCNICO EXTERNO</option>
                            </select>
                        </div>
                        <div class="mb-3" id="divTecnicoExterno" style="display: none;">
                            <label for="nombreTecnico" class="form-label">Nombre del Técnico Externo:</label>
                            <input type="text" class="form-control" id="nombreTecnico" name="nombreTecnico">
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" id="btnGenerarPdf" class="btn btn-success">
                                <i class="bi bi-file-earmark-pdf me-2"></i>Generar PDF
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            var esAdmin = @User.IsInRole("ADMINISTRADOR").ToString().ToLower();

            // Configuración para las tablas
            $('#tablaCFEmaticos, #tablaAC, #tablaEC, #tablaImpresoras').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });

            // Evento para mostrar detalles del equipo (todos los tipos: CFEmáticos, AC, Cómputo, Impresoras)
            $(document).on('click', '.btn-info-equipo', function(e) {
                e.preventDefault();

                var numActFijo = $(this).data('num-act-fijo');
                var claveAgenda = $(this).data('clave-agenda');

                // Mostrar loading
                $('#modalInfoBody').html('<div class="text-center p-4"><div class="spinner-border" role="status"></div><p class="mt-2">Cargando información...</p></div>');

                // Mostrar el modal
                var modal = new bootstrap.Modal(document.getElementById('modalInfo'));
                modal.show();

                // Hacer la petición AJAX
                $.get('/Home/ObtenerDetallesEquipo', {
                    numActFijo: numActFijo,
                    claveAgenda: claveAgenda
                }, function(data) {
                    $('#modalInfoBody').html(data);
                }).fail(function() {
                    $('#modalInfoBody').html('<div class="alert alert-danger">Error al cargar la información del equipo.</div>');
                });
            });

            // Para resetear el modal al cerrar
            $('#modalInfo').on('hidden.bs.modal', function (e) {
                $('#modalInfoBody').html('');
            });

            // FUNCIONES MEJORADAS DE CANCELACIÓN
            function mostrarModalCancelacion(idAgenda, esAdmin) {
                const titulo = esAdmin ? 'Cancelar Mantenimiento' : 'Solicitar Cancelación';
                const textoConfirmacion = esAdmin ?
                    'Este mantenimiento será cancelado permanentemente.' :
                    'Esta solicitud de cancelación será enviada a un administrador para su aprobación.';

                // Hacer petición para obtener los motivos del catálogo
                $.get('@Url.Action("ObtenerMotivosCancelacion", "Agenda")', function(motivos) {
                    // Construir opciones del dropdown
                    let opcionesMotivos = '<option value="">Seleccione un motivo</option>';
                    if (motivos && motivos.length > 0) {
                        motivos.forEach(function(motivo) {
                            opcionesMotivos += `<option value="${motivo.claveMotivo}">${motivo.motivoCancelacion}</option>`;
                        });
                    }

                    Swal.fire({
                        title: titulo,
                        html: `
                            <div class="text-start">
                                <p>${textoConfirmacion}</p>
                                <div class="mb-3">
                                    <label for="motivoCancelacion" class="form-label">Motivo de cancelación:</label>
                                    <select class="form-select" id="motivoCancelacion" required>
                                        ${opcionesMotivos}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="justificacionCancelacion" class="form-label">
                                        Justificación detallada:
                                        <small class="text-muted float-end">
                                            <span id="contadorCaracteres">0</span>/500 caracteres
                                    </small>
                                    </label>
                                    <textarea class="form-control" id="justificacionCancelacion"
                                              rows="4"
                                              maxlength="500"
                                              placeholder="Describa detalladamente el motivo de la cancelación..."
                                              required></textarea>
                                    <div class="form-text">
                                        <span id="caracteresRestantes" class="text-muted">500 caracteres restantes</span>
                                    </div>
                                </div>
                            </div>
                        `,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: esAdmin ? '#d33' : '#3085d6',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: esAdmin ? 'Sí, cancelar' : 'Sí, solicitar',
                        cancelButtonText: 'Cancelar',
                        focusConfirm: false,
                        preConfirm: () => {
                            const claveMotivo = parseInt(document.getElementById('motivoCancelacion').value);
                            const justificacion = document.getElementById('justificacionCancelacion').value;

                            if (!claveMotivo || claveMotivo <= 0) {
                                Swal.showValidationMessage('Por favor seleccione un motivo válido');
                                return false;
                            }
                            if (!justificacion.trim()) {
                                Swal.showValidationMessage('Por favor ingrese una justificación');
                                return false;
                            }
                            if (justificacion.trim().length < 10) {
                                Swal.showValidationMessage('La justificación debe tener al menos 10 caracteres');
                                return false;
                            }
                            if (justificacion.trim().length > 500) {
                                Swal.showValidationMessage('La justificación no puede exceder los 500 caracteres');
                                return false;
                            }

                            return { claveMotivo, justificacion };
                        },
                        didOpen: () => {
                            const textarea = document.getElementById('justificacionCancelacion');
                            const contador = document.getElementById('contadorCaracteres');
                            const restantes = document.getElementById('caracteresRestantes');

                            // Event listener para el contador
                            textarea.addEventListener('input', function() {
                                if (this.value.length > 500) {
                                    this.value = this.value.substring(0, 500);
                                }

                                const longitud = this.value.length;
                                contador.textContent = longitud;
                                const caracteresRestantes = 500 - longitud;
                                restantes.textContent = `${caracteresRestantes} caracteres restantes`;

                                // Cambiar color según el límite
                                if (longitud > 450) {
                                    contador.className = 'text-warning fw-bold';
                                    restantes.className = 'text-warning fw-bold';
                                } else if (longitud >= 500) {
                                    contador.className = 'text-danger fw-bold';
                                    restantes.className = 'text-danger fw-bold';
                                } else {
                                    contador.className = 'text-muted';
                                    restantes.className = 'text-muted';
                                }
                            });
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const { claveMotivo, justificacion } = result.value;
                            if (esAdmin) {
                                cancelarDirecto(idAgenda, claveMotivo, justificacion);
                            } else {
                                preCancelar(idAgenda, claveMotivo, justificacion);
                            }
                        }
                    });
                }).fail(function() {
                    Swal.fire('Error', 'No se pudieron cargar los motivos de cancelación', 'error');
                });
            }

            function cancelarDirecto(idAgenda, claveMotivo, justificacion) {
                const fila = $(`tr[data-clave-agenda="${idAgenda}"]`);
                const button = fila.find('.btn-cancelar-directo');

                $.post('@Url.Action("CancelarDirecto", "Agenda")', {
                    idAgenda: idAgenda,
                    claveMotivo: claveMotivo,
                    justificacion: justificacion
                })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire('¡Cancelado!', response.message, 'success');
                        // Actualizar la fila
                        const celdaEstatus = fila.find('.estatus-agenda');
                        celdaEstatus.html('<span class="badge bg-secondary">CANCELADO</span>');

                        const celdaAcciones = button.closest('td');
                        celdaAcciones.html('<span class="text-muted">N/A</span>');
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                })
                .fail(function() {
                    Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                });
            }

            function preCancelar(idAgenda, claveMotivo, justificacion) {
                const fila = $(`tr[data-clave-agenda="${idAgenda}"]`);
                const button = fila.find('.btn-precancelar');

                $.post('@Url.Action("PreCancelar", "Agenda")', {
                    idAgenda: idAgenda,
                    claveMotivo: claveMotivo,
                    justificacion: justificacion
                })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire('¡Solicitud Enviada!', response.message, 'success');
                        // Actualizar la fila
                        const celdaEstatus = fila.find('.estatus-agenda');
                        celdaEstatus.html('<span class="badge bg-warning text-dark">PRE-CANCELADO</span>');

                        const celdaAcciones = button.closest('td');
                        if (esAdmin) {
                            celdaAcciones.html(`
                                <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="${idAgenda}" title="Confirmar Cancelación">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                                <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="${idAgenda}" title="Rechazar Cancelación">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            `);
                        } else {
                            celdaAcciones.html('<span class="text-muted fst-italic">En espera de aprobación</span>');
                        }
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                })
                .fail(function() {
                    Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                });
            }

            // EVENT HANDLERS PARA CANCELACIONES
            $(document).on('click', '.btn-cancelar-directo', function() {
                const id = $(this).data('id');
                mostrarModalCancelacion(id, true);
            });

            $(document).on('click', '.btn-precancelar', function() {
                const id = $(this).data('id');
                mostrarModalCancelacion(id, false);
            });

            $(document).on('click', '.btn-confirmar-cancelacion', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');

                Swal.fire({
                    title: '¿Confirmar Cancelación?',
                    text: "La pre-cancelación será confirmada permanentemente.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("ConfirmarCancelacion", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Confirmada!', response.message, 'success');

                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-secondary">CANCELADO</span>');

                                    var celdaAcciones = fila.find('td:last');
                                    celdaAcciones.html('<span class="text-muted">N/A</span>');
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            $(document).on('click', '.btn-rechazar-cancelacion', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');

                Swal.fire({
                    title: '¿Rechazar Cancelación?',
                    text: "El mantenimiento volverá a estatus PENDIENTE.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, rechazar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("ReactivarAgenda", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Rechazada!', 'El mantenimiento ha sido reactivado.', 'success');

                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-info">PENDIENTE</span>');

                                    var celdaAcciones = fila.find('td:last');
                                    if (esAdmin) {
                                        celdaAcciones.html('<button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="' + id + '">Cancelar</button>');
                                    } else {
                                        celdaAcciones.html('<button class="btn btn-warning btn-sm btn-precancelar" data-id="' + id + '">Cancelar</button>');
                                    }
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            // Para generar los PDFs
            $('#tablaCFEmaticos').on('click', '[data-bs-target="#modalPdf"]', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var fechaProgramada = fila.find('td:first').text().trim();
                var numCajero = fila.find('td:nth-child(6)').text().trim();

                $('#numActFijoPdf').val(numActFijo);
                $('#fechaProgramadaPdf').val(fechaProgramada);
                $('#numCajeroPdf').val(numCajero);

                $('#formHojaServicio')[0].reset();
                $('#divTecnicoExterno').hide();
                $('#nombreTecnico').prop('required', false);
            });

            $('#tablaAC').on('click', '.btnGenerarPdf', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var tipoEquipo = fila.data('tipo-equipo');
                var fechaProgramada = fila.find('td:first').text().trim();

                var prefix = 'HojaServicio';
                if (tipoEquipo.toUpperCase().includes('CFECAM')) {
                    prefix += 'CFECAM';
                } else if (tipoEquipo.toUpperCase().includes('CFETURNO')) {
                    prefix += 'CFETURNO';
                } else {
                    prefix += 'EquipoAC';
                }

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                $.ajax({
                    url: '/Home/GenerarHojaServicio',
                    type: 'POST',
                    data: {
                        numActFijo: numActFijo,
                        fechaProgramada: fechaProgramada,
                        responsable: "TECNICO_DE_ZONA",
                        nombreTecnico: "@Context.Session.GetString("NombreUsuario")",
                        tipoEquipo: tipoEquipo
                    },
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function(data) {
                        var url = URL.createObjectURL(data);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = prefix + '_' + numActFijo + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function() {
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                        }, 100);
                    },
                    error: function(xhr) {
                        alert('Error al generar el PDF: ' + xhr.responseText);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html('<i class="bi bi-file-earmark-pdf"></i>Descargar');
                    }
                });
            });

            $('#tablaEC').on('click', '.btnGenerarPdf', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var fechaProgramada = fila.find('td:first').text().trim();

                $.get('/Home/ObtenerDatosComputo', { numActFijo: numActFijo }, function(data) {
                    $('#numActFijoPdfComputo').val(numActFijo);
                    $('#fechaProgramadaPdfComputo').val(fechaProgramada);
                    $('#rpeAsignado').text(data.rpe);
                    $('#nombreAsignado').text(data.nombre);
                    $('#rpeComputo').val('');
                    $('#nombreComputo').val('');
                    $('#camposModificacion').hide();
                    $('#modalPdfComputo').modal('show');
                });
            });

            $('#responsable').change(function() {
                if ($(this).val() === 'TECNICO_EXTERNO') {
                    $('#divTecnicoExterno').show();
                    $('#nombreTecnico').prop('required', true);
                } else {
                    $('#divTecnicoExterno').hide();
                    $('#nombreTecnico').prop('required', false);
                }
            });

            $('#btnGenerarPdf').click(function() {
                if ($('#formHojaServicio')[0].checkValidity()) {
                    var formData = $('#formHojaServicio').serialize();
                    var $btn = $(this);
                    var numCajero = $('#numCajeroPdf').val();
                    var fileName = numCajero ?
                        'HojaServicioCFEMATICO_' + numCajero + '.pdf' :
                        'HojaServicioCFEMATICO_' + $('#numActFijoPdf').val() + '.pdf';

                    $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                    $.ajax({
                        url: '/Home/GenerarHojaServicio',
                        type: 'POST',
                        data: formData,
                        xhrFields: {
                            responseType: 'blob'
                        },
                        success: function(data) {
                            var url = URL.createObjectURL(data);
                            var a = document.createElement('a');
                            a.href = url;
                            a.download = fileName;
                            document.body.appendChild(a);
                            a.click();
                            setTimeout(function() {
                                document.body.removeChild(a);
                                URL.revokeObjectURL(url);
                                $('#modalPdf').modal('hide');
                            }, 100);
                        },
                        error: function(xhr) {
                            alert('Error al generar el PDF: ' + xhr.responseText);
                        },
                        complete: function() {
                            $btn.prop('disabled', false).html('<i class="bi bi-file-earmark-pdf me-2"></i>Generar PDF');
                        }
                    });
                } else {
                    $('#formHojaServicio')[0].reportValidity();
                }
            });

            $('#btnContinuarComputo').click(function() {
                descargarPdfComputo(false);
            });

            $('#btnModificarComputo').click(function() {
                $('#camposModificacion').show();
            });

            $('#btnDescargarComputo').click(function() {
                descargarPdfComputo(true);
            });

            function descargarPdfComputo(usarDatosModificados) {
                var formData = {
                    numActFijo: $('#numActFijoPdfComputo').val(),
                    fechaProgramada: $('#fechaProgramadaPdfComputo').val(),
                    responsable: "TECNICO_DE_ZONA",
                    nombreTecnico: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NombreUsuario")))
                };

                if (usarDatosModificados) {
                    if (!$('#rpeComputo').val() || !$('#nombreComputo').val()) {
                        alert('Por favor complete ambos campos (RPE y Nombre)');
                        return;
                    }
                    formData.rpe = $('#rpeComputo').val();
                    formData.nombre = $('#nombreComputo').val();
                }

                var $btn = $('#btnDescargarComputo, #btnContinuarComputo').filter(':visible');
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                $.ajax({
                    url: '/Home/GenerarHojaServicioComputo',
                    type: 'POST',
                    data: formData,
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function(data) {
                        var url = URL.createObjectURL(data);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = 'HojaServicioEquipoComputo_' + formData.numActFijo + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function() {
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                            $('#modalPdfComputo').modal('hide');
                        }, 100);
                    },
                    error: function(xhr) {
                        alert('Error al generar el PDF: ' + xhr.responseText);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html(usarDatosModificados ?
                            '<i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF' :
                            '<i class="bi bi-check-circle me-2"></i>Sí, Descargar PDF');
                    }
                });
            }
        });
    </script>
}