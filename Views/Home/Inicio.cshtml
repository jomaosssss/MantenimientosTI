@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model MantenimientosTI.Models.ViewModels.VMAgendaInicio
@using System.Globalization
@{
    // Obtener el mes actual y siguiente
    var mesActual = DateTime.Now.ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
    var mesSiguiente = DateTime.Now.AddMonths(1).ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
    var mesAnterior = DateTime.Now.AddMonths(-1).ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
}
<style>
    /* Estilos para las filas de la tabla */
    tr.table-danger {
        background-color: #ffcccc !important;
    }

        tr.table-danger td {
            color: #721c24 !important;
        }

    .leyenda-mantenimientos {
        font-size: 0.9rem;
    }

    .color-box {
        border: 1px solid #dee2e6;
        border-radius: 3px;
    }

    /* ESTILOS MEJORADOS PARA LAS TARJETAS */
    .stats-card {
        border-radius: 12px;
        min-height: 100px;
        border: none;
        transition: all 0.3s ease;
        flex: 1;
        min-width: 0;
    }

    .stats-card-content {
        padding: 0.9rem;
    }

    .stats-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
        font-weight: 600;
    }

    .stats-number {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .stats-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* Contenedor flex para las tarjetas */
    .cards-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Colores de las tarjetas - ACTUALIZADO: NARANJA EN LUGAR DE ROJO */
    .card-orange {
        background-color: #fd7e14;
    }
    /* Naranja Bootstrap */
    .card-blue {
        background-color: #0d6efd;
    }

    .card-green {
        background-color: #28a745;
    }

    .card-yellow {
        background-color: #ffc107;
    }

    .card-gray {
        background-color: #808080;
    }

    /* Efectos hover mejorados - ACTUALIZADO PARA NARANJA */
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    }

    .card-orange:hover {
        box-shadow: 0 6px 15px rgba(253, 126, 20, 0.25) !important;
    }

    .card-blue:hover {
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.25) !important;
    }

    .card-green:hover {
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.25) !important;
    }

    .card-yellow:hover {
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.25) !important;
    }

    .card-gray:hover {
        box-shadow: 0 6px 15px rgba(128, 128, 128, 0.25) !important;
    }

    /* Para mantener la alineación en móviles */
    @@media (max-width: 768px) {
        .card-header {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .leyenda-mantenimientos {
            margin-top: 10px;
        }

        .cards-container {
            gap: 8px;
        }

        .stats-card {
            min-height: 90px;
            flex: 1 1 calc(50% - 8px);
        }

        .stats-number {
            font-size: 1.5rem;
        }

        .stats-icon {
            width: 38px;
            height: 38px;
            font-size: 1.1rem;
        }

        .stats-badge {
            font-size: 0.7rem;
        }
    }

    /* Para pantallas muy pequeñas */
    @@media (max-width: 576px) {
        .table-responsive table {
            min-width: 1100px;
        }

        .container {
            padding-left: 10px;
            padding-right: 10px;
        }

        .card-body {
            padding: 0.5rem;
        }

        .stats-card-content {
            padding: 0.7rem;
        }

        .stats-number {
            font-size: 1.4rem;
        }

        .stats-card {
            flex: 1 1 100%;
            min-height: 85px;
        }

        .cards-container {
            gap: 6px;
        }

        .stats-badge {
            font-size: 0.68rem;
        }
    }

    /* Para pantallas grandes */
    @@media (min-width: 1200px) {
        .stats-card {
            flex: 1;
            min-width: 0;
        }
    }

    /* Mejoras generales para tablas */
    .table th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .text-orange {
        color: #fd7e14 !important;
    }
</style>

<div class="container mt-4">

    <div class="card mt-3 shadow-sm rounded">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Bienvenid@@, @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Context.Session.GetString("NombreUsuario")?.ToLower() ?? "")</h2>
            <div class="leyenda-mantenimientos d-flex gap-3">
                <div class="d-flex align-items-center">
                    <div class="color-box bg-white border me-2" style="width: 20px; height: 20px;"></div>
                    <span>PREVENTIVO</span>
                </div>
                <div class="d-flex align-items-center">
                    <div class="color-box bg-danger me-2" style="width: 20px; height: 20px;"></div>
                    <span>CORRECTIVO</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- CONTENEDOR FLEX PARA LAS 5 TARJETAS -->
            <div class="cards-container mb-3">
                <!-- Tarjeta Naranja - Pendientes Mes Anterior -->
                <div class="card stats-card card-orange">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-orange mb-1">PENDIENTES @mesAnterior</span>
                                <h2 class="stats-number text-white">@Model.PendientesMesAnteriorCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-exclamation-triangle text-orange"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Azul - Programados Mes Actual -->
                <div class="card stats-card card-blue">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-primary mb-1">PROGRAMADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Verde - Terminados Mes Actual -->
                <div class="card stats-card card-green">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-success mb-1">TERMINADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.TerminadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Amarilla - Pendientes Mes Actual -->
                <div class="card stats-card card-yellow">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-warning mb-1">PENDIENTES @mesActual</span>
                                <h2 class="stats-number text-white">@Model.PendientesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-spinner text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Gris - Programados Próximo Mes -->
                <div class="card stats-card card-gray">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-secondary mb-1">PROGRAMADOS @mesSiguiente</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosProximoMesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-dark text-center mt-3 mb-3 h4">Mantenimientos pendientes. ¡Buena suerte!</p>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-table me-1"></i> CFEmáticos
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaCFEmaticos" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha programada</th>
                                    <th>Zona</th>
                                    <th>Agencia</th>
                                    <th>Centro</th>
                                    <th>Tipo de equipo</th>
                                    <th>Núm. de cajero</th>
                                    <th>Núm. de orden</th>
                                    <th>Estatus</th>
                                    <th>Inf. del equipo</th>
                                    <th>Hoja de servicio</th>
                                    <th>Cancelaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Cfematicos)
                                {
                                    <tr data-num-act-fijo="@item.NumActFijo" data-clave-agenda="@item.ClaveAgenda" class="@(item.TipoMantenimiento == "CORRECTIVO" ? "table-danger" : "")">
                                        <td data-order="@item.FechaProgramada.ToDateTime(TimeOnly.MinValue).Ticks">
                                            @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@item.Zona</td>
                                        <td>@item.Agencia</td>
                                        <td>@item.Centro</td>
                                        <td>@item.Tipo</td>
                                        <td>@item.NumCajero</td>
                                        <td>@item.ClaveAgenda</td>
                                        <td>
                                            <span class="badge bg-info estatus-agenda">@item.Estatus</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-info-equipo"
                                                    data-num-act-fijo="@item.NumActFijo"
                                                    data-clave-agenda="@item.ClaveAgenda">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-descargar-pdf" data-bs-toggle="modal" data-bs-target="#modalPdf">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estatus == "PENDIENTE")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <button class="btn btn-warning btn-sm btn-precancelar" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else if (item.Estatus == "PRE-CANCELADO")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="@item.ClaveAgenda" title="Confirmar Cancelación">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="@item.ClaveAgenda" title="Rechazar Cancelación">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <span class="text-muted fst-italic">En espera de aprobación</span>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-table me-1"></i> Equipos de atención a clientes
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaAC" class="table table-striped table-bordered">
