@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model MantenimientosTI.Models.ViewModels.VMAgendaInicio
@using System.Globalization
@{
    // Obtener el mes actual y siguiente
    var mesActual = DateTime.Now.ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
    var mesSiguiente = DateTime.Now.AddMonths(1).ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
    var mesAnterior = DateTime.Now.AddMonths(-1).ToString("MMMM", new CultureInfo("es-ES")).ToUpper();
}
<style>
    /* Estilos para las filas de la tabla */
    tr.table-danger {
        background-color: #ffcccc !important;
    }

        tr.table-danger td {
            color: #721c24 !important;
        }

    .leyenda-mantenimientos {
        font-size: 0.9rem;
    }

    .color-box {
        border: 1px solid #dee2e6;
        border-radius: 3px;
    }

    /* ESTILOS MEJORADOS PARA LAS TARJETAS */
    .stats-card {
        border-radius: 12px;
        min-height: 100px;
        border: none;
        transition: all 0.3s ease;
        flex: 1;
        min-width: 0;
    }

    .stats-card-content {
        padding: 0.9rem;
    }

    .stats-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
        font-weight: 600;
    }

    .stats-number {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .stats-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* Contenedor flex para las tarjetas */
    .cards-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Colores de las tarjetas - ACTUALIZADO: NARANJA EN LUGAR DE ROJO */
    .card-orange {
        background-color: #fd7e14;
    }
    /* Naranja Bootstrap */
    .card-blue {
        background-color: #0d6efd;
    }

    .card-green {
        background-color: #28a745;
    }

    .card-yellow {
        background-color: #ffc107;
    }

    .card-gray {
        background-color: #808080;
    }

    /* Efectos hover mejorados - ACTUALIZADO PARA NARANJA */
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    }

    .card-orange:hover {
        box-shadow: 0 6px 15px rgba(253, 126, 20, 0.25) !important;
    }

    .card-blue:hover {
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.25) !important;
    }

    .card-green:hover {
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.25) !important;
    }

    .card-yellow:hover {
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.25) !important;
    }

    .card-gray:hover {
        box-shadow: 0 6px 15px rgba(128, 128, 128, 0.25) !important;
    }

    /* Para mantener la alineación en móviles */
    @@media (max-width: 768px) {
        .card-header {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .leyenda-mantenimientos {
            margin-top: 10px;
        }

        .cards-container {
            gap: 8px;
        }

        .stats-card {
            min-height: 90px;
            flex: 1 1 calc(50% - 8px);
        }

        .stats-number {
            font-size: 1.5rem;
        }

        .stats-icon {
            width: 38px;
            height: 38px;
            font-size: 1.1rem;
        }

        .stats-badge {
            font-size: 0.7rem;
        }
    }

    /* Para pantallas muy pequeñas */
    @@media (max-width: 576px) {
        .table-responsive table {
            min-width: 1100px;
        }

        .container {
            padding-left: 10px;
            padding-right: 10px;
        }

        .card-body {
            padding: 0.5rem;
        }

        .stats-card-content {
            padding: 0.7rem;
        }

        .stats-number {
            font-size: 1.4rem;
        }

        .stats-card {
            flex: 1 1 100%;
            min-height: 85px;
        }

        .cards-container {
            gap: 6px;
        }

        .stats-badge {
            font-size: 0.68rem;
        }
    }

    /* Para pantallas grandes */
    @@media (min-width: 1200px) {
        .stats-card {
            flex: 1;
            min-width: 0;
        }
    }

    /* Mejoras generales para tablas */
    .table th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .text-orange {
        color: #fd7e14 !important;
    }
</style>

<div class="container mt-4">

    <div class="card mt-3 shadow-sm rounded">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Bienvenid@@, @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Context.Session.GetString("NombreUsuario")?.ToLower() ?? "")</h2>
            <div class="leyenda-mantenimientos d-flex gap-3">
                <div class="d-flex align-items-center">
                    <div class="color-box bg-white border me-2" style="width: 20px; height: 20px;"></div>
                    <span>PREVENTIVO</span>
                </div>
                <div class="d-flex align-items-center">
                    <div class="color-box bg-danger me-2" style="width: 20px; height: 20px;"></div>
                    <span>CORRECTIVO</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- CONTENEDOR FLEX PARA LAS 5 TARJETAS -->
            <div class="cards-container mb-3">
                <!-- Tarjeta Naranja - Pendientes Mes Anterior -->
                <div class="card stats-card card-orange">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-orange mb-1">PENDIENTES @mesAnterior</span>
                                <h2 class="stats-number text-white">@Model.PendientesMesAnteriorCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-exclamation-triangle text-orange"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Azul - Programados Mes Actual -->
                <div class="card stats-card card-blue">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-primary mb-1">PROGRAMADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Verde - Terminados Mes Actual -->
                <div class="card stats-card card-green">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-success mb-1">TERMINADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.TerminadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Amarilla - Pendientes Mes Actual -->
                <div class="card stats-card card-yellow">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-warning mb-1">PENDIENTES @mesActual</span>
                                <h2 class="stats-number text-white">@Model.PendientesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-spinner text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Gris - Programados Próximo Mes -->
                <div class="card stats-card card-gray">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-secondary mb-1">PROGRAMADOS @mesSiguiente</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosProximoMesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-dark text-center mt-3 mb-3 h4">Mantenimientos pendientes. ¡Buena suerte!</p>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-table me-1"></i> CFEmáticos
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaCFEmaticos" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha programada</th>
                                    <th>Zona</th>
                                    <th>Agencia</th>
                                    <th>Centro</th>
                                    <th>Tipo de equipo</th>
                                    <th>Núm. de cajero</th>
                                    <th>Núm. de orden</th>
                                    <th>Estatus</th>
                                    <th>Inf. del equipo</th>
                                    <th>Hoja de servicio</th>
                                    <th>Cancelaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Cfematicos)
                                {
                                    <tr data-num-act-fijo="@item.NumActFijo" data-clave-agenda="@item.ClaveAgenda" class="@(item.TipoMantenimiento == "CORRECTIVO" ? "table-danger" : "")">
                                        <td data-order="@item.FechaProgramada.ToDateTime(TimeOnly.MinValue).Ticks">
                                            @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@item.Zona</td>
                                        <td>@item.Agencia</td>
                                        <td>@item.Centro</td>
                                        <td>@item.Tipo</td>
                                        <td>@item.NumCajero</td>
                                        <td>@item.ClaveAgenda</td>
                                        <td>
                                            <span class="badge bg-info estatus-agenda">@item.Estatus</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#modalInfo">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-descargar-pdf" data-bs-toggle="modal" data-bs-target="#modalPdf">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estatus == "PENDIENTE")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <button class="btn btn-warning btn-sm btn-precancelar" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else if (item.Estatus == "PRE-CANCELADO")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="@item.ClaveAgenda" title="Confirmar Cancelación">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="@item.ClaveAgenda" title="Rechazar Cancelación">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <span class="text-muted fst-italic">En espera de aprobación</span>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-table me-1"></i> Equipos de atención a clientes
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaAC" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha programada</th>
                                    <th>Zona</th>
                                    <th>Agencia</th>
                                    <th>Centro</th>
                                    <th>Tipo de equipo</th>
                                    <th>Núm. de orden</th>
                                    <th>Estatus</th>
                                    <th>Inf. del equipo</th>
                                    <th>Hoja de servicio</th>
                                    <th>Cancelaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AtencionClientes)
                                {
                                    <tr data-num-act-fijo="@item.NumActFijo" data-clave-agenda="@item.ClaveAgenda" data-tipo-equipo="@item.Tipo" class="@(item.TipoMantenimiento == "CORRECTIVO" ? "table-danger" : "")">
                                        <td data-order="@item.FechaProgramada.ToDateTime(TimeOnly.MinValue).Ticks">
                                            @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@item.Zona</td>
                                        <td>@item.Agencia</td>
                                        <td>@item.Centro</td>
                                        <td>@item.Tipo</td>
                                        <td>@item.ClaveAgenda</td>
                                        <td>
                                            <span class="badge bg-info estatus-agenda">@item.Estatus</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#modalInfo">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-descargar-pdf btnGenerarPdf">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estatus == "PENDIENTE")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <button class="btn btn-warning btn-sm btn-precancelar" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else if (item.Estatus == "PRE-CANCELADO")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="@item.ClaveAgenda" title="Confirmar Cancelación">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="@item.ClaveAgenda" title="Rechazar Cancelación">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <span class="text-muted fst-italic">En espera de aprobación</span>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-table me-1"></i> Equipos de cómputo
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaEC" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha programada</th>
                                    <th>Zona</th>
                                    <th>Agencia</th>
                                    <th>Centro</th>
                                    <th>Tipo de equipo</th>
                                    <th>Usuario</th>
                                    <th>Núm. de orden</th>
                                    <th>Estatus</th>
                                    <th>Inf. del equipo</th>
                                    <th>Hoja de servicio</th>
                                    <th>Cancelaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Computo)
                                {
                                    <tr data-num-act-fijo="@item.NumActFijo" data-clave-agenda="@item.ClaveAgenda" data-tipo-equipo="@item.Tipo" class="@(item.TipoMantenimiento == "CORRECTIVO" ? "table-danger" : "")">
                                        <td data-order="@item.FechaProgramada.ToDateTime(TimeOnly.MinValue).Ticks">
                                            @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@item.Zona</td>
                                        <td>@item.Agencia</td>
                                        <td>@item.Centro</td>
                                        <td>@item.Tipo</td>
                                        <td>@item.UsuarioAsignado</td>
                                        <td>@item.ClaveAgenda</td>
                                        <td>
                                            <span class="badge bg-info estatus-agenda">@item.Estatus</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#modalInfo">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-dark btn-descargar-pdf btnGenerarPdf">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Estatus == "PENDIENTE")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <button class="btn btn-warning btn-sm btn-precancelar" data-id="@item.ClaveAgenda">
                                                        CANCELAR
                                                    </button>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else if (item.Estatus == "PRE-CANCELADO")
                                            {
                                                @if (User.IsInRole("ADMINISTRADOR"))
                                                {
                                                    <button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="@item.ClaveAgenda" title="Confirmar Cancelación">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="@item.ClaveAgenda" title="Rechazar Cancelación">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else if (User.IsInRole("TÉCNICO DE ZONA"))
                                                {
                                                    <span class="text-muted fst-italic">En espera de aprobación</span>
                                                }
                                                else if (User.IsInRole("CONSULTOR"))
                                                {
                                                    <span class="text-muted fst-italic">No disponible</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MODALES (PERMANECEN IGUAL) -->
    <div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="modalInfoLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalInfoLabel">Información del Equipo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalInfoBody">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalPdfComputo" tabindex="-1" aria-labelledby="modalPdfComputoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPdfComputoLabel">Hoja de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formHojaServicioComputo">
                        <input type="hidden" id="numActFijoPdfComputo" name="numActFijo" />
                        <input type="hidden" id="fechaProgramadaPdfComputo" name="fechaProgramada" />

                        <div class="alert alert-info mb-3" id="seccionConfirmacion">
                            ¿El Equipo de Cómputo está asignado a:
                            <strong><span id="rpeAsignado"></span> - <span id="nombreAsignado"></span></strong>?
                        </div>

                        <div class="d-flex justify-content-between mt-4" id="botonesConfirmacion">
                            <button type="button" id="btnModificarComputo" class="btn btn-warning">
                                <i class="bi bi-pencil me-2"></i>No, Modificar
                            </button>
                            <button type="button" id="btnContinuarComputo" class="btn btn-success">
                                <i class="bi bi-check-circle me-2"></i>Sí, Descargar PDF
                            </button>
                        </div>

                        <div id="camposModificacion" style="display: none;" class="mt-3">
                            <div class="mb-3">
                                <label for="rpeComputo" class="form-label">RPE:</label>
                                <input type="text" class="form-control" id="rpeComputo" name="rpe" placeholder="Ingrese el nuevo RPE">
                            </div>
                            <div class="mb-3">
                                <label for="nombreComputo" class="form-label">Nombre:</label>
                                <input type="text" class="form-control" id="nombreComputo" name="nombre" placeholder="Ingrese el nuevo nombre">
                            </div>
                            <div class="d-grid">
                                <button type="button" id="btnDescargarComputo" class="btn btn-success">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalPdf" tabindex="-1" aria-labelledby="modalPdfLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPdfLabel">Hoja de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formHojaServicio">
                        <input type="hidden" id="numActFijoPdf" name="numActFijo" />
                        <input type="hidden" id="fechaProgramadaPdf" name="fechaProgramada" />
                        <input type="hidden" id="numCajeroPdf" name="numCajero" />
                        <div class="mb-3">
                            <label for="responsable" class="form-label">Responsable del mantenimiento:</label>
                            <select class="form-select" id="responsable" name="responsable" required>
                                <option value="TECNICO_DE_ZONA" selected>TÉCNICO DE ZONA</option>
                                <option value="TECNICO_EXTERNO">TÉCNICO EXTERNO</option>
                            </select>
                        </div>
                        <div class="mb-3" id="divTecnicoExterno" style="display: none;">
                            <label for="nombreTecnico" class="form-label">Nombre del Técnico Externo:</label>
                            <input type="text" class="form-control" id="nombreTecnico" name="nombreTecnico">
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" id="btnGenerarPdf" class="btn btn-success">
                                <i class="bi bi-file-earmark-pdf me-2"></i>Generar PDF
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            var esAdmin = @User.IsInRole("ADMINISTRADOR").ToString().ToLower();

            // Configuración mejorada para DataTables con soporte responsivo
            var configComun = {
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                responsive: true,
                autoWidth: false,
                scrollX: true,
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                stateSave: true
            };

            // Aplicar configuración a cada tabla
            $('#tablaCFEmaticos').DataTable(configComun);
            $('#tablaAC').DataTable(configComun);
            $('#tablaEC').DataTable(configComun);

            // Eventos para cancelaciones
            $('#tablaCFEmaticos, #tablaAC, #tablaEC').on('click', '.btn-cancelar-directo', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');
                var button = $(this);

                Swal.fire({
                    title: '¿Cancelar mantenimiento?',
                    text: "Este mantenimiento será cancelado permanentemente.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, cancelar',
                    cancelButtonText: 'No'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("CancelarDirecto", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Cancelado!', response.message, 'success');

                                    // Actualizar la fila
                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-secondary">CANCELADO</span>');

                                    var celdaAcciones = button.closest('td');
                                    celdaAcciones.html('<span class="text-muted">N/A</span>');
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            $('#tablaCFEmaticos, #tablaAC, #tablaEC').on('click', '.btn-precancelar', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');
                var button = $(this);

                Swal.fire({
                    title: '¿Solicitar Cancelación?',
                    text: "Este mantenimiento se marcará como pre-cancelado y un administrador deberá confirmarla.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, solicitar',
                    cancelButtonText: 'No'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("PreCancelar", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Hecho!', response.message, 'success');

                                    // Actualizar la fila
                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-warning text-dark">PRE-CANCELADO</span>');

                                    var celdaAcciones = button.closest('td');
                                    if (esAdmin) {
                                        celdaAcciones.html('<button class="btn btn-success btn-sm btn-confirmar-cancelacion" data-id="' + id + '" title="Confirmar Cancelación"><i class="bi bi-check-circle"></i></button> <button class="btn btn-danger btn-sm btn-rechazar-cancelacion" data-id="' + id + '" title="Rechazar Cancelación"><i class="bi bi-x-circle"></i></button>');
                                    } else {
                                        celdaAcciones.html('<span class="text-muted fst-italic">En espera de aprobación</span>');
                                    }
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            $('#tablaCFEmaticos, #tablaAC, #tablaEC').on('click', '.btn-confirmar-cancelacion', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');

                Swal.fire({
                    title: '¿Confirmar Cancelación?',
                    text: "La pre-cancelación será confirmada permanentemente.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("ConfirmarCancelacion", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Confirmada!', response.message, 'success');

                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-secondary">CANCELADO</span>');

                                    var celdaAcciones = fila.find('td:last');
                                    celdaAcciones.html('<span class="text-muted">N/A</span>');
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            $('#tablaCFEmaticos, #tablaAC, #tablaEC').on('click', '.btn-rechazar-cancelacion', function() {
                var id = $(this).data('id');
                var fila = $(this).closest('tr');

                Swal.fire({
                    title: '¿Rechazar Cancelación?',
                    text: "El mantenimiento volverá a estatus PENDIENTE.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, rechazar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("ReactivarAgenda", "Agenda")', { idAgenda: id })
                            .done(function(response) {
                                if (response.success) {
                                    Swal.fire('¡Rechazada!', 'El mantenimiento ha sido reactivado.', 'success');

                                    var celdaEstatus = fila.find('.estatus-agenda');
                                    celdaEstatus.html('<span class="badge bg-info">PENDIENTE</span>');

                                    var celdaAcciones = fila.find('td:last');
                                    if (esAdmin) {
                                        celdaAcciones.html('<button class="btn btn-danger btn-sm btn-cancelar-directo" data-id="' + id + '">Cancelar</button>');
                                    } else {
                                        celdaAcciones.html('<button class="btn btn-warning btn-sm btn-precancelar" data-id="' + id + '">Cancelar</button>');
                                    }
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            })
                            .fail(function() {
                                Swal.fire('Error de Conexión', 'No se pudo comunicar con el servidor.', 'error');
                            });
                    }
                });
            });

            // Modal para información del equipo
            $('[data-bs-target="#modalInfo"]').on('click', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var claveAgenda = fila.data('clave-agenda');

                $('#modalInfoBody').html('<div class="text-center p-4"><div class="spinner-border" role="status"></div></div>');

                $.get('/Home/ObtenerDetallesEquipo', { numActFijo: numActFijo, claveAgenda: claveAgenda }, function(data) {
                    $('#modalInfoBody').html(data);
                });
            });

            // Para resetear el modal al cerrar
            $('#modalInfo').on('hidden.bs.modal', function (e) {
                $('#modalInfoLabel').text('Información del Equipo');
                $('#modalInfoBody').html('');
            });

            // Para generar los PDFs de CFEmáticos
            $('#tablaCFEmaticos').on('click', '[data-bs-target="#modalPdf"]', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var fechaProgramada = fila.find('td:first').text().trim();
                var numCajero = fila.find('td:nth-child(6)').text().trim();

                $('#numActFijoPdf').val(numActFijo);
                $('#fechaProgramadaPdf').val(fechaProgramada);
                $('#numCajeroPdf').val(numCajero);

                $('#formHojaServicio')[0].reset();
                $('#divTecnicoExterno').hide();
                $('#nombreTecnico').prop('required', false);
            });

            // Para generar PDFs de Equipos de Atención a Clientes
            $('#tablaAC').on('click', '.btnGenerarPdf', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var tipoEquipo = fila.data('tipo-equipo');
                var fechaProgramada = fila.find('td:first').text().trim();

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                $.ajax({
                    url: '/Home/GenerarHojaServicio',
                    type: 'POST',
                    data: {
                        numActFijo: numActFijo,
                        fechaProgramada: fechaProgramada,
                        responsable: "TÉCNICO DE ZONA",
                        nombreTecnico: "@Context.Session.GetString("NombreUsuario")",
                        tipoEquipo: tipoEquipo
                    },
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function(data, status, xhr) {
                        var url = URL.createObjectURL(data);
                        var a = document.createElement('a');
                        a.href = url;

                        var contentDisposition = xhr.getResponseHeader('Content-Disposition');
                        var fileName = 'documento.pdf';

                        if (contentDisposition && contentDisposition.indexOf('attachment') !== -1) {
                            var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                            var matches = filenameRegex.exec(contentDisposition);
                            if (matches != null && matches[1]) {
                                fileName = matches[1].replace(/['"]/g, '');
                            }
                        }

                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function() {
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                        }, 100);
                    },
                    error: function(xhr) {
                        alert('Error al generar el PDF: ' + xhr.responseText);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html('<i class="bi bi-file-earmark-pdf me-1"></i>');
                    }
                });
            });

            // Para generar PDFs de Equipos de Cómputo
            $('#tablaEC').on('click', '.btnGenerarPdf', function() {
                var fila = $(this).closest('tr');
                var numActFijo = fila.data('num-act-fijo');
                var fechaProgramada = fila.find('td:first').text().trim();

                $.get('/Home/ObtenerDatosComputo', { numActFijo: numActFijo }, function(data) {
                    $('#numActFijoPdfComputo').val(numActFijo);
                    $('#fechaProgramadaPdfComputo').val(fechaProgramada);
                    $('#rpeAsignado').text(data.rpe);
                    $('#nombreAsignado').text(data.nombre);
                    $('#rpeComputo').val('');
                    $('#nombreComputo').val('');
                    $('#camposModificacion').hide();
                    $('#modalPdfComputo').modal('show');
                });
            });

            // Mostrar/ocultar campo de técnico externo
            $('#responsable').change(function() {
                if ($(this).val() === 'TECNICO_EXTERNO') {
                    $('#divTecnicoExterno').show();
                    $('#nombreTecnico').prop('required', true);
                } else {
                    $('#divTecnicoExterno').hide();
                    $('#nombreTecnico').prop('required', false);
                }
            });

            // Generar PDF para CFEmáticos
            $('#btnGenerarPdf').click(function() {
                if ($('#formHojaServicio')[0].checkValidity()) {
                    var formData = $('#formHojaServicio').serialize();
                    var $btn = $(this);

                    $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                    $.ajax({
                        url: '/Home/GenerarHojaServicio',
                        type: 'POST',
                        data: formData,
                        xhrFields: {
                            responseType: 'blob'
                        },
                        success: function(data, status, xhr) {
                            var url = URL.createObjectURL(data);
                            var a = document.createElement('a');
                            a.href = url;

                            var contentDisposition = xhr.getResponseHeader('Content-Disposition');
                            var fileName = 'documento.pdf';

                            if (contentDisposition && contentDisposition.indexOf('attachment') !== -1) {
                                var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                                var matches = filenameRegex.exec(contentDisposition);
                                if (matches != null && matches[1]) {
                                    fileName = matches[1].replace(/['"]/g, '');
                                }
                            }

                            a.download = fileName;
                            document.body.appendChild(a);
                            a.click();
                            setTimeout(function() {
                                document.body.removeChild(a);
                                URL.revokeObjectURL(url);
                                $('#modalPdf').modal('hide');
                            }, 100);
                        },
                        error: function(xhr) {
                            alert('Error al generar el PDF: ' + xhr.responseText);
                        },
                        complete: function() {
                            $btn.prop('disabled', false).html('<i class="bi bi-file-earmark-pdf me-2"></i>Generar PDF');
                        }
                    });
                } else {
                    $('#formHojaServicio')[0].reportValidity();
                }
            });

            // Funciones para Equipos de Cómputo
            $('#btnContinuarComputo').click(function() {
                descargarPdfComputo(false);
            });

            $('#btnModificarComputo').click(function() {
                $('#camposModificacion').show();
            });

            $('#btnDescargarComputo').click(function() {
                descargarPdfComputo(true);
            });

            function descargarPdfComputo(usarDatosModificados) {
                var formData = {
                    numActFijo: $('#numActFijoPdfComputo').val(),
                    fechaProgramada: $('#fechaProgramadaPdfComputo').val(),
                    responsable: "TÉCNICO DE ZONA",
                    nombreTecnico: "@Context.Session.GetString("NombreUsuario")"
                };

                if (usarDatosModificados) {
                    if (!$('#rpeComputo').val() || !$('#nombreComputo').val()) {
                        alert('Por favor complete ambos campos (RPE y Nombre)');
                        return;
                    }
                    formData.rpe = $('#rpeComputo').val();
                    formData.nombre = $('#nombreComputo').val();
                }

                var $btn = $('#btnDescargarComputo, #btnContinuarComputo').filter(':visible');
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass me-2"></i>Generando...');

                $.ajax({
                    url: '/Home/GenerarHojaServicioComputo',
                    type: 'POST',
                    data: formData,
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function(data, status, xhr) {
                        var url = URL.createObjectURL(data);
                        var a = document.createElement('a');
                        a.href = url;

                        var contentDisposition = xhr.getResponseHeader('Content-Disposition');
                        var fileName = 'documento.pdf';

                        if (contentDisposition && contentDisposition.indexOf('attachment') !== -1) {
                            var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                            var matches = filenameRegex.exec(contentDisposition);
                            if (matches != null && matches[1]) {
                                fileName = matches[1].replace(/['"]/g, '');
                            }
                        }

                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        setTimeout(function() {
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                            $('#modalPdfComputo').modal('hide');
                        }, 100);
                    },
                    error: function(xhr) {
                        alert('Error al generar el PDF: ' + xhr.responseText);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html(usarDatosModificados ?
                            '<i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF' :
                            '<i class="bi bi-check-circle me-2"></i>Sí, Descargar PDF');
                    }
                });
            }
        });
    </script>
}