@model List<MantenimientosTI.Models.Refaccion>
@{
    ViewData["Title"] = "Refacciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 576px) {
        .table-responsive table {
            min-width: 800px;
        }

        .container {
            padding-left: 10px;
            padding-right: 10px;
        }
    }

    .table th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }
</style>

<div class="container mt-5">
    <div class="card mt-4 shadow-sm rounded">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-0">Gestión de refacciones</h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        Zona: @ViewBag.NombreZona
                    </p>
                </div>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalAgregarRefaccion">
                    <i class="fas fa-plus me-2"></i> Agregar refacción
                </button>
            </div>
            <div class="card-body">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-cogs me-1"></i> Refacciones registradas en mi zona
                        <span class="badge bg-light text-success ms-2">
                            @(Model != null ? Model.Count : 0) registros
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tablaRefacciones" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Tipo de refacción</th>
                                        <th>Número de serie</th>
                                        <th>Modelo</th>
                                        <th>Marca</th>
                                        <th>Fecha de adquisición</th>
                                        <th>Número de contrato</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var refaccion in Model)
                                        {
                                            <tr>
                                                <td>@refaccion.ClaveRefaccion</td>
                                                <td>@refaccion.CatTipoRefaccion?.NombreTipoRefaccion</td>
                                                <td>@refaccion.NumeroSerie</td>
                                                <td>@refaccion.Modelo</td>
                                                <td>@refaccion.Marca</td>
                                                <td>@refaccion.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
                                                <td>@refaccion.NumContratoAdquisicion</td>
                                                <td>
                                                    <span class="badge @(refaccion.Ocupado == "SI" ? "bg-danger" : "bg-success")">
                                                        @(refaccion.Ocupado == "SI" ? "OCUPADO" : "DISPONIBLE")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-warning me-1" data-bs-toggle="modal" data-bs-target="#modalEditarRefaccion"
                                                            onclick="cargarDatosEdicionRefaccion(@refaccion.ClaveRefaccion)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" onclick="eliminarRefaccion(@refaccion.ClaveRefaccion, '@refaccion.CatTipoRefaccion?.NombreTipoRefaccion?.Replace("'", "\\'")')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4">
                                                <i class="fas fa-box-open fa-2x mb-3"></i>
                                                <p>No hay refacciones registradas en tu zona</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar una nueva refacción - MODIFICADO -->
<div class="modal fade" id="modalAgregarRefaccion" tabindex="-1" aria-labelledby="tituloModalAgregarRefaccion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalAgregarRefaccion">NUEVA REFACCIÓN</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevaRefaccion">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ClaveTipoRefaccionNuevo" class="form-label">Tipo de refacción *</label>
                            <select class="form-select" id="ClaveTipoRefaccionNuevo" name="ClaveTipoRefaccion" required>
                                <option value="">Seleccione un tipo de refacción</option>
                            </select>
                            <div class="invalid-feedback">
                                Por favor seleccione un tipo de refacción
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <!-- Campo dinámico -->
                            <div id="campoDinamicoNuevo">
                                <!-- Aquí se mostrará el campo según el tipo de refacción -->
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="MarcaNuevo" class="form-label">Marca *</label>
                            <input type="text" class="form-control text-uppercase" id="MarcaNuevo" name="Marca" required
                                   oninput="this.value = this.value.toUpperCase()" maxlength="20">
                            <div class="invalid-feedback">
                                La marca es requerida
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ModeloNuevo" class="form-label">Modelo *</label>
                            <input type="text" class="form-control text-uppercase" id="ModeloNuevo" name="Modelo" required
                                   oninput="this.value = this.value.toUpperCase()" maxlength="20">
                            <div class="invalid-feedback">
                                El modelo es requerido
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="FechaAdquisicionNuevo" class="form-label">Fecha de adquisición *</label>
                            <input type="date" class="form-control" id="FechaAdquisicionNuevo" name="FechaAdquisicion" required
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div class="invalid-feedback">
                                La fecha de adquisición es requerida
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="NumContratoAdquisicionNuevo" class="form-label">Número de contrato *</label>
                            <input type="number" class="form-control" id="NumContratoAdquisicionNuevo" name="NumContratoAdquisicion" required
                                   min="1">
                            <div class="invalid-feedback">
                                El número de contrato debe ser un número válido mayor a 0
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="crearRefaccion()">
                    <i class="fas fa-save me-1"></i> Guardar
                </button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para editar una refacción -->
<div class="modal fade" id="modalEditarRefaccion" tabindex="-1" aria-labelledby="tituloModalEditarRefaccion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalEditarRefaccion">EDITAR REFACCIÓN</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarRefaccion">
                    <input type="hidden" id="ClaveRefaccionEditar" name="ClaveRefaccion">
                    <input type="hidden" id="TipoUnidadMedidaEditar" name="TipoUnidadMedida">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ClaveTipoRefaccionEditar" class="form-label">Tipo de refacción *</label>
                            <select class="form-select" id="ClaveTipoRefaccionEditar" name="ClaveTipoRefaccion" required>
                                <option value="">Seleccionar tipo...</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <!-- Campo dinámico para edición -->
                            <div id="campoDinamicoEditar">
                                <!-- Aquí se mostrará el campo según el tipo de refacción -->
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="MarcaEditar" class="form-label">Marca *</label>
                            <input type="text" class="form-control text-uppercase" id="MarcaEditar" name="Marca" required
                                   oninput="this.value = this.value.toUpperCase()" maxlength="20">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ModeloEditar" class="form-label">Modelo *</label>
                            <input type="text" class="form-control text-uppercase" id="ModeloEditar" name="Modelo" required
                                   oninput="this.value = this.value.toUpperCase()" maxlength="20">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="FechaAdquisicionEditar" class="form-label">Fecha de adquisición *</label>
                            <input type="date" class="form-control" id="FechaAdquisicionEditar" name="FechaAdquisicion" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="NumContratoAdquisicionEditar" class="form-label">Número de contrato *</label>
                            <input type="number" class="form-control" id="NumContratoAdquisicionEditar" name="NumContratoAdquisicion" required min="1">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="guardarCambiosRefaccion()">
                    <i class="fas fa-save me-1"></i> Guardar cambios
                </button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

