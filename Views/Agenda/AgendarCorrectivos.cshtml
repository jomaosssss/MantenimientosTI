@{
    ViewData["Title"] = "Agendar Correctivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="mb-0">Mantenimiento correctivo</h1>
            <div class="alert alert-secondary mt-3">
                <i class="fas fa-info-circle"></i> Complete el siguiente formulario para agendar un mantenimiento correctivo.
            </div>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Zona:</label>
                        <input type="text" class="form-control" value="@ViewBag.ZonaUsuario" readonly>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Agencia:</label>
                        <select id="selectAgencia" class="form-select">
                            <option value="">Seleccione una agencia</option>
                            @foreach (var agencia in ViewBag.Agencias)
                            {
                                <option value="@agencia.ClaveAgencia"
                                        data-division="@agencia.ClaveDivision"
                                        data-zona="@agencia.ClaveZona">
                                    @agencia.NombreAgencia
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Centro:</label>
                        <select id="selectCentro" class="form-select" disabled>
                            <option value="">Seleccione primero una agencia</option>
                        </select>
                    </div>
                </div>

                <!-- NUEVO: Combobox para Tipo de Equipo -->
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Tipo de equipo:</label>
                        <select id="selectTipoEquipo" class="form-select" disabled>
                            <option value="">Seleccione primero un centro</option>
                        </select>
                    </div>
                </div>

                <!-- Combobox para Número de Cajero (solo para CFEMÁTICO) -->
                <div class="col-md-4" id="divCajero" style="display: none;">
                    <div class="form-group">
                        <label class="form-label">Número de cajero:</label>
                        <select id="selectCajero" class="form-select" disabled>
                            <option value="">Seleccione un cajero</option>
                        </select>
                    </div>
                </div>

                <!-- NUEVO: Combobox para Número de Activo Fijo (para otros tipos) -->
                <div class="col-md-4" id="divActivoFijo" style="display: none;">
                    <div class="form-group">
                        <label class="form-label">Número de activo fijo:</label>
                        <select id="selectActivoFijo" class="form-select" disabled>
                            <option value="">Seleccione un activo fijo</option>
                        </select>
                    </div>
                </div>

                <!-- Campo de número de activo fijo (OCULTO - para el envío del formulario) -->
                <div class="col-md-4 d-none">
                    <div class="form-group">
                        <label class="form-label">Número de activo fijo:</label>
                        <input type="text"
                               id="numActivoFijo"
                               class="form-control"
                               readonly
                               placeholder="Seleccione un cajero o activo fijo">
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Fecha programada:</label>
                        <input type="date"
                               id="fechaProgramada"
                               name="fechaProgramada"
                               class="form-control"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button type="button" id="btnAgendar" class="btn btn-success btn-md">
                <i class="bi bi-calendar-check me-2"></i> Agendar
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // Tu código JavaScript existente permanece exactamente igual...
            // 1. Manejo del cambio en Agencia
            $('#selectAgencia').change(function() {
                var selectedAgencia = $(this).find('option:selected');
                var division = selectedAgencia.data('division');
                var zona = selectedAgencia.data('zona');
                var agencia = selectedAgencia.val();

                if (agencia) {
                    // Mostrar loading
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Cargando centros...</option>');
                    $('#selectTipoEquipo').prop('disabled', true)
                                         .html('<option value="">Seleccione un centro primero</option>');
                    $('#divCajero').hide();
                    $('#divActivoFijo').hide();
                    $('#selectCajero').prop('disabled', true)
                                     .html('<option value="">Seleccione un centro primero</option>');
                    $('#selectActivoFijo').prop('disabled', true)
                                         .html('<option value="">Seleccione un centro primero</option>');
                    $('#numActivoFijo').val('');

                    $.get('/Agenda/ObtenerCentrosPorAgencia', {
                        division: division,
                        zona: zona,
                        agencia: agencia
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione un centro</option>';
                            $.each(response.data, function(index, centro) {
                                options += '<option value="' + centro.value + '">' + centro.text + '</option>';
                            });
                            $('#selectCentro').html(options).prop('disabled', false);
                        } else {
                            $('#selectCentro').html('<option value="">Error al cargar centros</option>');
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectCentro').html('<option value="">Error en la solicitud</option>');
                    });
                } else {
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Seleccione primero una agencia</option>');
                    $('#selectTipoEquipo').prop('disabled', true)
                                         .html('<option value="">Seleccione una agencia primero</option>');
                    $('#divCajero').hide();
                    $('#divActivoFijo').hide();
                    $('#selectCajero').prop('disabled', true)
                                     .html('<option value="">Seleccione una agencia primero</option>');
                    $('#selectActivoFijo').prop('disabled', true)
                                         .html('<option value="">Seleccione una agencia primero</option>');
                    $('#numActivoFijo').val('');
                }
            });

            // 2. Manejo del cambio en Centro (para cargar tipos de equipo)
            $('#selectCentro').change(function() {
                var selectedCentro = $(this).val();
                var selectedAgencia = $('#selectAgencia').find('option:selected');

                if (selectedCentro && selectedAgencia.val()) {
                    // Mostrar loading
                    $('#selectTipoEquipo').prop('disabled', true)
                                         .html('<option value="">Cargando tipos de equipo...</option>');
                    $('#divCajero').hide();
                    $('#divActivoFijo').hide();
                    $('#selectCajero').prop('disabled', true)
                                     .html('<option value="">Seleccione un tipo de equipo</option>');
                    $('#selectActivoFijo').prop('disabled', true)
                                         .html('<option value="">Seleccione un tipo de equipo</option>');
                    $('#numActivoFijo').val('');

                    $.get('/Agenda/ObtenerTiposEquipoPorCentro', {
                        division: selectedAgencia.data('division'),
                        zona: selectedAgencia.data('zona'),
                        agencia: selectedAgencia.val(),
                        centro: selectedCentro
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione un tipo de equipo</option>';
                            $.each(response.data, function(index, tipo) {
                                options += '<option value="' + tipo.value + '">' + tipo.text + '</option>';
                            });
                            $('#selectTipoEquipo').html(options).prop('disabled', false);
                        } else {
                            $('#selectTipoEquipo').html('<option value="">Error al cargar tipos de equipo</option>');
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectTipoEquipo').html('<option value="">Error en la solicitud</option>');
                    });
                } else {
                    $('#selectTipoEquipo').prop('disabled', true)
                                         .html('<option value="">Seleccione un centro válido</option>');
                    $('#divCajero').hide();
                    $('#divActivoFijo').hide();
                    $('#selectCajero').prop('disabled', true)
                                     .html('<option value="">Seleccione un centro válido</option>');
                    $('#selectActivoFijo').prop('disabled', true)
                                         .html('<option value="">Seleccione un centro válido</option>');
                    $('#numActivoFijo').val('');
                }
            });

            // 3. Manejo del cambio en Tipo de Equipo
            $('#selectTipoEquipo').change(function() {
                var selectedTipo = $(this).val();
                var selectedCentro = $('#selectCentro').val();
                var selectedAgencia = $('#selectAgencia').find('option:selected');

                // Ocultar ambos comboboxes inicialmente
                $('#divCajero').hide();
                $('#divActivoFijo').hide();
                $('#selectCajero').prop('disabled', true).html('<option value="">Seleccione un cajero</option>');
                $('#selectActivoFijo').prop('disabled', true).html('<option value="">Seleccione un activo fijo</option>');
                $('#numActivoFijo').val('');

                if (selectedTipo && selectedCentro && selectedAgencia.val()) {
                    if (selectedTipo === 'CFEMÁTICO') {
                        // Mostrar combobox de cajeros
                        $('#selectCajero').html('<option value="">Cargando cajeros...</option>');
                        $('#divCajero').show();

                        $.get('/Agenda/ObtenerCajerosPorCentro', {
                            division: selectedAgencia.data('division'),
                            zona: selectedAgencia.data('zona'),
                            agencia: selectedAgencia.val(),
                            centro: selectedCentro
                        }, function(response) {
                            if (response.success) {
                                var options = '<option value="">Seleccione un cajero</option>';
                                $.each(response.data, function(index, cajero) {
                                    options += `<option value="${cajero.value}"
                                                       data-activo-fijo="${cajero.numActFijo}">
                                                  ${cajero.text}
                                                </option>`;
                                });
                                $('#selectCajero').html(options).prop('disabled', false);
                            } else {
                                $('#selectCajero').html('<option value="">Error al cargar cajeros</option>');
                                console.error(response.message);
                            }
                        }).fail(function() {
                            $('#selectCajero').html('<option value="">Error en la solicitud</option>');
                        });
                    } else {
                        // Mostrar combobox de activos fijos para otros tipos
                        $('#selectActivoFijo').html('<option value="">Cargando activos fijos...</option>');
                        $('#divActivoFijo').show();

                        $.get('/Agenda/ObtenerActivosFijosPorCentroYTipo', {
                            division: selectedAgencia.data('division'),
                            zona: selectedAgencia.data('zona'),
                            agencia: selectedAgencia.val(),
                            centro: selectedCentro,
                            tipoEquipo: selectedTipo
                        }, function(response) {
                            if (response.success) {
                                var options = '<option value="">Seleccione un activo fijo</option>';
                                $.each(response.data, function(index, activo) {
                                    options += `<option value="${activo.value}">
                                                  ${activo.text}
                                                </option>`;
                                });
                                $('#selectActivoFijo').html(options).prop('disabled', false);
                            } else {
                                $('#selectActivoFijo').html('<option value="">Error al cargar activos fijos</option>');
                                console.error(response.message);
                            }
                        }).fail(function() {
                            $('#selectActivoFijo').html('<option value="">Error en la solicitud</option>');
                        });
                    }
                }
            });

            // 4. Mostrar número de activo fijo cuando se selecciona un cajero (CFEMÁTICO)
            $('#selectCajero').change(function() {
                var selectedOption = $(this).find('option:selected');
                $('#numActivoFijo').val(selectedOption.data('activo-fijo') || '');
            });

            // 5. Mostrar número de activo fijo cuando se selecciona un activo fijo (otros tipos)
            $('#selectActivoFijo').change(function() {
                var selectedOption = $(this).find('option:selected');
                $('#numActivoFijo').val(selectedOption.val() || '');
            });

            // 6. Configuración mínima del datepicker
            $('#fechaProgramada').attr('min', new Date().toISOString().split('T')[0]);

            // 7. Manejo del botón Agendar
            $('#btnAgendar').click(function() {
                // Validar campos obligatorios
                if ($('#selectAgencia').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione una agencia',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#selectCentro').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione un centro',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#selectTipoEquipo').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione un tipo de equipo',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                // Validar según el tipo de equipo
                var tipoEquipo = $('#selectTipoEquipo').val();
                if (tipoEquipo === 'CFEMÁTICO') {
                    if ($('#selectCajero').val() === '') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Campo requerido',
                            text: 'Por favor seleccione un cajero',
                            confirmButtonColor: '#3085d6',
                        });
                        return;
                    }
                } else {
                    if ($('#selectActivoFijo').val() === '') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Campo requerido',
                            text: 'Por favor seleccione un activo fijo',
                            confirmButtonColor: '#3085d6',
                        });
                        return;
                    }
                }

                if ($('#fechaProgramada').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione una fecha programada',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                // Obtener datos del formulario
                var numActFijo = $('#numActivoFijo').val();
                var fechaProgramada = $('#fechaProgramada').val();

                // Mostrar loading en el botón
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Agendando...');

                // Enviar datos al servidor
                $.ajax({
                    url: '/Agenda/AgendarCorrectivo',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: {
                        numActFijo: numActFijo,
                        fechaProgramada: fechaProgramada
                    },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: response.message,
                                confirmButtonColor: '#3085d6',
                                showCancelButton: false,
                                allowOutsideClick: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Limpiar el formulario
                                    $('#selectTipoEquipo').val('').trigger('change');
                                    $('#fechaProgramada').val('');
                                    $('#numActivoFijo').val('');
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de conexión',
                            text: 'Error al conectar con el servidor: ' + error,
                            confirmButtonColor: '#3085d6'
                        });
                    },
                    complete: function() {
                        // Restaurar el botón
                        $btn.prop('disabled', false).html('<i class="bi bi-calendar-check"></i> Agendar');
                    }
                });
            });
        });
    </script>
}