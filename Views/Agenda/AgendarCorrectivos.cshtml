@{
    ViewData["Title"] = "Agendar Correctivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h1 class="mb-0">Mantenimiento correctivo</h1>
                <div class="alert alert-secondary mt-3">
                    <i class="fas fa-info-circle"></i> Complete el siguiente formulario para agendar un mantenimiento correctivo.
                </div>
            </div>

            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Zona:</label>
                            <input type="text" class="form-control" value="@ViewBag.ZonaUsuario" readonly>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Agencia:</label>
                            <select id="selectAgencia" class="form-select">
                                <option value="">Seleccione una agencia</option>
                                @foreach (var agencia in ViewBag.Agencias)
                                {
                                    <option value="@agencia.ClaveAgencia"
                                            data-division="@agencia.ClaveDivision"
                                            data-zona="@agencia.ClaveZona">
                                        @agencia.NombreAgencia
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Centro:</label>
                            <select id="selectCentro" class="form-select" disabled>
                                <option value="">Seleccione primero una agencia</option>
                            </select>
                        </div>
                    </div>
                </div> <!-- ✅ CIERRE CORRECTO de la primera fila -->

                <!-- ✅ SEGUNDA FILA: Tipo de Equipo -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Tipo de Equipo:</label>
                            <select id="selectTipoEquipo" class="form-select" disabled>
                                <option value="">Seleccione primero un centro</option>
                                <option value="CFEMatico">CFEMático</option>
                                <option value="Computo">Equipo de Cómputo</option>
                                <option value="AtencionCliente">Equipo de Atención a Clientes</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label" id="labelEquipo">Número de cajero:</label>
                            <select id="selectEquipo" class="form-select" disabled>
                                <option value="">Seleccione primero el tipo de equipo</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Número de activo fijo:</label>
                            <input type="text"
                                   id="numActivoFijo"
                                   class="form-control"
                                   readonly
                                   placeholder="Seleccione un equipo">
                        </div>
                    </div>
                </div> <!-- ✅ CIERRE de la segunda fila -->

                <!-- ✅ TERCERA FILA: Fecha programada -->
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Fecha programada:</label>
                            <input type="date"
                                   id="fechaProgramada"
                                   name="fechaProgramada"
                                   class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer text-end">
                <button type="button" id="btnAgendar" class="btn btn-success btn-md">
                    <i class="bi bi-calendar-check me-2"></i> Agendar
                </button>
            </div>
        </div>
    </div>


    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
                    $(document).ready(function() {
            // 1. Manejo del cambio en Agencia (CORREGIDO)
            $('#selectAgencia').change(function() {
                var selectedAgencia = $(this).find('option:selected');
                var division = selectedAgencia.data('division');
                var zona = selectedAgencia.data('zona');
                var agencia = selectedAgencia.val();

                if (agencia) {
                    // Mostrar loading
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Cargando centros...</option>');
                    $('#selectTipoEquipo').prop('disabled', true).val('');
                    $('#selectEquipo').prop('disabled', true) // ← CORREGIDO
                                     .html('<option value="">Seleccione un centro primero</option>');
                    $('#numActivoFijo').val('');

                    $.get('/Agenda/ObtenerCentrosPorAgencia', {
                        division: division,
                        zona: zona,
                        agencia: agencia
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione un centro</option>';
                            $.each(response.data, function(index, centro) {
                                options += '<option value="' + centro.value + '">' + centro.text + '</option>';
                            });
                            $('#selectCentro').html(options).prop('disabled', false);
                        } else {
                            $('#selectCentro').html('<option value="">Error al cargar centros</option>');
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectCentro').html('<option value="">Error en la solicitud</option>');
                    });
                } else {
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Seleccione primero una agencia</option>');
                    $('#selectTipoEquipo').prop('disabled', true).val('');
                    $('#selectEquipo').prop('disabled', true) // ← CORREGIDO
                                     .html('<option value="">Seleccione una agencia primero</option>');
                    $('#numActivoFijo').val('');
                }
            });

            // 2. Manejo del cambio en Centro (CORREGIDO)
            $('#selectCentro').change(function() {
                var selectedCentro = $(this).val();
                var selectedAgencia = $('#selectAgencia').find('option:selected');

                if (selectedCentro && selectedAgencia.val()) {
                    // HABILITAR Tipo de Equipo y resetear selects dependientes
                    $('#selectTipoEquipo').prop('disabled', false);
                    $('#selectEquipo').prop('disabled', true).html('<option value="">Seleccione tipo de equipo primero</option>'); // ← CORREGIDO
                    $('#numActivoFijo').val('');
                } else {
                    $('#selectTipoEquipo').prop('disabled', true).val('');
                    $('#selectEquipo').prop('disabled', true).html('<option value="">Seleccione un centro válido</option>'); // ← CORREGIDO
                    $('#numActivoFijo').val('');
                }
            });

            // 2.5. Manejo del cambio en Tipo de Equipo (CORREGIDO)
            $('#selectTipoEquipo').change(function() {
                var tipoEquipo = $(this).val();
                var selectedCentro = $('#selectCentro').val();
                var selectedAgencia = $('#selectAgencia').find('option:selected');

                if (tipoEquipo && selectedCentro && selectedAgencia.val()) {
                    // CAMBIAR LABEL según tipo de equipo
                    var labelTexto = '';
                    switch(tipoEquipo) {
                        case 'CFEMatico':
                            labelTexto = 'Número de cajero:';
                            break;
                        case 'Computo':
                            labelTexto = 'Equipo de cómputo:';
                            break;
                        case 'AtencionCliente':
                            labelTexto = 'Equipo de atención a clientes:';
                            break;
                    }
                    $('#labelEquipo').text(labelTexto);

                    // CARGAR EQUIPOS según tipo
                    $('#selectEquipo').prop('disabled', true).html('<option value="">Cargando equipos...</option>'); // ← CORREGIDO
                    $('#numActivoFijo').val('');

                    var url = '';
                    switch(tipoEquipo) {
                        case 'CFEMatico':
                            url = '/Agenda/ObtenerCajerosPorCentro';
                            break;
                        case 'Computo':
                            url = '/Agenda/ObtenerEquiposComputoPorCentro';
                            break;
                        case 'AtencionCliente':
                            url = '/Agenda/ObtenerEquiposACPorCentro';
                            break;
                    }

                    $.get(url, {
                        division: selectedAgencia.data('division'),
                        zona: selectedAgencia.data('zona'),
                        agencia: selectedAgencia.val(),
                        centro: selectedCentro
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione un equipo</option>';
                            $.each(response.data, function(index, equipo) {
                                options += `<option value="${equipo.value}"
                                                   data-activo-fijo="${equipo.numActFijo}">
                                              ${equipo.text}
                                            </option>`;
                            });
                            $('#selectEquipo').html(options).prop('disabled', false); // ← CORREGIDO
                        } else {
                            $('#selectEquipo').html('<option value="">Error al cargar equipos</option>'); // ← CORREGIDO
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectEquipo').html('<option value="">Error en la solicitud</option>'); // ← CORREGIDO
                    });
                } else {
                    $('#selectEquipo').prop('disabled', true).html('<option value="">Seleccione tipo de equipo</option>'); // ← CORREGIDO
                    $('#numActivoFijo').val('');
                }
            });

            // 3. Mostrar número de activo fijo cuando se selecciona un equipo (CORREGIDO)
            $('#selectEquipo').change(function() { // ← CORREGIDO
                var selectedOption = $(this).find('option:selected');
                $('#numActivoFijo').val(selectedOption.data('activo-fijo') || '');
            });

            // 4. Configuración mínima del datepicker (si es necesario)
            $('#fechaProgramada').attr('min', new Date().toISOString().split('T')[0]);

            // 5. Manejo del botón Agendar (CORREGIDO)
            $('#btnAgendar').click(function() {
                // Validar campos obligatorios
                if ($('#selectAgencia').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione una agencia',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#selectCentro').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione un centro',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#selectTipoEquipo').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione el tipo de equipo',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#selectEquipo').val() === '') { // ← CORREGIDO
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione un equipo',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                if ($('#fechaProgramada').val() === '') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Campo requerido',
                        text: 'Por favor seleccione una fecha programada',
                        confirmButtonColor: '#3085d6',
                    });
                    return;
                }

                // Obtener datos del formulario
                var numActFijo = $('#numActivoFijo').val();
                var fechaProgramada = $('#fechaProgramada').val();
                var tipoEquipo = $('#selectTipoEquipo').val();

                // Mostrar loading en el botón
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Agendando...');

                // Enviar datos al servidor
                $.ajax({
                    url: '/Agenda/AgendarCorrectivo',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: {
                        numActFijo: numActFijo,
                        fechaProgramada: fechaProgramada,
                        tipoEquipo: tipoEquipo
                    },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: response.message,
                                confirmButtonColor: '#3085d6',
                                showCancelButton: false,
                                allowOutsideClick: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Limpiar el formulario
                                    $('#selectTipoEquipo').val('');
                                    $('#selectEquipo').val('').trigger('change'); // ← CORREGIDO
                                    $('#fechaProgramada').val('');
                                    $('#selectTipoEquipo').prop('disabled', true);
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de conexión',
                            text: 'Error al conectar con el servidor: ' + error,
                            confirmButtonColor: '#3085d6'
                        });
                    },
                    complete: function() {
                        // Restaurar el botón
                        $btn.prop('disabled', false).html('<i class="bi bi-calendar-check"></i> Agendar');
                    }
                });
            });
        });;
        </script>
    }
