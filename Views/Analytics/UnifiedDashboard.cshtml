@functions {
    public string GetSecurityRowClass(string severity)
    {
        return severity switch
        {
            "high" => "security-high",
            "medium" => "security-medium",
            "low" => "security-low",
            _ => ""
        };
    }

    public string GetSecurityBadgeClass(string severity)
    {
        return severity switch
        {
            "high" => "bg-danger",
            "medium" => "bg-warning",
            "low" => "bg-success",
            _ => "bg-secondary"
        };
    }

    public string ObtenerTipoUsuario(string usuario)
    {
        if (string.IsNullOrEmpty(usuario))
            return "Usuario";

        if (usuario.Contains("TECNICO") || usuario.Contains("MEM03") || usuario.ToUpper().Contains("TÉCNICO"))
            return "Técnico";

        if (usuario.Contains("ADMIN") || usuario.Contains("XD XD") || usuario.ToUpper().Contains("ADMINISTRADOR"))
            return "Administrador";

        return "Usuario";
    }

    public string FormatearNombreAccion(string claveAccion)
    {
        if (string.IsNullOrEmpty(claveAccion))
            return "Acción";

        // Convertir a formato de oración
        var texto = claveAccion.Replace("_", " ").ToLower();
        return System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.ToTitleCase(texto);
    }

    public bool TieneInformacionAdicional(string descripcion)
    {
        return !string.IsNullOrEmpty(descripcion) &&
               (descripcion.Contains("|") || descripcion.Contains("Rol:") || descripcion.Contains("IP:"));
    }

    public List<string> ObtenerDetallesAdicionales(string descripcion)
    {
        var detalles = new List<string>();

        if (string.IsNullOrEmpty(descripcion))
            return detalles;

        if (descripcion.Contains("|"))
        {
            var partes = descripcion.Split('|');
            foreach (var parte in partes)
            {
                var parteLimpia = parte.Trim();
                if (!string.IsNullOrEmpty(parteLimpia))
                {
                    detalles.Add(parteLimpia);
                }
            }
        }
        else
        {
            // Extraer información estructurada
            if (descripcion.Contains("Rol:"))
                detalles.Add("Información de rol");

            if (descripcion.Contains("IP:"))
                detalles.Add("Información de IP");

            if (descripcion.Contains("Módulo:"))
                detalles.Add("Información de módulo");
        }

        return detalles;
    }

    public string GetBadgeAccionClass(string claveAccion)
    {
        if (string.IsNullOrEmpty(claveAccion))
            return "badge-sistema";

        var accionUpper = claveAccion.ToUpper();

        if (accionUpper.Contains("SESION") || accionUpper.Contains("LOGIN") || accionUpper.Contains("LOGOUT"))
            return "badge-sesion";

        if (accionUpper.Contains("USUARIO") || accionUpper.Contains("USER"))
            return "badge-usuario";

        if (accionUpper.Contains("CSV") || accionUpper.Contains("UPLOAD") || accionUpper.Contains("CARGA"))
            return "badge-configuracion";

        if (accionUpper.Contains("MTTO") || accionUpper.Contains("MANTENIMIENTO") || accionUpper.Contains("MAINTENANCE"))
            return "badge-mantenimiento";

        return "badge-sistema";
    }
}