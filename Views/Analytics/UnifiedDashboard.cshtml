@model MantenimientosTI.Models.ViewModels.UnifiedDashboardViewModel
@{
    ViewData["Title"] = "Dashboard de Actividad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .stat-card {
        background: #2E86AB; /* Color sólido por defecto */
        color: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: rgba(255,255,255,0.3);
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 15px 0 5px 0;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

    .stat-label {
        font-size: 1rem;
        font-weight: 600;
        opacity: 0.95;
        margin-bottom: 5px;
    }

    .stat-desc {
        font-size: 0.75rem;
        opacity: 0.8;
        display: block;
        margin-top: 5px;
    }

    .stat-card i {
        opacity: 0.9;
        filter: drop-shadow(1px 1px 2px rgba(0,0,0,0.2));
    }

    .card-custom {
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #008e60 0%, #006747 100%);
        color: white;
        border-radius: 10px 10px 0 0 !important;
        padding: 15px 20px;
    }

    .quick-filter {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .nav-tabs .nav-link {
        border: none;
        color: #666;
        font-weight: 500;
        padding: 12px 20px;
    }

        .nav-tabs .nav-link.active {
            border-bottom: 3px solid #008e60;
            color: #008e60;
            background: transparent;
        }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #008e60;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 10px;
    }

    .progress-thin {
        height: 6px;
        margin-top: 5px;
    }

    .security-high {
        border-left: 4px solid #dc3545;
    }

    .security-medium {
        border-left: 4px solid #ffc107;
    }

    .security-low {
        border-left: 4px solid #28a745;
    }

    .user-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .user-card:hover {
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .action-badge {
        font-size: 0.75rem;
    }

    .hover-scale {
        transition: all 0.3s ease;
    }

        .hover-scale:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .icon-shape {
        width: 50px;
        height: 50px;
        min-width: 50px;
    }

    /* ESTILOS PARA LA BITÁCORA */
    .timestamp-oculto {
        display: none;
    }

    .badge-sesion {
        background-color: #28a745;
        color: white;
    }

    .badge-usuario {
        background-color: #ffc107;
        color: black;
    }

    .badge-sistema {
        background-color: #6c757d;
        color: white;
    }

    .badge-configuracion {
        background-color: #007bff;
        color: white;
    }

    .badge-mantenimiento {
        background-color: #17a2b8;
        color: white;
    }

    .table-verde th {
        background-color: #008e60 !important;
        color: white;
    }

    .bg-verde-claro {
        background-color: #e8f5e8 !important;
    }

    .text-verde-oscuro {
        color: #006747 !important;
    }

    .border-verde {
        border-color: #008e60 !important;
    }

</style>

<div class="container-fluid mt-4">
    <!-- HEADER -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">Dashboard de actividad</h2>
                    <p class="text-muted mb-0">Resumen completo del sistema - Fase 2 mejorada</p>
                </div>
                <div class="text-end">
                    <small class="text-muted">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="quick-filter">
                <form method="get" class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label">Desde:</label>
                        <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Hasta:</label>
                        <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-filter"></i> Filtrar
                            </button>
                            <a href="@Url.Action("UnifiedDashboard")" class="btn btn-outline-secondary">
                                <i class="fas fa-refresh"></i> Limpiar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TARJETAS DE ESTADÍSTICAS - AJUSTADAS -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-4">
            <div class="card border-0 h-100 hover-scale" style="border-radius: 15px; background-color: #dc3545; min-height: 120px;">
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-danger mb-1 fw-bold" style="font-size: 0.75rem;">INICIOS DE SESIÓN</span>
                            <h2 class="text-white mb-0" style="font-size: 1.75rem;">@Model.TotalSessions</h2>
                            <small class="text-white-50">Accesos al sistema</small>
                        </div>
                        <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                            <i class="fas fa-user-clock text-danger" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* <div class="col-xl-3 col-md-4">
            <div class="card border-0 h-100 hover-scale" style="border-radius: 15px; background-color: #6c757d; min-height: 120px;">
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-secondary mb-1 fw-bold" style="font-size: 0.75rem;">NAVEGACIONES</span>
                            <h2 class="text-white mb-0" style="font-size: 1.75rem;">@Model.TotalPageViews</h2>
                            <small class="text-white-50">Páginas visitadas</small>
                        </div>
                        <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                            <i class="fas fa-chart-bar text-secondary" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@
        <div class="col-xl-3 col-md-4">
            <div class="card border-0 h-100 hover-scale" style="border-radius: 15px; background-color: #fd7e14; min-height: 120px;">
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-warning mb-1 fw-bold" style="font-size: 0.75rem;">TOTAL DE ACTIVIDADES</span>
                            <h2 class="text-white mb-0" style="font-size: 1.75rem;">@Model.TotalActions</h2>
                            <small class="text-white-50">Todas las acciones</small>
                        </div>
                        <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                            <i class="fas fa-tasks text-warning" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-4">
            <div class="card border-0 h-100 hover-scale" style="border-radius: 15px; background-color: #0dcaf0; min-height: 120px;">
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-info mb-1 fw-bold" style="font-size: 0.75rem;">ARCHIVOS CSV</span>
                            <h2 class="text-white mb-0" style="font-size: 1.75rem;">@Model.CsvUploads</h2>
                            <small class="text-white-50">Cargas realizadas</small>
                        </div>
                        <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                            <i class="fas fa-file-import text-info" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SEGUNDA FILA - MANTENIMIENTOS TERMINADOS -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-4">
            <div class="card border-0 h-100 hover-scale" style="border-radius: 15px; background-color: #198754; min-height: 120px;">
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-white text-success mb-1 fw-bold" style="font-size: 0.75rem;">MANTENIMIENTOS TERMINADOS</span>
                            <h2 class="text-white mb-0" style="font-size: 1.75rem;">@Model.MaintenanceActions</h2>
                            <small class="text-white-50">Mantenimientos completados</small>
                        </div>
                        <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                            <i class="fas fa-check-circle text-success" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS - NUEVO ORDEN -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="dashboardTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="activity-tab" data-bs-toggle="tab"
                            data-bs-target="#activity" type="button" role="tab">
                        <i class="fas fa-list-alt me-2"></i>Bitácora completa
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="users-tab" data-bs-toggle="tab"
                            data-bs-target="#users" type="button" role="tab">
                        <i class="fas fa-users me-2"></i>Usuarios y actividades
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="overview-tab" data-bs-toggle="tab"
                            data-bs-target="#overview" type="button" role="tab">
                        <i class="fas fa-chart-pie me-2"></i>Resumen general
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- CONTENIDO DE PESTAÑAS - NUEVO ORDEN -->
    <div class="tab-content" id="dashboardTabsContent">

        <!-- PESTAÑA 1: BITÁCORA COMPLETA -->
        <div class="tab-pane fade show active" id="activity" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card card-custom">
                        <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-list-alt me-2"></i>Bitácora de actividad del sistema
                            </h5>
                            <span class="badge bg-light text-dark">@Model.RecentActivities.Count registros totales</span>
                        </div>

                        <!-- FILTROS MEJORADOS -->
                        <div class="card-body">

                            <!-- TABLA DE BITÁCORA -->
                            @if (Model.RecentActivities.Any())
                            {
                                <div class="table-responsive">
                                    <table id="tablaBitacora" class="table table-striped table-hover w-100">
                                        <thead>
                                            <tr>
                                                <th>Fecha y hora</th>
                                                <th class="timestamp-oculto">Timestamp</th>
                                                <th>Usuario</th>
                                                <th>Acción</th>
                                                <th>Descripción</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var registro in Model.RecentActivities)
                                            {
                                                <tr>
                                                    <td class="text-nowrap">
                                                        <small>@registro.Timestamp.ToString("dd/MM/yyyy")</small><br>
                                                        <strong>@registro.Timestamp.ToString("HH:mm:ss")</strong>
                                                    </td>
                                                    <td class="timestamp-oculto">
                                                        @registro.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold">@registro.UserName</div>
                                                        <small class="text-muted">@ObtenerTipoUsuario(registro.UserName)</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge @GetBadgeAccionClass(registro.Action)">
                                                            @FormatearNombreAccion(registro.Action)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="fw-semibold">@registro.Description</div>
                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle fa-3x mb-3"></i>
                                    <p>No hay actividad reciente para el período seleccionado</p>
                                </div>
                            }
                        </div>

                        <!-- PIE DE PÁGINA -->
                        <div class="card-footer text-muted d-flex justify-content-between" style="background-color: #f8f9fa;">
                            <small>
                                Generado el: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") |
                                Total: @Model.RecentActivities.Count registros en bitácora
                            </small>
                            <small>
                                <i class="fas fa-database me-1"></i>Registros completos del sistema
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 2: USUARIOS Y ACTIVIDADES (MEJORADA) -->
        <div class="tab-pane fade" id="users" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card card-custom">
                        <div class="card-header card-header-custom">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2"></i>Usuarios más activos - Detalle de actividades
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.TopUsers.Any())
                            {
                                <div class="row">
                                    @foreach (var user in Model.TopUsers)
                                    {
                                        var maxActivity = Model.TopUsers.Max(u => u.ActivityCount);
                                        var percentage = maxActivity > 0 ? (user.ActivityCount * 100 / maxActivity) : 0;

                                        <div class="col-lg-6 mb-4">
                                            <div class="card user-card h-100">
                                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <div class="user-avatar me-3">
                                                            @user.UserName.Substring(0, 1)
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0">@user.UserName</h6>
                                                            <small class="text-muted">@user.Role</small>
                                                        </div>
                                                    </div>
                                                    <span class="badge bg-primary">@user.ActivityCount actividades</span>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Barra de progreso -->
                                                    <div class="mb-3">
                                                        <div class="d-flex justify-content-between mb-1">
                                                            <small>Nivel de actividad</small>
                                                            <small>@percentage%</small>
                                                        </div>
                                                        <div class="progress progress-thin">
                                                            <div class="progress-bar bg-success" style="width: @percentage%"></div>
                                                        </div>
                                                    </div>


                                                    <!-- Detalle de acciones MEJORADO -->
                                                    <h6 class="text-muted mb-2">Actividades más frecuentes:</h6>
                                                    @if (user.ActionDetails.Any())
                                                    {
                                                        foreach (var action in user.ActionDetails.Take(4))
                                                        {
                                                            <div class="d-flex justify-content-between align-items-start mb-3 p-2 border-bottom">
                                                                <div style="flex: 1;">
                                                                    <small class="fw-bold text-dark d-block mb-1">@action.ActionDescription</small>
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <small class="text-muted">
                                                                            <i class="fas fa-clock me-1"></i>@action.LastPerformed.ToString("dd/MM HH:mm")
                                                                        </small>
                                                                        <span class="badge bg-primary action-badge">
                                                                            <i class="fas fa-repeat me-1"></i>@action.Count
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (user.ActionDetails.Count > 4)
                                                        {
                                                            <div class="text-center mt-2">
                                                                <small class="text-muted">
                                                                    <i class="fas fa-ellipsis-h me-1"></i>+ @(user.ActionDetails.Count - 4) actividades más...
                                                                </small>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center text-muted py-2">
                                                            <i class="fas fa-info-circle me-1"></i>
                                                            <small>No se encontraron actividades específicas</small>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-users fa-3x mb-3"></i>
                                    <p>No hay datos de usuarios para el período seleccionado</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 3: ALERTAS (ANTES SEGURIDAD) -->
        <div class="tab-pane fade" id="security" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card card-custom">
                        <div class="card-header card-header-custom">
                            <h5 class="mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>Alertas del sistema
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.SecurityEvents.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Fecha/Hora</th>
                                                <th>Usuario</th>
                                                <th>Tipo</th>
                                                <th>Descripción</th>
                                                <th>Severidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var securityEvent in Model.SecurityEvents)
                                            {
                                                <tr class="@GetSecurityRowClass(securityEvent.Severity)">
                                                    <td class="text-nowrap">
                                                        <small>@securityEvent.Timestamp.ToString("dd/MM")</small>
                                                        <br>
                                                        <strong>@securityEvent.Timestamp.ToString("HH:mm")</strong>
                                                    </td>
                                                    <td>
                                                        <strong>@securityEvent.UserName</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-warning">@securityEvent.EventType</span>
                                                    </td>
                                                    <td>
                                                        <small>@securityEvent.Description</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge @GetSecurityBadgeClass(securityEvent.Severity)">
                                                            @securityEvent.Severity.ToUpper()
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-success py-4">
                                    <i class="fas fa-check-circle fa-3x mb-3"></i>
                                    <p>No hay alertas de seguridad relevantes</p>
                                    <small class="text-muted">¡Todo parece estar en orden!</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 4: RESUMEN GENERAL (AHORA ÚLTIMA) -->
        <div class="tab-pane fade" id="overview" role="tabpanel">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card card-custom">
                        <div class="card-header card-header-custom">
                            <h5 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>Actividad por hora del día
                            </h5>
                        </div>
                        <div class="card-body">
                            <canvas id="activityByHourChart" height="250"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                </div>
            </div>


        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        // Gráfico de Actividad por Hora
        document.addEventListener('DOMContentLoaded', function() {
            var activityCtx = document.getElementById('activityByHourChart').getContext('2d');
            var activityChart = new Chart(activityCtx, {
                type: 'bar',
                data: {
                    labels: [
                        @foreach (var hour in Model.ActivityByHour)
                        {
                                            @Html.Raw($"'{hour.Hour}:00',")
                        }
                    ],
                    datasets: [{
                        label: 'Actividad por hora',
                        data: [
                            @foreach (var hour in Model.ActivityByHour)
                            {
                                                @Html.Raw($"{hour.Count},")
                            }
                        ],
                        backgroundColor: 'rgba(0, 142, 96, 0.6)',
                        borderColor: 'rgba(0, 142, 96, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Gráfico de Tipos de Actividad
            var typeCtx = document.getElementById('activityByTypeChart').getContext('2d');
            var typeChart = new Chart(typeCtx, {
                type: 'doughnut',
                data: {
                    labels: [
                        @foreach (var type in Model.ActivityByType)
                        {
