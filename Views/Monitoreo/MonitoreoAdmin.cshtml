@model List<MantenimientosTI.Models.VMMonitoreoAdmin>
@{
    ViewData["Title"] = "Monitoreo Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ESTILO PARA EL BOTON*/
    .cfematico-btn {
        width: 19px;
        height: 19px;
        padding: 0;
        margin: 1px;
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 50%;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        transition: transform 0.1s ease;
        cursor: pointer;
        position: relative;
        background-color: #28a745;
    }

        /* Clases de color con !important para asegurar que sobrescriban */
        .cfematico-btn.bg-success {
            background-color: #28a745 !important;
        }

        .cfematico-btn.bg-danger {
            background-color: #dc3545 !important;
        }

        .cfematico-btn.bg-warning {
            background-color: #ffc107 !important;
        }


    .btn.cfematico-btn:hover {
        background-color: #228b3d;
        filter: none;
        transform: scale(1.1);
    }

    .cfematico-btn.selected {
        box-shadow: 0 0 0 2px #0d6efd;
        transform: scale(1.1);
        z-index: 1;
    }

    /* ESTILOS PARA LAS TARJETAS DE ZONA */
    .zona-card {
        transition: all 0.3s ease;
        margin-bottom: 6px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background-color: white;
        height: 150px !important;
    }

    .zona-header {
        padding: 3px 5px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .zona-body {
        padding: 4px;
        height: calc(100% - 28px);
    }

    .cfematicos-container {
        display: flex;
        flex-wrap: wrap;
        gap: 1px;
        justify-content: flex-start;
    }

    .zona-title {
        font-weight: 600;
        margin: 0;
        font-size: 0.8rem;
        display: inline-block;
    }

    .zona-count {
        font-size: 0.65rem;
        float: right;
    }

    /* GRID PRINCIPAL: ZONAS + INFO */
    .main-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 6px;
    }

    /* CONTENEDOR DE ZONAS Y EVENTOS */
    .zones-events-container {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* GRID DE ZONAS */
    .zones-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
    }

    /* CONTENEDOR DE LA INFORMACIÓN DEL CFEMÁTICO */
    .info-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-card {
        border: 1px solid #dee2e6;
        border-radius: 5px;
        padding: 8px;
        background-color: white;
    }

    /* TARJETA DE EVENTOS */
    .events-card {
        border: 1px solid #dee2e6;
        border-radius: 5px;
        padding: 8px;
        background-color: white;
    }

    .compact-container {
        padding: 8px;
    }

    /* BOTONES DE ESTADO */
    .status-btn {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 1px solid rgba(0,0,0,0.1);
        margin-right: 4px;
    }

    .card-header {
        padding: 8px 12px !important;
        background-color: #f8f9fa !important;
    }

    /* SELECTOR DE RANGO DE TIEMPO */
    #rangoTiempo {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 0.85rem;
        background-color: white;
        cursor: pointer;
    }

        #rangoTiempo:hover {
            border-color: #86b7fe;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.1);
        }

    @@media (max-width: 1400px) {
        .zones-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 992px) {
        .zones-container {
            grid-template-columns: repeat(2, 1fr);
        }

        .main-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ESTILOS PARA LA LISTA DE EVENTOS */
    .event-item {
        border-bottom: 1px solid #eee;
        padding: 5px 0;
    }

    .event-severity {
        font-size: 0.7rem;
        padding: 2px 5px;
        border-radius: 3px;
    }

    .chart-container {
        position: relative;
        height: 200px;
    }

    /* ESTILOS PARA LA TABLA DE EVENTOS */
    .events-card {
        border: 1px solid #dee2e6;
        border-radius: 5px;
        padding: 8px;
        background-color: white;
    }

    #tablaEventos {
        font-size: 0.75rem;
        margin-bottom: 0;
    }

        #tablaEventos th {
            white-space: nowrap;
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
        }

        #tablaEventos td, #tablaEventos th {
            padding: 0.3rem 0.5rem;
            vertical-align: middle;
            text-align: center;
        }

        #tablaEventos tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.03);
        }

        #tablaEventos td.clickable-cell {
            cursor: pointer;
            transition: background-color 0.2s;
        }

            #tablaEventos td.clickable-cell:hover {
                background-color: rgba(13, 110, 253, 0.1);
            }

    #selectFalla {
        max-width: 200px;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }

    /* ESTILOS PARA LOS SELECTORES */
    .filters-container {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .filter-select {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        border: 1px solid #ced4da;
    }

    /* ESTILOS PARA LA TABLA DE MANTENIMIENTOS */
    #tablaMantenimientos {
        font-size: 0.75rem;
        margin-bottom: 0;
    }

        #tablaMantenimientos th {
            white-space: nowrap;
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
        }

        #tablaMantenimientos td, #tablaMantenimientos th {
            padding: 0.3rem 0.5rem;
            vertical-align: middle;
            text-align: center;
        }

        #tablaMantenimientos tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.03);
        }

    /* ESTILOS PARA EL MODAL DE DETALLES */
    #problemasDetalle, #diagnosticoDetalle, #observacionesDetalle {
        min-height: 50px;
        white-space: pre-wrap;
    }

    /* BOTONES DE DESCARGA */
    .btn-descarga {
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
    }

    /* ESTILOS PARA LAS FOTOS DEL MODAL */
    .img-thumbnail {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 2px;
        background-color: #f8f9fa;
    }

    #fotosMantenimientoContainer {
        border-top: 1px solid #eee;
        padding-top: 15px;
    }

    /* PLACEHOLDER PARA FOTOS FALTANTES */
    img[src*="placeholder.com"] {
        opacity: 0.6;
    }
</style>

<div class="container mt-2 compact-container">
    <div class="card shadow-sm">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Monitoreo de CFEmáticos</h5>
            <div class="d-flex align-items-center gap-3">
                <div class="text-muted small me-3">
                    Última actualización @ViewBag.UltimaActualizacion

                </div>
            </div>
        </div>

        <div class="card-body p-2">
            <div class="main-grid">
                <div class="zones-events-container">
                    <div class="zones-container">
                        <div>
                            @for (int i = 0; i < Model.Count; i += 4)
                            {
                                var zonaItem = Model[i];
                                <div class="zona-card">
                                    <div class="zona-header">
                                        <span class="zona-title">@zonaItem.Zona.NombreZona</span>
                                        <span class="badge bg-success zona-count">@zonaItem.Cfematicos.Count</span>
                                    </div>
                                    <div class="zona-body">
                                        <div class="cfematicos-container">
                                            @foreach (var cfematico in zonaItem.Cfematicos)
                                            {
                                                <button class="btn cfematico-btn"
                                                        data-num-cajero="@cfematico.NumCajero"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="@cfematico.NumCajero">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div>
                            @for (int i = 1; i < Model.Count; i += 4)
                            {
                                var zonaItem = Model[i];
                                <div class="zona-card">
                                    <div class="zona-header">
                                        <span class="zona-title">@zonaItem.Zona.NombreZona</span>
                                        <span class="badge bg-success zona-count">@zonaItem.Cfematicos.Count</span>
                                    </div>
                                    <div class="zona-body">
                                        <div class="cfematicos-container">
                                            @foreach (var cfematico in zonaItem.Cfematicos)
                                            {
                                                <button class="btn cfematico-btn"
                                                        data-num-cajero="@cfematico.NumCajero"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="@cfematico.NumCajero">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div>
                            @for (int i = 2; i < Model.Count; i += 4)
                            {
                                var zonaItem = Model[i];
                                <div class="zona-card">
                                    <div class="zona-header">
                                        <span class="zona-title">@zonaItem.Zona.NombreZona</span>
                                        <span class="badge bg-success zona-count">@zonaItem.Cfematicos.Count</span>
                                    </div>
                                    <div class="zona-body">
                                        <div class="cfematicos-container">
                                            @foreach (var cfematico in zonaItem.Cfematicos)
                                            {
                                                <button class="btn cfematico-btn"
                                                        data-num-cajero="@cfematico.NumCajero"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="@cfematico.NumCajero">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div>
                            @for (int i = 3; i < Model.Count; i += 4)
                            {
                                var zonaItem = Model[i];
                                <div class="zona-card">
                                    <div class="zona-header">
                                        <span class="zona-title">@zonaItem.Zona.NombreZona</span>
                                        <span class="badge bg-success zona-count">@zonaItem.Cfematicos.Count</span>
                                    </div>
                                    <div class="zona-body">
                                        <div class="cfematicos-container">
                                            @foreach (var cfematico in zonaItem.Cfematicos)
                                            {
                                                <button class="btn cfematico-btn"
                                                        data-num-cajero="@cfematico.NumCajero"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="@cfematico.NumCajero">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="events-card mb-3">
                        <h6 class="mb-2">Mantenimientos programados</h6>
                        <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-striped" id="tablaMantenimientos">
                                <thead class="sticky-top bg-light">
                                    <tr>
                                        <th>Fecha programada</th>
                                        <th>Fecha terminada</th>
                                        <th>Estatus</th>
                                        <th>Hoja de servicio</th>
                                        <th>Datos de terminación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">Seleccione un CFEmático</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="events-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Estadísticas de eventos</h6>
                            <div class="filters-container">
                                <select id="selectFalla" class="filter-select">
                                    <option value="">Cargando tipos de falla...</option>
                                </select>
                                <select id="selectYear" class="filter-select">
                                    <option value="2025">2025</option>
                                    <option value="2024">2024</option>
                                    <option value="2023">2023</option>
                                </select>
                            </div>
                        </div>
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-striped table-hover" id="tablaEventos">
                                <thead class="sticky-top bg-light">
                                    <tr>
                                        <th>Descripción</th>
                                        <th>Ene</th>
                                        <th>Feb</th>
                                        <th>Mar</th>
                                        <th>Abr</th>
                                        <th>May</th>
                                        <th>Jun</th>
                                        <th>Jul</th>
                                        <th>Ago</th>
                                        <th>Sep</th>
                                        <th>Oct</th>
                                        <th>Nov</th>
                                        <th>Dic</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="13" class="text-center text-muted py-3">Seleccione un CFEmático y un tipo de falla</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="info-container">
                    <div class="info-card">
                        <div class="small">
                            <h6 class="border-bottom pb-1 mb-2">Información del CFEmático</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Número de cajero:</span>
                                        <span id="numCajero" class="ms-2"></span>
                                    </div>
                                    <div class="mb-3">
                                        <span class="fw-bold">Número de serie:</span>
                                        <span id="numSerie" class="ms-2"></span>
                                    </div>
                                    <div class="mb-3">
                                        <span class="fw-bold">Dirección IP:</span>
                                        <span id="ipCajero" class="ms-2"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Número de activo fijo:</span>
                                        <span id="numActFijo" class="ms-2"></span>
                                    </div>
                                    <div class="mb-3">
                                        <span class="fw-bold">Número de inventario:</span>
                                        <span id="numInventario" class="ms-2"></span>
                                    </div>
                                    <div class="mb-3">
                                        <span class="fw-bold">Versión:</span>
                                        <span id="version" class="ms-2"></span>
                                    </div>
                                </div>
                            </div>

                            <h6 class="border-bottom pb-2 mb-3 mt-3">Ubicación</h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Zona:</span>
                                        <span id="zona" class="ms-2"></span>
                                    </div>
                                    <div class="mb-3">
                                        <span class="fw-bold">Centro:</span>
                                        <span id="centro" class="ms-2"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <span class="fw-bold">Agencia:</span>
                                        <span id="agencia" class="ms-2"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfica de Eventos -->
                    <div class="info-card mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Estadísticas de eventos</h6>
                            <select id="rangoTiempo" class="form-select form-select-sm" style="width: 145px;">
                                <option value="1" selected>Últimas 24 Horas</option>
                                <option value="7">Últimos 7 Días</option>
                                <option value="30">Últimos 30 Días</option>
                                <option value="90">Últimos 3 Meses</option>
                            </select>
                        </div>
                        <div class="chart-container">
                            <canvas id="basicBarChart"></canvas>
                        </div>
                    </div>

                    <!-- Estadísticas Avanzadas -->
                    <div class="info-card mt-3">
                        <h6 class="border-bottom pb-2 mb-3">Análisis de eventos</h6>
                        <div id="estadisticasAvanzadas">
                            <p class="text-muted small">Seleccione un CFEmático para ver análisis detallado</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventosModal" tabindex="-1" aria-labelledby="eventosModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventosModalLabel">Eventos detallados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalEventosContent">
                    <p>Cargando eventos...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventosMensualesModal" tabindex="-1" aria-labelledby="eventosMensualesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventosMensualesModalLabel">Eventos Mensuales</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalEventosMensualesContent">
                    <p>Cargando eventos...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detallesMantenimientoModal" tabindex="-1" aria-labelledby="detallesMantenimientoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detallesMantenimientoModalLabel">Detalles de Mantenimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <h6 class="d-inline">RPE del Responsable del Mantenimiento: </h6>
                    <span id="rpeDetalle" class="p-2 bg-light rounded font-monospace"></span>
                </div>
                <div class="mb-3">
                    <h6>Problemas reportados:</h6>
                    <div id="problemasDetalle" class="p-2 bg-light rounded"></div>
                </div>
                <div class="mb-3">
                    <h6>Diagnóstico:</h6>
                    <div id="diagnosticoDetalle" class="p-2 bg-light rounded"></div>
                </div>
                <div class="mb-3">
                    <h6>Observaciones:</h6>
                    <div id="observacionesDetalle" class="p-2 bg-light rounded"></div>
                </div>

                <div id="fotosMantenimientoContainer" class="mt-4 d-none">
                    <h6 class="border-bottom pb-2">Fotos del Mantenimiento</h6>
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <p class="small mb-1">Foto Antes</p>
                            <img id="fotoAntes" src="" class="img-fluid img-thumbnail mb-2" style="max-height: 200px;">
                        </div>
                        <div class="col-md-4 text-center">
                            <p class="small mb-1">Foto Durante</p>
                            <img id="fotoDurante" src="" class="img-fluid img-thumbnail mb-2" style="max-height: 200px;">
                        </div>
                        <div class="col-md-4 text-center">
                            <p class="small mb-1">Foto Después</p>
                            <img id="fotoDespues" src="" class="img-fluid img-thumbnail mb-2" style="max-height: 200px;">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // --- VARIABLES GLOBALES ---
        var basicBarChart = null;
        var selectedCfematico = null;
        var selectedCfematicoEstado = null;

        // --- BLOQUE PRINCIPAL DE EJECUCIÓN ---
        $(document).ready(function() {
            // 1. Inicializar tooltips de Bootstrap
            $('[data-bs-toggle="tooltip"]').tooltip({
                trigger: 'hover'
            });

            // 2. Cargar los tipos de falla en el selector
            cargarTiposFalla();

            // 3. Manejador de evento principal para los botones de CFEmático
            $(document).on('click', '.cfematico-btn', function() {
                var $clickedButton = $(this);
                var wasSelected = $clickedButton.hasClass('selected');
                var numCajero = $clickedButton.data('num-cajero');

                // Siempre será 'verde', pero mantenemos la variable por consistencia
                selectedCfematicoEstado = 'verde';

                $('.cfematico-btn').removeClass('selected');

                if (!wasSelected) {
                    $clickedButton.addClass('selected');
                    selectedCfematico = numCajero;

                    // Llamadas para cargar toda la información
                    cargarDetallesCfematico(numCajero);
                    actualizarGrafica(numCajero);
                    mostrarEstadisticasAvanzadas(numCajero);
                    actualizarTablaEventos();
                    cargarMantenimientosCfematico(numCajero);
                } else {
                    selectedCfematico = null;
                    selectedCfematicoEstado = null;
                    limpiarDatos();
                }
            });

            // 4. Listeners para los filtros de las tablas
            $('#rangoTiempo').change(function() {
                if (selectedCfematico) {
                    actualizarGrafica(selectedCfematico);
                    mostrarEstadisticasAvanzadas(selectedCfematico);
                }
            });

            $('#selectYear').change(function() {
                if (selectedCfematico) {
                    actualizarTablaEventos();
                }
            });

            $('#selectFalla').change(function() {
                if (selectedCfematico) {
                    actualizarTablaEventos();
                }
            });
        });

        // --- FUNCIONES DE CARGA DE DATOS ---

        function cargarDetallesCfematico(numCajero) {
            $.get('@Url.Action("ObtenerDetallesCfematico", "Monitoreo")', { numCajero: numCajero })
                .done(function(data) {
                    if (data.error) {
                        console.error(data.error);
                        mostrarErrorEnUI("No se pudieron cargar los detalles");
                        return;
                    }
                    $('#numCajero').text(data.numCajero);
                    $('#numActFijo').text(data.numActFijo);
                    $('#numSerie').text(data.numSerie);
                    $('#numInventario').text(data.numInventario);
                    $('#ipCajero').text(data.ipCajero);
                    $('#version').text(data.version);
                    $('#zona').text(data.zona);
                    $('#agencia').text(data.agencia);
                    $('#centro').text(data.centro);
                })
                .fail(function() {
                    mostrarErrorEnUI("Error de conexión");
                });
        }

        function actualizarGrafica(numCajero) {
            var dias = $('#rangoTiempo').val();
            $.get('@Url.Action("ObtenerEstadisticasEventos", "Monitoreo")', { numCajero: numCajero, dias: dias }, function(data) {
                var ctx = document.getElementById('basicBarChart').getContext('2d');
                if (basicBarChart !== null) {
                    basicBarChart.destroy();
                }
                basicBarChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Críticos', 'Altos', 'Bajos'],
                        datasets: [
                            {
                                label: 'Operativos',
                                data: [data.criticosOperativos, data.altosOperativos, data.bajosOperativos],
                                backgroundColor: 'rgba(231, 76, 60, 0.8)'
                            },
                            {
                                label: 'Técnicos',
                                data: [data.criticosTecnicos, data.altosTecnicos, data.bajosTecnicos],
                                backgroundColor: 'rgba(52, 152, 219, 0.8)'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true } },
                        onClick: function(evt, elements) {
                            if (elements.length > 0) {
                                var clickedElement = elements[0];
                                var datasetIndex = clickedElement.datasetIndex;
                                var labelIndex = clickedElement.index;
                                var severidad = labelIndex === 0 ? 100 : (labelIndex === 1 ? 50 : 0);
                                var tipo = datasetIndex === 0 ? 'O' : 'T';
                                var selectedCfematico = $('.cfematico-btn.selected').data('num-cajero');
                                cargarEventosParaModal(selectedCfematico, severidad, tipo, dias);
                            }
                        }
                    }
                });
            });
        }

        function mostrarEstadisticasAvanzadas(numCajero) {
            var dias = $('#rangoTiempo').val();
            $.get('@Url.Action("ObtenerEstadisticasAvanzadas", "Monitoreo")', { numCajero: numCajero, dias: dias }, function(data) {
                var $container = $('#estadisticasAvanzadas');
                $container.empty();
                if (data.mensaje) {
                    $container.html(`<p class="text-muted small">${data.mensaje}</p>`);
                    return;
                }
                var html = `
                    <div class="mb-3">
                        <h6 class="small fw-bold">Total de eventos: <span class="badge bg-secondary">${data.totalEventos}</span></h6>
                    </div>
                    <div class="mb-3">
                        <h6 class="small fw-bold">Eventos más comunes:</h6>
                        ${data.comunes.map(evento => `
                            <div class="d-flex justify-content-between small mb-1">
                                <span>${evento.descripcion}</span>
                                <span class="badge bg-secondary">${evento.cantidad}</span>
                            </div>
                        `).join('')}
                    </div>`;
                if (data.tiempoPromedio) {
                    html += `
                        <div class="mb-3">
                            <h6 class="small fw-bold">Tiempo promedio entre fallos:</h6>
                            <div class="small">${data.tiempoPromedio.toFixed(1)} horas</div>
                        </div>`;
                }
                $container.html(html);
            });
        }

        function actualizarTablaEventos() {
            if (!selectedCfematico) return;
            var claveFalla = $('#selectFalla').val();
            var year = $('#selectYear').val();
            $.get('@Url.Action("ObtenerEstadisticasEventosPorMes", "Monitoreo")', { claveFalla: claveFalla, year: year, numCajero: selectedCfematico }, function(data) {
                var $tbody = $('#tablaEventos tbody');
                $tbody.empty();
                if (data.length === 0) {
                    $tbody.append('<tr><td colspan="13" class="text-center text-muted py-3">No hay datos para mostrar</td></tr>');
                    return;
                }
                $.each(data, function(index, item) {
                    var row = '<tr>';
                    row += `<td class="text-start">${item.descripcion}</td>`;
                    for (var i = 1; i <= 12; i++) {
                        var monthKey = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'][i-1];
                        var count = item[monthKey] || 0;
                        row += `<td class="clickable-cell" data-descripcion="${item.descripcion}" data-mes="${i}" data-year="${year}" data-clave-falla="${claveFalla}">${count}</td>`;
                    }
                    row += '</tr>';
                    $tbody.append(row);
                });
                $('.clickable-cell').click(function() {
                    var descripcion = $(this).data('descripcion');
                    var mes = $(this).data('mes');
                    var year = $(this).data('year');
                    var claveFalla = $(this).data('clave-falla');
                    cargarEventosMensuales(selectedCfematico, descripcion, mes, year, claveFalla);
                });
            });
        }

        function cargarMantenimientosCfematico(numCajero) {
             $.get('@Url.Action("ObtenerMantenimientosCfematico", "Monitoreo")', { numCajero: numCajero }, function(data) {
                var $tbody = $('#tablaMantenimientos tbody').empty();
                if (data.error || data.length === 0) {
                    var message = data.error ? "Error al cargar mantenimientos" : "No hay mantenimientos registrados";
                    $tbody.append(`<tr><td colspan="5" class="text-center text-muted py-3">${message}</td></tr>`);
                    return;
                }
                data.sort((a, b) => new Date(a.fechaProgramada.split('/').reverse().join('-')) - new Date(b.fechaProgramada.split('/').reverse().join('-')));
                $.each(data, function(index, item) {
                    var hojaServicioHtml = item.tieneHojaServicio
                        ? `<button class="btn btn-sm btn-outline-primary btn-descarga" data-num-cajero="${numCajero}" data-fecha="${item.fechaProgramada}"><i class="fas fa-file-pdf"></i> Descargar</button>`
                        : 'N/A';
                    var detallesHtml = item.estatus === 'TERMINADO'
                        ? `<button class="btn btn-sm btn-outline-info btn-detalles" data-rpe="${item.rpe || 'No registrado'}" data-tipo-mtto="${item.tipoMantenimiento}" data-problemas="${escapeHtml(item.problemas || '')}" data-diagnostico="${escapeHtml(item.diagnostico || '')}" data-observaciones="${escapeHtml(item.observaciones || '')}" data-fotos='${JSON.stringify(item.fotos || null)}'><i class="fas fa-eye"></i> Ver</button>`
                        : 'N/A';
                    var row = `<tr>
                        <td>${item.fechaProgramada}</td>
                        <td>${item.fechaTerminacion}</td>
                        <td><span class="badge ${item.estatus === 'PENDIENTE' ? 'bg-warning' : 'bg-success'}">${item.estatus}</span></td>
                        <td>${hojaServicioHtml}</td>
                        <td>${detallesHtml}</td>
                    </tr>`;
                    $tbody.append(row);
                });
                $('.btn-descarga').click(function() {
                    descargarHojaServicio($(this).data('num-cajero'), $(this).data('fecha'));
                });
                $('.btn-detalles').click(function() {
                    mostrarDetallesMantenimiento($(this));
                });
            });
        }

        // --- FUNCIONES UTILITARIAS Y DE MODALES ---

        function cargarTiposFalla() {
            $.get('@Url.Action("ObtenerTiposFalla", "Monitoreo")', function(data) {
                var $select = $('#selectFalla').empty();
                $select.append($('<option>', { value: '', text: 'TODAS LAS FALLAS' }));
                $.each(data, function(index, item) {
                    $select.append($('<option>', { value: item.claveFalla, text: item.descripcion }));
                });
            });
        }

        function limpiarDatos() {
            $('#numCajero, #numActFijo, #numSerie, #numInventario, #ipCajero, #zona, #agencia, #centro').text('');
            $('#version').text('');
            $('#estadisticasAvanzadas').html('<p class="text-muted small">Seleccione un CFEmático para ver análisis detallado</p>');
            $('#tablaMantenimientos tbody').html('<tr><td colspan="5" class="text-center text-muted py-3">Seleccione un CFEmático</td></tr>');
            if (basicBarChart) {
                basicBarChart.destroy();
                basicBarChart = null;
            }
            $('#tablaEventos tbody').html('<tr><td colspan="13" class="text-center text-muted py-3">Seleccione un CFEmático y un tipo de falla</td></tr>');
            selectedCfematicoEstado = null;
        }

        function mostrarErrorEnUI(mensaje) {
            console.error(mensaje);
            limpiarDatos(); // Limpia los campos para evitar mostrar datos incorrectos
        }

        function cargarEventosParaModal(numCajero, severidad, tipo, dias) {
            $.get('@Url.Action("ObtenerEventosFiltrados", "Monitoreo")', {
                numCajero: numCajero,
                severidad: severidad,
                tipo: tipo,
                dias: dias,
                estado: selectedCfematicoEstado
            }, function (data) {
                var $content = $('#modalEventosContent').empty();

                if (data.length === 0) {
                    $content.html('<p class="text-muted">No hay eventos para estos criterios.</p>');
                } else {
                    // Se construye el HTML usando las propiedades del objeto 'evento'
                    var eventosHtml = data.map(function (evento) {
                        var badgeClass = evento.severidad == 100 ? 'bg-danger' :
                                         evento.severidad == 50 ? 'bg-warning' : 'bg-info';

                        return `
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small">${evento.fuente}</span>
                                    <span class="badge ${badgeClass}">${getSeveridadText(evento.severidad)}</span>
                                </div>
                                <div class="small mt-1">${evento.descripcion}</div>
                                <div class="text-end small text-muted fst-italic mt-1">${evento.fecha}</div>
                            </div>
                        `;
                    }).join('');
                    $content.html(eventosHtml);
                }

                // Se actualiza el título del modal y se muestra
                $('#eventosModalLabel').text(`Eventos ${getSeveridadText(severidad)} (${tipo === 'O' ? 'Operativos' : 'Técnicos'})`);
                new bootstrap.Modal(document.getElementById('eventosModal')).show();
            });
        }

        // REEMPLAZA TU FUNCIÓN ACTUAL CON ESTA VERSIÓN CORREGIDA
        function cargarEventosMensuales(numCajero, descripcion, mes, year, claveFalla) {
            $.get('@Url.Action("ObtenerEventosMensuales", "Monitoreo")', {
                numCajero: numCajero,
                descripcion: descripcion,
                mes: mes,
                year: year,
                claveFalla: claveFalla,
                estado: selectedCfematicoEstado
            }, function (data) {
                var $content = $('#modalEventosMensualesContent').empty();

                // Se define el array de nombres de meses para el título
                var nombreMes = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'][mes - 1];

                if (data.length === 0) {
                    $content.html('<p class="text-muted">No hay eventos para estos criterios.</p>');
                } else {
                    // Se construye el HTML usando las propiedades del objeto 'evento'
                    var eventosHtml = data.map(function (evento) {
                        var badgeClass = evento.severidad == 100 ? 'bg-danger' :
                                         evento.severidad == 50 ? 'bg-warning' : 'bg-info';

                        return `
                            <div class="border-bottom pb-2 mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small">${evento.fuente}</span>
                                    <span class="badge ${badgeClass}">${getSeveridadText(evento.severidad)}</span>
                                </div>
                                <div class="small mt-1">${evento.descripcion}</div>
                                <div class="text-end small text-muted fst-italic mt-1">${evento.fecha}</div>
                            </div>
                        `;
                    }).join('');
                    $content.html(eventosHtml);
                }

                // Se actualiza el título del modal y se muestra
                $('#eventosMensualesModalLabel').text(`Eventos de ${descripcion} - ${nombreMes} ${year}`);
                new bootstrap.Modal(document.getElementById('eventosMensualesModal')).show();
            });
        }

        function mostrarDetallesMantenimiento($btn) {
            $('#rpeDetalle').text($btn.data('rpe') || 'No registrado');
            $('#problemasDetalle').text($btn.data('problemas') || 'No especificado');
            $('#diagnosticoDetalle').text($btn.data('diagnostico') || 'No especificado');
            $('#observacionesDetalle').text($btn.data('observaciones') || 'No especificado');
            const fotosContainer = $('#fotosMantenimientoContainer');
            const esCorrectivo = $btn.data('tipo-mtto') === 'C';
            const fotos = $btn.data('fotos');
            if (esCorrectivo && fotos) {
                fotosContainer.removeClass('d-none');
                const cargarFoto = (id, b64) => $(id).attr('src', b64 ? `data:image/jpeg;base64,${b64}` : 'https://via.placeholder.com/200x150?text=No+disponible');
                cargarFoto('#fotoAntes', fotos.fotoAntes);
                cargarFoto('#fotoDurante', fotos.fotoDurante);
                cargarFoto('#fotoDespues', fotos.fotoDespues);
            } else {
                fotosContainer.addClass('d-none');
            }
            new bootstrap.Modal(document.getElementById('detallesMantenimientoModal')).show();
        }

        function descargarHojaServicio(numCajero, fechaProgramada) {
            var url = `@Url.Action("DescargarHojaServicioCfematico", "Monitoreo")?numCajero=${numCajero}&fechaProgramada=${encodeURIComponent(fechaProgramada)}`;
            window.open(url, '_blank');
        }

        function getSeveridadText(s) { return s === 100 ? 'Críticos' : s === 50 ? 'Altos' : 'Bajos'; }
        function escapeHtml(u) { return u.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;"); }

    </script>
}