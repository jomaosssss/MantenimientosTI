@model List<MantenimientosTI.Models.RegistroActividad>
@{
    ViewData["Title"] = "Bitácora de Actividad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Bitácora de Actividad del Sistema</h4>
        </div>
        <div class="card-body">
            <table id="tablaBitacora" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registro in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@registro.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@registro.Usuario</td>
                            <td><span class="badge bg-secondary">@registro.Accion</span></td>
                            <td>@registro.Descripcion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#tablaBitacora').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                order: [[0, 'desc']]
            });
        });
    </script>
}