@model List<MantenimientosTI.Models.VMBitacora>
@{
    ViewData["Title"] = "Bitácora de Actividad del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var usuarioActual = ViewBag.UsuarioActual as dynamic;
}

<style>
    .bg-verde-argos {
        background-color: #008e60 !important;
    }

    .bg-verde-claro {
        background-color: #e8f5e8 !important;
    }

    .text-verde-oscuro {
        color: #006747 !important;
    }

    .border-verde {
        border-color: #008e60 !important;
    }

    .badge-sesion {
        background-color: #28a745;
        color: white;
    }

    .badge-usuario {
        background-color: #ffc107;
        color: black;
    }

    .badge-sistema {
        background-color: #6c757d;
        color: white;
    }

    .badge-configuracion {
        background-color: #007bff;
        color: white;
    }

    .badge-mantenimiento {
        background-color: #17a2b8;
        color: white;
    }

    .table-verde th {
        background-color: #008e60 !important;
        color: white;
    }

    /* Nuevo estilo para el timestamp oculto */
    .timestamp-oculto {
        display: none;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-verde-argos text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Bitácora de actividad del sistema</h4>
                <small class="text-light">
                    Consultado por: <strong>@usuarioActual?.Nombre</strong>
                    (@usuarioActual?.Rol - @usuarioActual?.Zona)
                </small>
            </div>
            <span class="badge bg-light text-dark">@ViewBag.TotalRegistros registros</span>
        </div>

        <div class="card-body">
            <!-- FILTROS -->
            <div class="row mb-3">
                <div class="col-md-8">
                    <form method="get" class="d-flex align-items-center">
                        <input type="text" name="searchString" class="form-control me-2"
                               placeholder="Buscar en usuario, acción o descripción..."
                               value="@ViewBag.SearchString" style="min-width: 250px;">
                        <select name="tipoFiltro" class="form-select me-2" style="width: auto;">
                            <option value="todo" selected="@(ViewBag.TipoFiltro == "todo")">Todos los eventos</option>
                            <option value="sesion" selected="@(ViewBag.TipoFiltro == "sesion")">Inicios/cierre de sesión</option>
                            <option value="usuarios" selected="@(ViewBag.TipoFiltro == "usuarios")">Gestión de usuarios</option>
                            <option value="mantenimientos" selected="@(ViewBag.TipoFiltro == "mantenimientos")">Mantenimientos</option>
                            <option value="csv" selected="@(ViewBag.TipoFiltro == "csv")">Cargas CSV</option>
                            <option value="admin" selected="@(ViewBag.TipoFiltro == "admin")">Administradores</option>
                            <option value="tecnico" selected="@(ViewBag.TipoFiltro == "tecnico")">Técnicos</option>
                        </select>
                        <button type="submit" class="btn btn-outline-success me-2">
                            <i class="fas fa-filter"></i> Filtrar
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-refresh"></i> Limpiar
                        </a>
                    </form>
                </div>
            </div>

            <div class="table-responsive">
                <table id="tablaBitacora" class="table table-striped table-hover w-100 table-verde">
                    <thead>
                        <tr>
                            <th>Fecha y hora</th>
                            <th class="timestamp-oculto">Timestamp</th>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Descripción</th>
                            <th>Información adicional</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registro in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <small>@registro.FechaHora.ToString("dd/MM/yyyy")</small><br>
                                    <strong>@registro.FechaHora.ToString("HH:mm:ss")</strong>
                                </td>
                                <td class="timestamp-oculto">
                                    @registro.FechaHora.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <div class="fw-bold">@registro.Usuario</div>
                                    <small class="text-muted">@ObtenerTipoUsuario(registro.Usuario)</small>
                                </td>
                                <td>
                                    <span class="badge @GetBadgeAccionClass(registro.ClaveAccion)">
                                        @FormatearNombreAccion(registro.ClaveAccion)
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@registro.DescripcionAccion</div>
                                </td>
                                <td>
                                    @if (TieneInformacionAdicional(registro.DescripcionAccion))
                                    {
                                        <div class="small">
                                            @foreach (var detalle in ObtenerDetallesAdicionales(registro.DescripcionAccion))
                                            {
                                                <span class="badge bg-verde-claro text-verde-oscuro border border-verde me-1 mb-1">@detalle</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin información adicional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PIE DE PÁGINA -->
        <div class="card-footer text-muted d-flex justify-content-between" style="background-color: #f8f9fa;">
            <small>
                Generado el: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") |
                Usuario: @usuarioActual?.Nombre |
                Zona: @usuarioActual?.Zona
            </small>
            <small>Total: @ViewBag.TotalRegistros registros encontrados</small>
        </div>
    </div>
</div>

@functions {
    public string ObtenerTipoUsuario(string usuario)
    {
        if (usuario.Contains("TECNICO") || usuario.Contains("MEM03"))
            return "Técnico";

        if (usuario.Contains("ADMIN") || usuario.Contains("XD XD"))
            return "Administrador";

        return "Usuario";
    }

    public string FormatearNombreAccion(string claveAccion)
    {
        // Formato simple para hacer más legible la clave
        return claveAccion.Replace("_", " ");
    }

    public bool TieneInformacionAdicional(string descripcion)
    {
        // Solo verificar si tiene pipes (la información adicional ya viene formateada)
        return descripcion.Contains("|");
    }

    public List<string> ObtenerDetallesAdicionales(string descripcion)
    {
        var detalles = new List<string>();

        if (descripcion.Contains("|"))
        {
            var partes = descripcion.Split('|');
            foreach (var parte in partes)
            {
                var parteLimpia = parte.Trim();
                if (!string.IsNullOrEmpty(parteLimpia))
                {
                    detalles.Add(parteLimpia);
                }
            }
        }

        return detalles;
    }

    public string GetBadgeAccionClass(string claveAccion)
    {
        // Lógica simplificada basada en patrones
        if (claveAccion.Contains("SESION") || claveAccion.Contains("LOGOUT"))
            return "badge-sesion";

        if (claveAccion.Contains("USUARIO"))
            return "badge-usuario";

        if (claveAccion.Contains("CSV"))
            return "badge-configuracion";

        if (claveAccion.Contains("MTTO") || claveAccion.Contains("MANTENIMIENTO"))
            return "badge-mantenimiento";

        return "badge-sistema";
    }
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#tablaBitacora').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                order: [[1, 'desc']],
                columnDefs: [
                    {
                        target: 1,
                        visible: false,
                        searchable: false
                    }
                ],
                pageLength: 25,
                responsive: true,
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
                stateSave: false
            });
        });
    </script>
}