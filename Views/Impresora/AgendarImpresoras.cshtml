@{
    ViewData["Title"] = "Agendar Impresoras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="mb-0">Registro de mantenimiento de impresora</h1>
        </div>

        <div class="card-body">
            <!-- Sección de selección de ubicación - TODOS EN UNA MISMA FILA -->
            <div class="row mb-4">
                <!-- Zona (solo lectura) -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Zona:</label>
                        <input type="text" class="form-control" value="@ViewBag.ZonaUsuario" readonly>
                    </div>
                </div>

                <!-- Agencia (combobox) -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Agencia:</label>
                        <select id="selectAgencia" class="form-select">
                            <option value="">Seleccione una agencia</option>
                            @foreach (var agencia in ViewBag.Agencias)
                            {
                                <option value="@agencia.ClaveAgencia"
                                        data-division="@agencia.ClaveDivision"
                                        data-zona="@agencia.ClaveZona">
                                    @agencia.NombreAgencia
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Centro (combobox - dependiente de agencia) -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Centro:</label>
                        <select id="selectCentro" class="form-select" disabled>
                            <option value="">Seleccione primero una agencia</option>
                        </select>
                    </div>
                </div>

                <!-- Impresora (combobox - dependiente de centro) -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Impresora:</label>
                        <select id="selectImpresora" class="form-select" disabled>
                            <option value="">Seleccione primero un centro</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Línea divisoria -->
            <hr class="my-4">

            <!-- Sección de información del reporte - NUEVA DISPOSICIÓN -->
            <div class="row mb-4">
                <!-- Folio de atención -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Folio de atención:</label>
                        <input type="text"
                               id="folioAtencion"
                               class="form-control"
                               placeholder="Ingrese el folio de atención"
                               maxlength="20">
                    </div>
                </div>

                <!-- Fecha de reporte -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha de reporte:</label>
                        <input type="date"
                               id="fechaReporte"
                               class="form-control"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <!-- Problemática -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Problemática:</label>
                        <textarea id="problematica"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describa la problemática"
                                  maxlength="300"
                                  style="height: 17px;"></textarea>
                    </div>
                </div>
            </div>

            <!-- Sección de información del reportante - MANTIENE DISPOSICIÓN ORIGINAL -->
            <div class="row mb-4">
                <!-- RPE -->
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">RPE:</label>
                        <input type="text"
                               id="rpe"
                               class="form-control"
                               placeholder="Ingrese el RPE"
                               maxlength="5">
                        <small class="form-text text-muted">Ingrese el RPE del usuario que reporta</small>
                    </div>
                </div>

                <!-- Usuario que reporta -->
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Usuario:</label>
                        <input type="text"
                               id="usuarioReporta"
                               class="form-control"
                               placeholder="Ingrese el nombre del usuario"
                               maxlength="30">
                        <small class="form-text text-muted">Ingrese el nombre del usuario que reporta</small>
                    </div>
                </div>

                <!-- Correo -->
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Correo:</label>
                        <input type="email"
                               id="correo"
                               class="form-control"
                               placeholder="ejemplo@cfe.mx"
                               maxlength="20">
                        <small class="form-text text-muted">Ingrese el correo del usuario que reporta</small>
                    </div>
                </div>
            </div>

            <!-- Sección de soporte y observaciones - MANTIENE DISPOSICIÓN ORIGINAL -->
            <div class="row mb-4">
                <!-- Soporte documental -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Soporte documental:</label>
                        <input type="file"
                               id="soporteDocumental"
                               class="form-control"
                               accept=".pdf">
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Observaciones:</label>
                        <textarea id="observaciones"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ingrese observaciones adicionales"
                                  maxlength="300"
                                  style="height: 17px;"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button type="button" id="btnAgendar" class="btn btn-success btn-md me-2">
                <i class="bi bi-calendar-check me-2"></i> Agendar
            </button>
            <button type="button" id="btnCancelar" class="btn btn-danger btn-md">
                <i class="bi bi-x-circle me-2"></i> Cancelar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // 1. Manejo del cambio en Agencia
            $('#selectAgencia').change(function() {
                var selectedAgencia = $(this).find('option:selected');
                var division = selectedAgencia.data('division');
                var zona = selectedAgencia.data('zona');
                var agencia = selectedAgencia.val();

                if (agencia) {
                    // Mostrar loading
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Cargando centros...</option>');
                    $('#selectImpresora').prop('disabled', true)
                                        .html('<option value="">Seleccione un centro primero</option>');

                    $.get('/Impresora/ObtenerCentrosPorAgencia', {
                        division: division,
                        zona: zona,
                        agencia: agencia
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione un centro</option>';
                            $.each(response.data, function(index, centro) {
                                options += '<option value="' + centro.value + '">' + centro.text + '</option>';
                            });
                            $('#selectCentro').html(options).prop('disabled', false);
                        } else {
                            $('#selectCentro').html('<option value="">Error al cargar centros</option>');
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectCentro').html('<option value="">Error en la solicitud</option>');
                    });
                } else {
                    $('#selectCentro').prop('disabled', true)
                                     .html('<option value="">Seleccione primero una agencia</option>');
                    $('#selectImpresora').prop('disabled', true)
                                        .html('<option value="">Seleccione una agencia primero</option>');
                }
            });

            // 2. Manejo del cambio en Centro (para cargar impresoras)
            $('#selectCentro').change(function() {
                var selectedCentro = $(this).val();
                var selectedAgencia = $('#selectAgencia').find('option:selected');

                if (selectedCentro && selectedAgencia.val()) {
                    // Mostrar loading
                    $('#selectImpresora').prop('disabled', true)
                                        .html('<option value="">Cargando impresoras...</option>');

                    $.get('/Impresora/ObtenerImpresorasPorCentro', {
                        division: selectedAgencia.data('division'),
                        zona: selectedAgencia.data('zona'),
                        agencia: selectedAgencia.val(),
                        centro: selectedCentro
                    }, function(response) {
                        if (response.success) {
                            var options = '<option value="">Seleccione una impresora</option>';
                            $.each(response.data, function(index, impresora) {
                                options += '<option value="' + impresora.value + '">' + impresora.text + '</option>';
                            });
                            $('#selectImpresora').html(options).prop('disabled', false);
                        } else {
                            $('#selectImpresora').html('<option value="">Error al cargar impresoras</option>');
                            console.error(response.message);
                        }
                    }).fail(function() {
                        $('#selectImpresora').html('<option value="">Error en la solicitud</option>');
                    });
                } else {
                    $('#selectImpresora').prop('disabled', true)
                                        .html('<option value="">Seleccione un centro válido</option>');
                }
            });

            // 3. Configuración mínima del datepicker para fecha de reporte
            var today = new Date().toISOString().split('T')[0];
            $('#fechaReporte').attr('min', today);

            // 4. Botón Agendar
            $('#btnAgendar').click(function() {
                // Validar todos los campos
                if (!validarFormulario()) {
                    return;
                }

                // Confirmar con el usuario
                Swal.fire({
                    title: '¿Agendar mantenimiento?',
                    text: "¿Está seguro de que desea agendar este mantenimiento de impresora?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, agendar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        agendarMantenimiento();
                    }
                });
            });

            // 5. Botón Cancelar
            $('#btnCancelar').click(function() {
                Swal.fire({
                    title: '¿Limpiar formulario?',
                    text: "¿Está seguro de que desea limpiar todos los campos?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, limpiar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Limpiar el formulario
                        $('#selectAgencia').val('');
                        $('#selectCentro').prop('disabled', true)
                                         .html('<option value="">Seleccione primero una agencia</option>');
                        $('#selectImpresora').prop('disabled', true)
                                            .html('<option value="">Seleccione primero un centro</option>');
                        $('#folioAtencion').val('');
                        $('#problematica').val('');
                        $('#rpe').val('');
                        $('#usuarioReporta').val('');
                        $('#correo').val('');
                        $('#soporteDocumental').val('');
                        $('#observaciones').val('');
                        $('#fechaReporte').val('');

                        Swal.fire(
                            '¡Formulario limpiado!',
                            'Todos los campos han sido limpiados.',
                            'success'
                        );
                    }
                });
            });

            // 6. Validación en tiempo real para campos de texto
            $('#folioAtencion').on('input', function() {
                this.value = this.value.replace(/[^A-Za-z0-9]/g, '');
                if (this.value.length > 20) {
                    this.value = this.value.substring(0, 20);
                }
            });

            $('#rpe').on('input', function() {
                this.value = this.value.replace(/[^A-Za-z0-9]/g, '');
                if (this.value.length > 5) {
                    this.value = this.value.substring(0, 5);
                }
            });

            $('#usuarioReporta').on('input', function() {
                this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\s]/g, '');
                if (this.value.length > 30) {
                    this.value = this.value.substring(0, 30);
                }
            });

            $('#correo').on('input', function() {
                if (this.value.length > 20) {
                    this.value = this.value.substring(0, 20);
                }
            });

            $('#problematica, #observaciones').on('input', function() {
                if (this.value.length > 300) {
                    this.value = this.value.substring(0, 300);
                }
            });

            // 7. Validación de archivo PDF
            $('#soporteDocumental').change(function() {
                var file = this.files[0];
                if (file) {
                    // Validar extensión
                    var extension = file.name.split('.').pop().toLowerCase();
                    if (extension !== 'pdf') {
                        mostrarAlerta('Archivo no válido', 'Solo se permiten archivos PDF', 'error');
                        $(this).val('');
                        return;
                    }

                    // Validar tamaño (5MB)
                    var maxSize = 5 * 1024 * 1024; // 5MB en bytes
                    if (file.size > maxSize) {
                        mostrarAlerta('Archivo muy grande', 'El archivo no debe exceder los 5MB', 'error');
                        $(this).val('');
                        return;
                    }
                }
            });
        });

        function validarFormulario() {
            // Validar selección de impresora
            var impresora = $('#selectImpresora').val();
            if (!impresora) {
                mostrarAlerta('Campo requerido', 'Debe seleccionar una impresora', 'warning');
                $('#selectImpresora').focus();
                return false;
            }

            // Validar folio de atención
            var folioAtencion = $('#folioAtencion').val().trim();
            if (!folioAtencion) {
                mostrarAlerta('Campo requerido', 'El folio de atención es obligatorio', 'warning');
                $('#folioAtencion').focus();
                return false;
            }

            // Validar fecha de reporte
            var fechaReporte = $('#fechaReporte').val();
            if (!fechaReporte) {
                mostrarAlerta('Campo requerido', 'La fecha de reporte es obligatoria', 'warning');
                $('#fechaReporte').focus();
                return false;
            }

            // Validar problemática
            var problematica = $('#problematica').val().trim();
            if (!problematica) {
                mostrarAlerta('Campo requerido', 'La problemática es obligatoria', 'warning');
                $('#problematica').focus();
                return false;
            }

            // Validar RPE
            var rpe = $('#rpe').val().trim();
            if (!rpe) {
                mostrarAlerta('Campo requerido', 'El RPE es obligatorio', 'warning');
                $('#rpe').focus();
                return false;
            }

            // Validar usuario que reporta
            var usuarioReporta = $('#usuarioReporta').val().trim();
            if (!usuarioReporta) {
                mostrarAlerta('Campo requerido', 'El usuario que reporta es obligatorio', 'warning');
                $('#usuarioReporta').focus();
                return false;
            }

            // Validar correo
            var correo = $('#correo').val().trim();
            if (!correo) {
                mostrarAlerta('Campo requerido', 'El correo es obligatorio', 'warning');
                $('#correo').focus();
                return false;
            }

            // Validar formato de correo
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(correo)) {
                mostrarAlerta('Correo inválido', 'Por favor ingrese un correo electrónico válido', 'warning');
                $('#correo').focus();
                return false;
            }

            // Validar archivo PDF
            var archivoPdf = $('#soporteDocumental')[0].files[0];
            if (!archivoPdf) {
                mostrarAlerta('Archivo requerido', 'El soporte documental (PDF) es obligatorio', 'warning');
                $('#soporteDocumental').focus();
                return false;
            }

            // Validar observaciones
            var observaciones = $('#observaciones').val().trim();
            if (!observaciones) {
                mostrarAlerta('Campo requerido', 'Las observaciones son obligatorias', 'warning');
                $('#observaciones').focus();
                return false;
            }

            return true;
        }

        function agendarMantenimiento() {
            var formData = new FormData();
            
            // Obtener los datos del formulario
            formData.append('numActFijo', $('#selectImpresora').val());
            formData.append('folioAtencion', $('#folioAtencion').val().trim());
            formData.append('fechaReporte', $('#fechaReporte').val());
            formData.append('problematica', $('#problematica').val().trim());
            formData.append('rpe', $('#rpe').val().trim());
            formData.append('usuarioReporta', $('#usuarioReporta').val().trim());
            formData.append('correo', $('#correo').val().trim());
            formData.append('observaciones', $('#observaciones').val().trim());
            
            // Agregar archivo PDF
            var archivoPdf = $('#soporteDocumental')[0].files[0];
            if (archivoPdf) {
                formData.append('pdfQueja', archivoPdf);
            }

            // Mostrar loading en el botón
            $('#btnAgendar').prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Agendando...');

            $.ajax({
                url: '/Impresora/AgendarMantenimiento',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        mostrarAlertaExito('¡Éxito!', response.message);
                        // Limpiar formulario después de éxito
                        setTimeout(() => {
                            limpiarFormulario();
                            $('#btnAgendar').prop('disabled', false).html('<i class="bi bi-calendar-check me-2"></i> Agendar');
                        }, 2000);
                    } else {
                        mostrarAlerta('Error', response.message, 'error');
                        $('#btnAgendar').prop('disabled', false).html('<i class="bi bi-calendar-check me-2"></i> Agendar');
                    }
                },
                error: function(xhr) {
                    mostrarAlerta('Error', xhr.responseJSON?.message || 'Error al agendar el mantenimiento', 'error');
                    $('#btnAgendar').prop('disabled', false).html('<i class="bi bi-calendar-check me-2"></i> Agendar');
                }
            });
        }

        function limpiarFormulario() {
            $('#selectAgencia').val('');
            $('#selectCentro').prop('disabled', true).html('<option value="">Seleccione primero una agencia</option>');
            $('#selectImpresora').prop('disabled', true).html('<option value="">Seleccione primero un centro</option>');
            $('#folioAtencion').val('');
            $('#fechaReporte').val('');
            $('#problematica').val('');
            $('#rpe').val('');
            $('#usuarioReporta').val('');
            $('#correo').val('');
            $('#soporteDocumental').val('');
            $('#observaciones').val('');
        }

        function mostrarAlerta(titulo, mensaje, tipo) {
            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: tipo,
                confirmButtonText: 'Aceptar',
                customClass: { confirmButton: 'btn btn-primary' },
                buttonsStyling: false
            });
        }

        function mostrarAlertaExito(titulo, mensaje) {
            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: 'success',
                confirmButtonText: 'Aceptar',
                customClass: { confirmButton: 'btn btn-success' },
                buttonsStyling: false
            });
        }
    </script>
}