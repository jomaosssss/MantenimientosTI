@{
    ViewData["Title"] = "Agendar Impresoras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="mb-0">Registro de mantenimiento de impresora</h1>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Zona:</label>
                        <input type="text" class="form-control" value="@ViewBag.ZonaUsuario" readonly>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Agencia:</label>
                        <select id="selectAgencia" class="form-select">
                            <option value="">Seleccione una agencia</option>
                            @foreach (var agencia in ViewBag.Agencias)
                            {
                                <option value="@agencia.ClaveAgencia"
                                        data-division="@agencia.ClaveDivision"
                                        data-zona="@agencia.ClaveZona">
                                    @agencia.NombreAgencia
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Centro:</label>
                        <select id="selectCentro" class="form-select" disabled>
                            <option value="">Seleccione primero una agencia</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Impresora:</label>
                        <select id="selectImpresora" class="form-select" disabled>
                            <option value="">Seleccione primero un centro</option>
                        </select>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Folio de atención:</label>
                        <input type="text" id="folioAtencion" class="form-control" placeholder="Ingrese el folio de atención" maxlength="20">
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha de reporte:</label>
                        <input type="date" id="fechaReporte" class="form-control">
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Problemática:</label>
                        <textarea id="problematica" class="form-control" rows="3" placeholder="Describa la problemática" maxlength="300" style="height: 17px;"></textarea>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">RPE:</label>
                        <input type="text" id="rpe" class="form-control" placeholder="Ingrese el RPE" maxlength="5">
                        <small class="form-text text-muted">Ingrese el RPE del usuario que reporta</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Usuario:</label>
                        <input type="text" id="usuarioReporta" class="form-control" placeholder="Ingrese el nombre del usuario" maxlength="30">
                        <small class="form-text text-muted">Ingrese el nombre del usuario que reporta</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Correo:</label>
                        <input type="email" id="correo" class="form-control" placeholder="ejemplo@cfe.mx" maxlength="50">
                        <small class="form-text text-muted">Ingrese el correo del usuario que reporta</small>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Soporte documental:</label>
                        <input type="file" id="soporteDocumental" class="form-control" accept=".pdf">
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Observaciones:</label>
                        <textarea id="observaciones" class="form-control" rows="3" placeholder="Ingrese observaciones adicionales" maxlength="300" style="height: 17px;"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button type="button" id="btnAgendar" class="btn btn-success btn-md me-2">
                <i class="bi bi-calendar-check me-2"></i> Agendar
            </button>
            <button type="button" id="btnCancelar" class="btn btn-danger btn-md">
                <i class="bi bi-x-circle me-2"></i> Cancelar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript">
        (function() {
            var datosImpresora = { numActFijo: '' };

            jQuery(document).ready(function($) {
                // Configurar fecha mínima
                var hoy = new Date();
                var mes = hoy.getMonth() + 1;
                var dia = hoy.getDate();
                var fechaMin = hoy.getFullYear() + '-' + (mes < 10 ? '0' : '') + mes + '-' + (dia < 10 ? '0' : '') + dia;
                document.getElementById('fechaReporte').setAttribute('min', fechaMin);

                $('#selectAgencia').change(function() {
                    var selectedAgencia = $(this).find('option:selected');
                    var division = selectedAgencia.data('division');
                    var zona = selectedAgencia.data('zona');
                    var agencia = selectedAgencia.val();

                    if (agencia) {
                        $('#selectCentro').prop('disabled', true).html('<option value="">Cargando centros...</option>');
                        $('#selectImpresora').prop('disabled', true).html('<option value="">Seleccione un centro primero</option>');

                        $.get('/Impresora/ObtenerCentrosPorAgencia', { division: division, zona: zona, agencia: agencia }, function(response) {
                            if (response.success) {
                                var options = '<option value="">Seleccione un centro</option>';
                                $.each(response.data, function(index, centro) {
                                    options += '<option value="' + centro.value + '">' + centro.text + '</option>';
                                });
                                $('#selectCentro').html(options).prop('disabled', false);
                            } else {
                                $('#selectCentro').html('<option value="">Error al cargar centros</option>');
                            }
                        }).fail(function() {
                            $('#selectCentro').html('<option value="">Error en la solicitud</option>');
                        });
                    } else {
                        $('#selectCentro').prop('disabled', true).html('<option value="">Seleccione primero una agencia</option>');
                        $('#selectImpresora').prop('disabled', true).html('<option value="">Seleccione una agencia primero</option>');
                    }
                });

                $('#selectCentro').change(function() {
                    var selectedCentro = $(this).val();
                    var selectedAgencia = $('#selectAgencia').find('option:selected');

                    if (selectedCentro && selectedAgencia.val()) {
                        $('#selectImpresora').prop('disabled', true).html('<option value="">Cargando impresoras...</option>');

                        $.get('/Impresora/ObtenerImpresorasPorCentro', {
                            division: selectedAgencia.data('division'),
                            zona: selectedAgencia.data('zona'),
                            agencia: selectedAgencia.val(),
                            centro: selectedCentro
                        }, function(response) {
                            if (response.success) {
                                var options = '<option value="">Seleccione una impresora</option>';
                                $.each(response.data, function(index, impresora) {
                                    options += '<option value="' + impresora.value + '">' + impresora.text + '</option>';
                                });
                                $('#selectImpresora').html(options).prop('disabled', false);
                            } else {
                                $('#selectImpresora').html('<option value="">Error al cargar impresoras</option>');
                            }
                        }).fail(function() {
                            $('#selectImpresora').html('<option value="">Error en la solicitud</option>');
                        });
                    } else {
                        $('#selectImpresora').prop('disabled', true).html('<option value="">Seleccione un centro válido</option>');
                    }
                });

                $('#selectImpresora').change(function() {
                    datosImpresora.numActFijo = $(this).val() || '';
                });

                $('#btnAgendar').click(function() {
                    if (!datosImpresora.numActFijo) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'Debe seleccionar una impresora', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#folioAtencion').val().trim()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'El folio de atención es requerido', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#fechaReporte').val()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'La fecha de reporte es requerida', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#problematica').val().trim()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'La problemática es requerida', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#rpe').val().trim()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'El RPE es requerido', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#usuarioReporta').val().trim()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'El usuario que reporta es requerido', confirmButtonText: 'Entendido' });
                        return;
                    }
                    if (!$('#correo').val().trim()) {
                        Swal.fire({ icon: 'warning', title: 'Campos incompletos', text: 'El correo es requerido', confirmButtonText: 'Entendido' });
                        return;
                    }

                            var correoValue = $('#correo').val();
                            var posArroba = correoValue.indexOf(String.fromCharCode(64));
                            var posPunto = correoValue.lastIndexOf('.');
                            var tieneArroba = posArroba > 0;
                            var tienePunto = posPunto > posArroba + 1 && posPunto < correoValue.length - 1;

                            if (!tieneArroba || !tienePunto) {
                                Swal.fire({ icon: 'warning', title: 'Correo inválido', text: 'Por favor ingrese un correo electrónico válido', confirmButtonText: 'Entendido' });
                                return;
                            }

                    var formData = new FormData();
                    formData.append('NumActFijo', datosImpresora.numActFijo);
                    formData.append('FolioAtencion', $('#folioAtencion').val());
                    formData.append('FechaReporte', $('#fechaReporte').val());
                    formData.append('Problematica', $('#problematica').val());
                    formData.append('Rpe', $('#rpe').val());
                    formData.append('UsuarioReporta', $('#usuarioReporta').val());
                    formData.append('Correo', $('#correo').val());
                    formData.append('Observaciones', $('#observaciones').val() || '');

                    var fileInput = $('#soporteDocumental')[0];
                    if (fileInput.files.length > 0) {
                        formData.append('SoporteDocumental', fileInput.files[0]);
                    }

                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Por favor espere mientras se guarda la información',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        didOpen: function() { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '/Impresora/AgendarMantenimiento',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Éxito!',
                                    text: response.message,
                                    confirmButtonText: 'Aceptar'
                                }).then(function(result) {
                                    if (result.isConfirmed) { limpiarFormulario(); }
                                });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: response.message || 'Ocurrió un error al guardar los datos', confirmButtonText: 'Entendido' });
                            }
                        },
                        error: function() {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error en la comunicación con el servidor', confirmButtonText: 'Entendido' });
                        }
                    });
                });

                $('#btnCancelar').click(function() {
                    Swal.fire({
                        title: '¿Limpiar formulario?',
                        text: "¿Está seguro de que desea limpiar todos los campos?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sí, limpiar',
                        cancelButtonText: 'Cancelar'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            limpiarFormulario();
                            Swal.fire('¡Formulario limpiado!', 'Todos los campos han sido limpiados.', 'success');
                        }
                    });
                });

                function limpiarFormulario() {
                    $('#selectAgencia').val('');
                    $('#selectCentro').prop('disabled', true).html('<option value="">Seleccione primero una agencia</option>');
                    $('#selectImpresora').prop('disabled', true).html('<option value="">Seleccione primero un centro</option>');
                    $('#folioAtencion, #problematica, #rpe, #usuarioReporta, #correo, #soporteDocumental, #observaciones, #fechaReporte').val('');
                    datosImpresora.numActFijo = '';
                }

                $('#folioAtencion').on('input', function() {
                    var val = this.value;
                    var clean = '';
                    for (var i = 0; i < val.length && i < 20; i++) {
                        var c = val.charAt(i);
                        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) clean += c;
                    }
                    this.value = clean;
                });

                $('#rpe').on('input', function() {
                    var val = this.value;
                    var clean = '';
                    for (var i = 0; i < val.length && i < 5; i++) {
                        var c = val.charAt(i);
                        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) clean += c;
                    }
                    this.value = clean;
                });

                $('#usuarioReporta').on('input', function() {
                    var val = this.value;
                    var clean = '';
                    var allowed = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzÁÉÍÓÚáéíóúÑñ ';
                    for (var i = 0; i < val.length && i < 30; i++) {
                        if (allowed.indexOf(val.charAt(i)) !== -1) clean += val.charAt(i);
                    }
                    this.value = clean;
                });

                $('#correo').on('input', function() {
                    if (this.value.length > 50) this.value = this.value.substring(0, 50);
                });

                $('#problematica, #observaciones').on('input', function() {
                    if (this.value.length > 300) this.value = this.value.substring(0, 300);
                });

                $('#soporteDocumental').change(function() {
                    var file = this.files[0];
                    if (file) {
                        var ext = file.name.split('.').pop().toLowerCase();
                        if (ext !== 'pdf') {
                            Swal.fire({ icon: 'error', title: 'Archivo no válido', text: 'Solo se permiten archivos PDF', confirmButtonText: 'Entendido' });
                            $(this).val('');
                            return;
                        }
                        if (file.size > 5242880) {
                            Swal.fire({ icon: 'error', title: 'Archivo muy grande', text: 'El archivo no debe exceder los 5MB', confirmButtonText: 'Entendido' });
                            $(this).val('');
                        }
                    }
                });
            });
        })();
    </script>
}
