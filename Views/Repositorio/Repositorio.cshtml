@{
    ViewData["Title"] = "Repositorio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Estilos para tablas responsivas sin cambiar el diseño */
    .table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .dataTables_wrapper {
        width: 100%;
        min-width: 1200px; /* Ancho mínimo para mantener el diseño */
    }

    /* Para pantallas pequeñas - scroll horizontal suave */
    @@media (max-width: 1400px) {
        .table-container {
            border: 1px solid #dee2e6;
            border-radius: 8px;
        }
    }

    /* Para pantallas muy pequeñas */
    @@media (max-width: 768px) {
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 10px;
        }

        .btn-sm {
            padding: 0.2rem 0.4rem;
            font-size: 0.75rem;
        }
    }
</style>

<div class="container mt-5">
    <div class="card mt-4 shadow-sm rounded">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h1 class="mb-0">Historial de mantenimientos</h1>
            </div>
            <div class="card-body">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        CFEmáticos
                    </div>
                    <div class="card-body p-0">
                        <!-- Cambiado a p-0 -->
                        <div class="table-container p-3">
                            <!-- Contenedor con scroll -->
                            <table id="tablaCFEmaticos" class="display" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Núm. de cajero</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        Atención a clientes
                    </div>
                    <div class="card-body p-0">
                        <div class="table-container p-3">
                            <table id="tablaAtencionClientes" class="display" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Tipo de equipo</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        Equipos de cómputo
                    </div>
                    <div class="card-body p-0">
                        <div class="table-container p-3">
                            <table id="tablaEquiposComputo" class="display" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Tipo de equipo</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para visualizar imágenes -->
<div class="modal fade" id="imagenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagenModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imagenModalContent" src="" class="img-fluid" alt="Imagen de mantenimiento">
            </div>
        </div>
    </div>
</div>

<!-- Modal para información del equipo -->
<div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="modalInfoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded">
            <div class="modal-header">
                <h5 class="modal-title" id="modalInfoLabel">Información del Mantenimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalInfoBody">
                <!-- Contenido dinámico se cargará aquí -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            // Configuración común para DataTables - SOLO SCROLL HORIZONTAL
            const dataTablesOptions = {
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                scrollX: true,    // ✅ SOLO SCROLL HORIZONTAL
                scrollCollapse: true,
                paging: true,
                pageLength: 10,
                order: [[5, 'desc']],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            };

            // Tabla CFEmáticos
            const tablaCFEmaticos = $('#tablaCFEmaticos').DataTable({
                ...dataTablesOptions,
                columns: [
                    { data: 'numOrden' },
                    { data: 'zona' },
                    { data: 'agencia' },
                    { data: 'centro' },
                    { data: 'numCajero' },
                    { data: 'fechaProgramada' },
                    { data: 'fechaAtencion' },
                    { data: 'fechaTerminada' },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'evidenciaHojaServicio',
                        render: function(data, type, row) {
                            return data ?
                                '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                'No disponible';
                        },
                        orderable: false
                    },
                    {
                        data: 'numOrden',
                        render: function(data, type, row) {
                            return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                        },
                        orderable: false
                    }
                ],
                ajax: {
                    url: '/Repositorio/ObtenerMantenimientos',
                    dataSrc: 'cfematicos'
                }
            });

            // Tabla Atención a Clientes
            const tablaAtencionClientes = $('#tablaAtencionClientes').DataTable({
                ...dataTablesOptions,
                columns: [
                    { data: 'numOrden' },
                    { data: 'zona' },
                    { data: 'agencia' },
                    { data: 'centro' },
                    { data: 'tipoEquipo' },
                    { data: 'fechaProgramada' },
                    { data: 'fechaAtencion' },
                    { data: 'fechaTerminada' },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'evidenciaHojaServicio',
                        render: function(data, type, row) {
                            return data ?
                                '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                'No disponible';
                        },
                        orderable: false
                    },
                    {
                        data: 'numOrden',
                        render: function(data, type, row) {
                            return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                        },
                        orderable: false
                    }
                ],
                ajax: {
                    url: '/Repositorio/ObtenerMantenimientos',
                    dataSrc: 'atencionClientes'
                }
            });

            // Tabla Equipos de Cómputo
            const tablaEquiposComputo = $('#tablaEquiposComputo').DataTable({
                ...dataTablesOptions,
                columns: [
                    { data: 'numOrden' },
                    { data: 'zona' },
                    { data: 'agencia' },
                    { data: 'centro' },
                    { data: 'tipoEquipo' },
                    { data: 'fechaProgramada' },
                    { data: 'fechaAtencion' },
                    { data: 'fechaTerminada' },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'tieneFotos',
                        render: function(data, type, row) {
                            return data ?
                                '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                'N/A';
                        },
                        orderable: false
                    },
                    {
                        data: 'evidenciaHojaServicio',
                        render: function(data, type, row) {
                            return data ?
                                '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                'No disponible';
                        },
                        orderable: false
                    },
                    {
                        data: 'numOrden',
                        render: function(data, type, row) {
                            return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                        },
                        orderable: false
                    }
                ],
                ajax: {
                    url: '/Repositorio/ObtenerMantenimientos',
                    dataSrc: 'equiposComputo'
                }
            });

            // Manejar clic en botones de imágenes
            $(document).on('click', '.ver-imagen', function() {
                var numOrden = $(this).data('num-orden');
                var tipo = $(this).data('tipo');
                var titulo = '';

                switch(tipo) {
                    case 'antes': titulo = 'Foto Antes - Orden #' + numOrden; break;
                    case 'durante': titulo = 'Foto Durante - Orden #' + numOrden; break;
                    case 'despues': titulo = 'Foto Después - Orden #' + numOrden; break;
                }

                $('#imagenModalLabel').text(titulo);

                // Añadir timestamp para evitar caché
                var url = '/Repositorio/ObtenerImagen?numOrden=' + numOrden +
                          '&tipo=' + tipo +
                          '&t=' + new Date().getTime();

                $('#imagenModalContent').attr('src', url);
                $('#imagenModal').modal('show');
            });

            // Manejar clic en botones "Ver Equipo"
            $(document).on('click', '.ver-equipo', function() {
                var numOrden = $(this).data('num-orden');

                $.get('/Repositorio/ObtenerDetallesEquipo', { numOrden: numOrden }, function(data) {
                    $('#modalInfoBody').html(data);
                    $('#modalInfo').modal('show');
                }).fail(function() {
                    alert('Error al cargar los detalles del equipo');
                });
            });
        });
    </script>
}