@{
    ViewData["Title"] = "Repositorio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Estilos responsive para las tablas */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Para pantallas muy pequeñas */
    @@media (max-width: 576px) {
        .table-responsive table {
            min-width: 1200px;
        }

        .container {
            padding-left: 10px;
            padding-right: 10px;
        }
    }

    /* Mejoras generales para tablas */
    .table th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    /* Ajustes para botones en móviles */
    @@media (max-width: 768px) {
        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.775rem;
        }
    }

    /* Estilos para las tarjetas de conteo */
    .stats-card {
        border-radius: 12px;
        min-height: 100px;
        border: none;
        transition: all 0.3s ease;
        flex: 1;
        min-width: 0;
    }

    .stats-card-content {
        padding: 0.9rem;
    }

    .stats-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
        font-weight: 600;
    }

    .stats-number {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .stats-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .cards-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Colores tarjetas */
    .card-orange {
        background-color: #fd7e14;
    }

    .card-blue {
        background-color: #0d6efd;
    }

    .card-green {
        background-color: #28a745;
    }

    .text-orange {
        color: #fd7e14 !important;
    }

    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    }

    .card-orange:hover {
        box-shadow: 0 6px 15px rgba(253, 126, 20, 0.25) !important;
    }

    .card-blue:hover {
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.25) !important;
    }

    .card-green:hover {
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.25) !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .cards-container

    {
        gap: 8px;
    }

    .stats-card {
        min-height: 90px;
        flex: 1 1 calc(50% - 8px);
    }

    .stats-number {
        font-size: 1.5rem;
    }

    .stats-icon {
        width: 38px;
        height: 38px;
        font-size: 1.1rem;
    }

    .stats-badge {
        font-size: 0.7rem;
    }

    }

    @@media (max-width: 576px) {
        .stats-card-content

    {
        padding: 0.7rem;
    }

    .stats-number {
        font-size: 1.4rem;
    }

    .stats-card {
        flex: 1 1 100%;
        min-height: 85px;
    }

    .cards-container {
        gap: 6px;
    }

    .stats-badge {
        font-size: 0.68rem;
    }

    }
</style>

<div class="container mt-5">
    <div class="card mt-4 shadow-sm rounded">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h1 class="mb-0">Historial de mantenimientos</h1>
            </div>
            <div class="card-body">
                <!-- Selector de fecha y cuadro de busqueda -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-calendar-alt"></i>
                            </span>
                            <select id="filtroMes" class="form-select">
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                            <select id="filtroAnio" class="form-select" style="max-width: 120px;">
                                <!-- Se llenará dinámicamente con JavaScript -->
                            </select>
                            <button id="btnFiltrar" class="btn btn-success">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" id="buscadorGeneral" class="form-control" placeholder="Buscar en todas las tablas...">
                        </div>
                    </div>
                </div>

                <!-- TARJETAS DE CONTEO -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card stats-card card-green">
                            <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="flex-grow-1">
                                        <span class="badge stats-badge bg-white text-success mb-1">CFEMÁTICOS</span>
                                        <h2 class="stats-number text-white" id="totalCfematicos">0</h2>
                                    </div>
                                    <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                        <i class="fas fa-laptop text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stats-card card-blue">
                            <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="flex-grow-1">
                                        <span class="badge stats-badge bg-white text-primary mb-1">ATENCIÓN A CLIENTES</span>
                                        <h2 class="stats-number text-white" id="totalAtencionClientes">0</h2>
                                    </div>
                                    <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                        <i class="fas fa-headset text-primary"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stats-card card-orange">
                            <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="flex-grow-1">
                                        <span class="badge stats-badge bg-white text-orange mb-1">EQUIPOS DE CÓMPUTO</span>
                                        <h2 class="stats-number text-white" id="totalEquiposComputo">0</h2>
                                    </div>
                                    <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                        <i class="fas fa-desktop text-orange"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de cfematicos -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        CFEmáticos
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tablaCFEmaticos" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Núm. de cajero</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tabla de equipos de atencion a clientes -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        Atención a clientes
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tablaAtencionClientes" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Tipo de equipo</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tablas de equipos de computo -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-table me-1"></i>
                        Equipos de cómputo
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tablaEquiposComputo" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>N° Orden</th>
                                        <th>Zona</th>
                                        <th>Agencia</th>
                                        <th>Centro</th>
                                        <th>Tipo de equipo</th>
                                        <th>Fecha programada</th>
                                        <th>Fecha de atención</th>
                                        <th>Fecha terminada</th>
                                        <th>Foto antes</th>
                                        <th>Foto durante</th>
                                        <th>Foto despues</th>
                                        <th>Hoja de servicio</th>
                                        <th>Ver equipo</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para visualizar imágenes -->
<div class="modal fade" id="imagenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagenModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imagenModalContent" src="" class="img-fluid" alt="Imagen de mantenimiento">
            </div>
        </div>
    </div>
</div>

<!-- Modal para información del equipo -->
<div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="modalInfoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded">
            <div class="modal-header">
                <h5 class="modal-title" id="modalInfoLabel">Información del Mantenimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalInfoBody">
                <!-- Contenido dinámico se cargará aquí -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            // Variables globales para las tablas
            let tablaCFEmaticos, tablaAtencionClientes, tablaEquiposComputo;

            // Inicializar filtros
            inicializarFiltros();

            // Función para obtener parámetros de filtro
            function obtenerParametrosFiltro() {
                return {
                    mes: $('#filtroMes').val(),
                    anio: $('#filtroAnio').val()
                };
            }

            // Función para actualizar los contadores
            function actualizarContadores() {
                const totalCfematicos = tablaCFEmaticos ? tablaCFEmaticos.rows().count() : 0;
                const totalAtencionClientes = tablaAtencionClientes ? tablaAtencionClientes.rows().count() : 0;
                const totalEquiposComputo = tablaEquiposComputo ? tablaEquiposComputo.rows().count() : 0;

                $('#totalCfematicos').text(totalCfematicos);
                $('#totalAtencionClientes').text(totalAtencionClientes);
                $('#totalEquiposComputo').text(totalEquiposComputo);
            }

            // CONFIGURACIÓN COMÚN MEJORADA PARA DATATABLES
            const dataTablesOptions = {
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                responsive: true,
                autoWidth: false,
                scrollX: true,
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[5, 'desc']],
                processing: false, // Desactivar animación de procesamiento
                serverSide: false,
                ajax: {
                    url: '/Repositorio/ObtenerMantenimientos',
                    type: 'GET',
                    data: obtenerParametrosFiltro
                },
                drawCallback: function(settings) {
                    // Actualizar contadores cada vez que se dibuja la tabla
                    actualizarContadores();
                },
                initComplete: function(settings, json) {
                    // Actualizar contadores cuando se inicializa la tabla
                    actualizarContadores();
                }
            };

            // Inicializar tablas
            inicializarTablas();

            function inicializarTablas() {
                // Tabla CFEmáticos
                tablaCFEmaticos = $('#tablaCFEmaticos').DataTable({
                    ...dataTablesOptions,
                    columns: [
                        { data: 'numOrden' },
                        { data: 'zona' },
                        { data: 'agencia' },
                        { data: 'centro' },
                        { data: 'numCajero' },
                        { data: 'fechaProgramada' },
                        { data: 'fechaAtencion' },
                        { data: 'fechaTerminada' },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'evidenciaHojaServicio',
                            render: function(data, type, row) {
                                return data ?
                                    '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                    'No disponible';
                            },
                            orderable: false
                        },
                        {
                            data: 'numOrden',
                            render: function(data, type, row) {
                                return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                            },
                            orderable: false
                        }
                    ],
                    ajax: {
                        ...dataTablesOptions.ajax,
                        dataSrc: 'cfematicos'
                    }
                });

                // Tabla Atención a Clientes
                tablaAtencionClientes = $('#tablaAtencionClientes').DataTable({
                    ...dataTablesOptions,
                    columns: [
                        { data: 'numOrden' },
                        { data: 'zona' },
                        { data: 'agencia' },
                        { data: 'centro' },
                        { data: 'tipoEquipo' },
                        { data: 'fechaProgramada' },
                        { data: 'fechaAtencion' },
                        { data: 'fechaTerminada' },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'evidenciaHojaServicio',
                            render: function(data, type, row) {
                                return data ?
                                    '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                    'No disponible';
                            },
                            orderable: false
                        },
                        {
                            data: 'numOrden',
                            render: function(data, type, row) {
                                return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                            },
                            orderable: false
                        }
                    ],
                    ajax: {
                        ...dataTablesOptions.ajax,
                        dataSrc: 'atencionClientes'
                    }
                });

                // Tabla Equipos de Cómputo
                tablaEquiposComputo = $('#tablaEquiposComputo').DataTable({
                    ...dataTablesOptions,
                    columns: [
                        { data: 'numOrden' },
                        { data: 'zona' },
                        { data: 'agencia' },
                        { data: 'centro' },
                        { data: 'tipoEquipo' },
                        { data: 'fechaProgramada' },
                        { data: 'fechaAtencion' },
                        { data: 'fechaTerminada' },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="antes">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="durante">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'tieneFotos',
                            render: function(data, type, row) {
                                return data ?
                                    '<button class="btn btn-sm btn-outline-primary ver-imagen" data-num-orden="' + row.numOrden + '" data-tipo="despues">Ver</button>' :
                                    'N/A';
                            },
                            orderable: false
                        },
                        {
                            data: 'evidenciaHojaServicio',
                            render: function(data, type, row) {
                                return data ?
                                    '<a href="/Repositorio/DescargarHojaServicio?numOrden=' + row.numOrden + '" class="btn btn-sm btn-outline-success" target="_blank">Descargar</a>' :
                                    'No disponible';
                            },
                            orderable: false
                        },
                        {
                            data: 'numOrden',
                            render: function(data, type, row) {
                                return '<button class="btn btn-sm btn-outline-dark ver-equipo" data-num-orden="' + data + '"><i class="bi bi-eye"></i></button>';
                            },
                            orderable: false
                        }
                    ],
                    ajax: {
                        ...dataTablesOptions.ajax,
                        dataSrc: 'equiposComputo'
                    }
                });
            }

            // Función para inicializar filtros
            function inicializarFiltros() {
                const fechaActual = new Date();
                const mesActual = fechaActual.getMonth() + 1;
                const anioActual = fechaActual.getFullYear();

                // Establecer mes actual
                $('#filtroMes').val(mesActual);

                // Llenar combobox de años (últimos 5 años)
                const selectAnio = $('#filtroAnio');
                selectAnio.empty();
                for (let i = anioActual; i >= anioActual - 5; i--) {
                    selectAnio.append(new Option(i, i));
                }
                selectAnio.val(anioActual);
            }

            // Función para mostrar/ocultar animación del botón
            function toggleBotonFiltrar(mostrarLoading) {
                const $btn = $('#btnFiltrar');
                const $icono = $btn.find('i');

                if (mostrarLoading) {
                    // Cambiar a estado de carga
                    $btn.prop('disabled', true);
                    $icono.removeClass('fa-search').addClass('fa-spinner fa-spin');
                    $btn.html('<i class="fas fa-spinner fa-spin"></i> Buscando...');
                } else {
                    // Restaurar estado normal
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-search"></i> Filtrar');
                }
            }

            // Función para recargar todas las tablas
            function recargarTablas() {
                console.log('Recargando tablas con mes:', $('#filtroMes').val(), 'año:', $('#filtroAnio').val());

                // Resetear buscador general
                $('#buscadorGeneral').val('');

                // Mostrar animación de carga
                toggleBotonFiltrar(true);

                // Contador para saber cuándo todas las tablas han terminado de cargar
                let tablasCargadas = 0;
                const totalTablas = 3;

                function verificarCargaCompleta() {
                    tablasCargadas++;
                    if (tablasCargadas === totalTablas) {
                        // Todas las tablas han terminado de cargar
                        setTimeout(() => {
                            toggleBotonFiltrar(false);
                            // Actualizar contadores después de que todas las tablas se recarguen
                            actualizarContadores();
                        }, 500); // Delay para mejor experiencia visual
                    }
                }

                // Recargar cada tabla y contar cuando terminen
                if (tablaCFEmaticos) {
                    tablaCFEmaticos.ajax.reload(() => {
                        verificarCargaCompleta();
                    }, false); // false para mantener la página actual
                } else {
                    verificarCargaCompleta();
                }

                if (tablaAtencionClientes) {
                    tablaAtencionClientes.ajax.reload(() => {
                        verificarCargaCompleta();
                    }, false);
                } else {
                    verificarCargaCompleta();
                }

                if (tablaEquiposComputo) {
                    tablaEquiposComputo.ajax.reload(() => {
                        verificarCargaCompleta();
                    }, false);
                } else {
                    verificarCargaCompleta();
                }
            }

            // Función para buscar en todas las tablas
            function buscarEnTodasLasTablas(termino) {
                if (tablaCFEmaticos) {
                    tablaCFEmaticos.search(termino).draw();
                }
                if (tablaAtencionClientes) {
                    tablaAtencionClientes.search(termino).draw();
                }
                if (tablaEquiposComputo) {
                    tablaEquiposComputo.search(termino).draw();
                }

                // Actualizar contadores después de la búsqueda
                setTimeout(actualizarContadores, 100);
            }

            // Buscador general con debounce para mejor performance
            let timeoutBusqueda;
            $('#buscadorGeneral').on('input', function() {
                const termino = $(this).val();

                // Limpiar timeout anterior
                clearTimeout(timeoutBusqueda);

                // Esperar 300ms después de que el usuario deje de escribir
                timeoutBusqueda = setTimeout(() => {
                    buscarEnTodasLasTablas(termino);
                }, 300);
            });

            // También buscar al pegar texto
            $('#buscadorGeneral').on('paste', function() {
                const termino = $(this).val();
                buscarEnTodasLasTablas(termino);
            });

            // SOLO filtrar al hacer clic en el botón
            $('#btnFiltrar').click(function() {
                recargarTablas();
            });

            // Manejar clic en botones de imágenes
            $(document).on('click', '.ver-imagen', function() {
                var numOrden = $(this).data('num-orden');
                var tipo = $(this).data('tipo');
                var titulo = '';

                switch(tipo) {
                    case 'antes': titulo = 'Foto Antes - Orden #' + numOrden; break;
                    case 'durante': titulo = 'Foto Durante - Orden #' + numOrden; break;
                    case 'despues': titulo = 'Foto Después - Orden #' + numOrden; break;
                }

                $('#imagenModalLabel').text(titulo);

                // Añadir timestamp para evitar caché
                var url = '/Repositorio/ObtenerImagen?numOrden=' + numOrden +
                          '&tipo=' + tipo +
                          '&t=' + new Date().getTime();

                $('#imagenModalContent').attr('src', url);
                $('#imagenModal').modal('show');
            });

            // Manejar clic en botones "Ver Equipo"
            $(document).on('click', '.ver-equipo', function() {
                var numOrden = $(this).data('num-orden');

                $.get('/Repositorio/ObtenerDetallesEquipo', { numOrden: numOrden }, function(data) {
                    $('#modalInfoBody').html(data);
                    $('#modalInfo').modal('show');
                }).fail(function() {
                    alert('Error al cargar los detalles del equipo');
                });
            });

            // Inicializar contadores al cargar la página
            actualizarContadores();
        });
    </script>
}