@{
    ViewData["Title"] = "Terminar Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="mb-0">Terminar mantenimiento</h1>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Buscar por número de orden:</label>
                        <div class="input-group">
                            <input type="text" id="numeroOrden" class="form-control" placeholder="Ingrese el número de orden">
                            <button class="btn btn-success" type="button" id="btnBuscarOrden">
                                <i class="bi bi-search me-2"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="form-body" style="display: none;">

                <div id="resultadoBusqueda" class="mt-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Información del mantenimiento</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4"><p><strong>Número de orden:</strong> <span id="infoNumOrden">-</span></p></div>
                                <div class="col-md-4"><p><strong>Tipo de mantenimiento:</strong> <span id="infoTipoMantenimiento">-</span></p></div>
                                <div class="col-md-4"><p><strong>Zona:</strong> <span id="infoZona">-</span></p></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4"><p><strong>Número de activo fijo:</strong> <span id="infoNumActFijo">-</span></p></div>
                                <div class="col-md-4"><p><strong>Fecha programada:</strong> <span id="infoFechaProgramada">-</span></p></div>
                                <div class="col-md-4"><p><strong>Agencia:</strong> <span id="infoAgencia">-</span></p></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4"><p><strong>Tipo de equipo:</strong> <span id="infoTipoEquipo">-</span></p></div>
                                <div class="col-md-4"><p><strong>Estatus:</strong> <span id="infoEstatus">-</span></p></div>
                                <div class="col-md-4"><p><strong>Centro:</strong> <span id="infoCentro">-</span></p></div>
                            </div>
                            <div class="row mt-2" id="filaNumCajero" style="display: none;">
                                <div class="col-md-4"><p><strong>Número de cajero:</strong> <span id="infoNumCajero">-</span></p></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0">Problemas:</label>
                                <span class="char-counter" id="contador-problemas">300 caracteres restantes</span>
                            </div>
                            <textarea id="problemas" class="form-control" rows="3" placeholder="Describa los problemas encontrados"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0">Diagnóstico:</label>
                                <span class="char-counter" id="contador-diagnostico">300 caracteres restantes</span>
                            </div>
                            <textarea id="diagnostico" class="form-control" rows="3" placeholder="Describa el diagnóstico técnico"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0">Observaciones:</label>
                                <span class="char-counter" id="contador-observaciones">300 caracteres restantes</span>
                            </div>
                            <textarea id="observaciones" class="form-control" rows="3" placeholder="Agregue cualquier observación adicional"></textarea>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto antes del mantenimiento:</label>
                            <div class="input-group">
                                <input type="file" id="fotoAntes" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoAntes"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto durante el mantenimiento:</label>
                            <div class="input-group">
                                <input type="file" id="fotoDurante" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoDurante"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto después del mantenimiento:</label>
                            <div class="input-group">
                                <input type="file" id="fotoDespues" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoDespues"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Hoja de servicio (PDF):</label>
                            <div class="input-group">
                                <input type="file" id="archivoPdf" class="form-control" accept=".pdf">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarPdf"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                            <small class="form-text text-muted">Tamaño máximo: 5MB</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Fecha de atención:</label>
                            <input type="date" id="fechaAtencion" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="footer-form" class="card-footer text-end" style="display: none;">
            <button type="button" id="btnTerminar" class="btn btn-success">
                <i class="bi bi-check-circle me-2"></i> Terminar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .char-counter {
            font-size: 0.8rem;
            color: #6c757d;
        }

            .char-counter.warning {
                color: #ffc107;
            }

            .char-counter.danger {
                color: #dc3545;
                font-weight: bold;
            }

        .textarea-limit {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        }
    </style>
    <script>
        $(document).ready(function() {
            inicializarContadoresCaracteres();

            // Eventos de búsqueda
            $('#btnBuscarOrden').click(buscarMantenimiento);
            $('#numeroOrden').keypress(function(e) {
                if (e.which === 13) buscarMantenimiento();
            });

            // Limpiar campos
            $('#btnLimpiarPdf').click(() => $('#archivoPdf').val(''));
            $('#btnLimpiarFotoAntes').click(() => $('#fotoAntes').val(''));
            $('#btnLimpiarFotoDurante').click(() => $('#fotoDurante').val(''));
            $('#btnLimpiarFotoDespues').click(() => $('#fotoDespues').val(''));

            // Terminar mantenimiento
            $('#btnTerminar').click(validarAntesDeConfirmar);
        });

        function inicializarContadoresCaracteres() {
            $('#problemas').on('input', () => limitarCaracteres('problemas', 300));
            $('#diagnostico').on('input', () => limitarCaracteres('diagnostico', 300));
            $('#observaciones').on('input', () => limitarCaracteres('observaciones', 300));
            $('#problemas, #diagnostico, #observaciones').on('paste', function(e) {
                const maxCaracteres = 300;
                const textoPegado = e.originalEvent.clipboardData.getData('text');
                const textoActual = $(this).val();
                if ((textoActual.length + textoPegado.length) > maxCaracteres) {
                    e.preventDefault();
                    const permitido = maxCaracteres - textoActual.length;
                    if (permitido > 0) {
                        document.execCommand('insertText', false, textoPegado.substring(0, permitido));
                    }
                }
            });
        }

        function limitarCaracteres(campoId, maxCaracteres) {
            const textarea = $('#' + campoId);
            const contador = $('#contador-' + campoId);
            let texto = textarea.val();
            if (texto.length > maxCaracteres) {
                textarea.val(texto.substring(0, maxCaracteres));
                texto = textarea.val();
            }
            const caracteresRestantes = maxCaracteres - texto.length;
            contador.text(caracteresRestantes + ' caracteres restantes');
            contador.removeClass('warning danger');
            textarea.removeClass('textarea-limit');
            if (caracteresRestantes <= 0) {
                contador.addClass('danger');
                textarea.addClass('textarea-limit');
            } else if (caracteresRestantes <= 30) {
                contador.addClass('warning');
            }
        }

        function buscarMantenimiento() {
            const claveAgenda = $('#numeroOrden').val().trim();
            if (!claveAgenda) {
                mostrarAlerta('Campo requerido', 'Por favor ingrese un número de orden válido', 'warning');
                return;
            }

            $('#btnBuscarOrden').prop('disabled', true).html('<i class="bi bi-hourglass"></i> Buscando...');
            // Ocultar el formulario si se realiza una nueva búsqueda
            $('#form-body, #footer-form').hide();

            $.get('/Repositorio/BuscarPorNumeroOrden', { claveAgenda: claveAgenda })
                .done(function(response) {
                    if (response.success) {
                        // Llenar datos
                        $('#infoNumOrden').text(response.data.numOrden);
                        $('#infoNumActFijo').text(response.data.numActFijo);
                        $('#infoFechaProgramada').text(response.data.fechaProgramada);
                        $('#infoTipoMantenimiento').text(response.data.tipoMantenimiento);
                        $('#infoTipoEquipo').text(response.data.tipoEquipo);
                        $('#infoEstatus').text(response.data.estatus);
                        $('#infoZona').text(response.data.zona);
                        $('#infoAgencia').text(response.data.agencia);
                        $('#infoCentro').text(response.data.centro);

                        // Mostrar u ocultar número de cajero según el tipo de equipo
                        if (response.data.tipoEquipo === "CFEMÁTICO" && response.data.numCajero && response.data.numCajero !== "N/A") {
                            $('#infoNumCajero').text(response.data.numCajero);
                            $('#filaNumCajero').show();
                        } else {
                            $('#filaNumCajero').hide();
                        }

                        // Establecer fecha actual
                        const hoy = new Date().toISOString().split('T')[0];
                        $('#fechaAtencion').val(hoy);

                        // Mostrar el cuerpo del formulario y el footer
                        $('#form-body, #footer-form').show();

                    } else {
                        mostrarAlerta('Búsqueda sin resultados', response.message, 'info');
                    }
                })
                .fail(function() {
                    mostrarAlerta('Error de conexión', 'Error al conectar con el servidor', 'error');
                })
                .always(function() {
                    $('#btnBuscarOrden').prop('disabled', false).html('<i class="bi bi-search"></i> Buscar');
                });
        }

        function validarAntesDeConfirmar() {
            // ... (Esta función permanece sin cambios)
            const fechaAtencion = $('#fechaAtencion').val();
            if (!fechaAtencion) {
                mostrarAlerta('Campo requerido', 'Por favor seleccione la fecha de atención', 'warning');
                return;
            }
            const archivoPdf = $('#archivoPdf')[0].files[0];
            if (!archivoPdf) {
                mostrarAlerta('Archivo requerido', 'La hoja de servicio es obligatoria', 'warning');
                return;
            }
            if (archivoPdf.name.split('.').pop().toLowerCase() !== 'pdf') {
                mostrarAlerta('Formato incorrecto', 'Solo se permiten archivos PDF', 'warning');
                return;
            }
            if (archivoPdf.size > 5 * 1024 * 1024) {
                mostrarAlerta('Archivo muy grande', 'La hoja de servicio no debe exceder los 5MB', 'warning');
                return;
            }

            // Validar tamaño y tipo de todas las imágenes
            const fotos = [$('#fotoAntes')[0].files[0], $('#fotoDurante')[0].files[0], $('#fotoDespues')[0].files[0]];
            const extensionesPermitidas = ['jpg', 'jpeg', 'png', 'gif', 'bmp'];
            for (const file of fotos) {
                if(file) { // solo si el archivo existe
                     if (!extensionesPermitidas.includes(file.name.split('.').pop().toLowerCase())) {
                        mostrarAlerta('Formato incorrecto', `El archivo '${file.name}' no es una imagen válida.`, 'warning');
                        return;
                    }
                     if (file.size > 2 * 1024 * 1024) {
                        mostrarAlerta('Imagen muy grande', `La imagen '${file.name}' no debe exceder los 2MB.`, 'warning');
                        return;
                    }
                }
            }

            confirmarTerminacion();
        }

        function confirmarTerminacion() {
            Swal.fire({
                title: '¿Desea terminar este mantenimiento?',
                text: "Esta acción no se puede deshacer.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, terminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: { confirmButton: 'btn btn-success mx-2', cancelButton: 'btn btn-secondary mx-2' },
                buttonsStyling: false,
            }).then((result) => {
                if (result.isConfirmed) {
                    terminarMantenimiento();
                }
            });
        }

        function terminarMantenimiento() {
            const formData = new FormData();
            formData.append('numOrden', $('#numeroOrden').val());
            formData.append('fechaAtencion', $('#fechaAtencion').val());
            formData.append('problemas', $('#problemas').val());
            formData.append('diagnostico', $('#diagnostico').val());
            formData.append('observaciones', $('#observaciones').val());
            const pdf = $('#archivoPdf')[0].files[0];
            if (pdf) formData.append('archivoPdf', pdf);
            const fotoAntes = $('#fotoAntes')[0].files[0];
            if (fotoAntes) formData.append('fotoAntes', fotoAntes);
            const fotoDurante = $('#fotoDurante')[0].files[0];
            if (fotoDurante) formData.append('fotoDurante', fotoDurante);
            const fotoDespues = $('#fotoDespues')[0].files[0];
            if (fotoDespues) formData.append('fotoDespues', fotoDespues);

            $('#btnTerminar').prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando...');

            $.ajax({
                url: '/Repositorio/TerminarMantenimiento',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        mostrarAlertaExito('¡Éxito!', response.message);
                        setTimeout(() => { location.reload(); }, 2000);
                    } else {
                        mostrarAlerta('Error', response.message, 'error');
                    }
                },
                error: function(xhr) {
                    mostrarAlerta('Error', xhr.responseJSON?.message || 'Error al terminar el mantenimiento', 'error');
                },
                complete: function() {
                    $('#btnTerminar').prop('disabled', false).html('<i class="bi bi-check-circle"></i> Terminar');
                }
            });
        }

         function mostrarAlerta(titulo, mensaje, tipo) {
             Swal.fire({
                 title: titulo,
                 text: mensaje,
                 icon: tipo,
                 confirmButtonText: 'Aceptar',
                 customClass: { confirmButton: 'btn btn-primary' },
                 buttonsStyling: false
             });
         }
         function mostrarAlertaExito(titulo, mensaje) {
             Swal.fire({
                 title: titulo,
                 text: mensaje,
                 icon: 'success',
                 confirmButtonText: 'Aceptar',
                 customClass: { confirmButton: 'btn btn-success' },
                 buttonsStyling: false
             });
         }
    </script>
}