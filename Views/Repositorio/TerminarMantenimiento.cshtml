@{
    ViewData["Title"] = "Terminar Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="mb-0">Terminar mantenimiento</h1>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Buscar por número de orden:</label>
                        <div class="input-group">
                            <input type="text" id="numeroOrden" class="form-control" placeholder="Ingrese el número de orden">
                            <button class="btn btn-success" type="button" id="btnBuscarOrden">
                                <i class="bi bi-search me-2"></i> Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="form-body" style="display: none;">

                <div id="resultadoBusqueda" class="mt-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Información del mantenimiento</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4"><p><strong>Número de orden:</strong> <span id="infoNumOrden">-</span></p></div>
                                <div class="col-md-4"><p><strong>Tipo de mantenimiento:</strong> <span id="infoTipoMantenimiento">-</span></p></div>
                                <div class="col-md-4"><p><strong>Zona:</strong> <span id="infoZona">-</span></p></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4"><p><strong>Número de activo fijo:</strong> <span id="infoNumActFijo">-</span></p></div>
                                <div class="col-md-4"><p><strong>Fecha programada:</strong> <span id="infoFechaProgramada">-</span></p></div>
                                <div class="col-md-4"><p><strong>Agencia:</strong> <span id="infoAgencia">-</span></p></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4"><p><strong>Tipo de equipo:</strong> <span id="infoTipoEquipo">-</span></p></div>
                                <div class="col-md-4"><p><strong>Estatus:</strong> <span id="infoEstatus">-</span></p></div>
                                <div class="col-md-4"><p><strong>Centro:</strong> <span id="infoCentro">-</span></p></div>
                            </div>
                            <div class="row mt-2" id="filaNumCajero" style="display: none;">
                                <div class="col-md-4"><p><strong>Número de cajero:</strong> <span id="infoNumCajero">-</span></p></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sección de campos de texto con IDs agregados -->
                <div class="row mb-4" id="fila-campos-texto">
                    <div class="col-md-4" id="col-problemas">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0">Problemas: <span class="text-danger">*</span></label>
                                <span class="char-counter" id="contador-problemas">300 caracteres restantes</span>
                            </div>
                            <textarea id="problemas" class="form-control" rows="3" placeholder="Describa los problemas encontrados"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4" id="col-diagnostico">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0" id="label-diagnostico">Diagnóstico: <span class="text-danger">*</span></label>
                                <span class="char-counter" id="contador-diagnostico">300 caracteres restantes</span>
                            </div>
                            <textarea id="diagnostico" class="form-control" rows="3" placeholder="Describa el diagnóstico técnico"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4" id="col-observaciones">
                        <div class="form-group">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0">Observaciones: <span class="text-danger">*</span></label>
                                <span class="char-counter" id="contador-observaciones">300 caracteres restantes</span>
                            </div>
                            <textarea id="observaciones" class="form-control" rows="3" placeholder="Agregue cualquier observación adicional"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Sección de fotos con ID agregado -->
                <div class="row mb-4" id="col-fotos">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto antes del mantenimiento: <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="file" id="fotoAntes" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoAntes"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto durante el mantenimiento: <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="file" id="fotoDurante" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoDurante"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Foto después del mantenimiento: <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="file" id="fotoDespues" class="form-control" accept="image/*">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFotoDespues"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sección de hoja de servicio y fecha (siempre visible) -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Hoja de servicio (PDF): <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="file" id="archivoPdf" class="form-control" accept=".pdf">
                                <button class="btn btn-outline-secondary" type="button" id="btnLimpiarPdf"><i class="bi bi-x-circle"></i> Limpiar</button>
                            </div>
                            <small class="form-text text-muted">Tamaño máximo: 5MB</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Fecha de atención: <span class="text-danger">*</span></label>
                            <input type="date" id="fechaAtencion" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="footer-form" class="card-footer text-end" style="display: none;">
            <button type="button" id="btnTerminar" class="btn btn-success">
                <i class="bi bi-check-circle me-2"></i> Terminar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .char-counter {
            font-size: 0.8rem;
            color: #6c757d;
        }

            .char-counter.warning {
                color: #ffc107;
            }

            .char-counter.danger {
                color: #dc3545;
                font-weight: bold;
            }

        .textarea-limit {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        }

        /* Estilo para los asteriscos rojos */
        .text-danger {
            color: #dc3545 !important;
        }
    </style>
    <script>
        // Variable global para controlar si es impresora
        var esImpresora = false;

        $(document).ready(function() {
            inicializarContadoresCaracteres();

            // Eventos de búsqueda
            $('#btnBuscarOrden').click(buscarMantenimiento);
            $('#numeroOrden').keypress(function(e) {
                if (e.which === 13) buscarMantenimiento();
            });

            // Limpiar campos
            $('#btnLimpiarPdf').click(() => $('#archivoPdf').val(''));
            $('#btnLimpiarFotoAntes').click(() => $('#fotoAntes').val(''));
            $('#btnLimpiarFotoDurante').click(() => $('#fotoDurante').val(''));
            $('#btnLimpiarFotoDespues').click(() => $('#fotoDespues').val(''));

            // Terminar mantenimiento
            $('#btnTerminar').click(validarAntesDeConfirmar);
        });

        function inicializarContadoresCaracteres() {
            $('#problemas').on('input', () => limitarCaracteres('problemas', 300));
            $('#diagnostico').on('input', () => limitarCaracteres('diagnostico', 300));
            $('#observaciones').on('input', () => limitarCaracteres('observaciones', 300));
            $('#problemas, #diagnostico, #observaciones').on('paste', function(e) {
                const maxCaracteres = 300;
                const textoPegado = e.originalEvent.clipboardData.getData('text');
                const textoActual = $(this).val();
                if ((textoActual.length + textoPegado.length) > maxCaracteres) {
                    e.preventDefault();
                    const permitido = maxCaracteres - textoActual.length;
                    if (permitido > 0) {
                        document.execCommand('insertText', false, textoPegado.substring(0, permitido));
                    }
                }
            });
        }

        function limitarCaracteres(campoId, maxCaracteres) {
            const textarea = $('#' + campoId);
            const contador = $('#contador-' + campoId);
            let texto = textarea.val();
            if (texto.length > maxCaracteres) {
                textarea.val(texto.substring(0, maxCaracteres));
                texto = textarea.val();
            }
            const caracteresRestantes = maxCaracteres - texto.length;
            contador.text(caracteresRestantes + ' caracteres restantes');
            contador.removeClass('warning danger');
            textarea.removeClass('textarea-limit');
            if (caracteresRestantes <= 0) {
                contador.addClass('danger');
                textarea.addClass('textarea-limit');
            } else if (caracteresRestantes <= 30) {
                contador.addClass('warning');
            }
        }

        // Función para ajustar la vista según el tipo de equipo
        function ajustarVistaSegunTipoEquipo(tipoEquipo) {
            // Convertir a mayúsculas para comparar
            var tipo = tipoEquipo.toUpperCase();

            // Verificar si es impresora (puede ser "IMPRESORA" o contener la palabra)
            esImpresora = tipo === "IMPRESORA" || tipo.includes("IMPRESORA");

            if (esImpresora) {
                // Ocultar campos que no se usan para impresoras
                $('#col-problemas, #col-fotos').hide();

                // Ajustar el ancho de las columnas restantes para que ocupen todo el espacio
                $('#col-diagnostico, #col-observaciones').removeClass('col-md-4').addClass('col-md-6');

                // Cambiar el texto "Diagnóstico" por "Solución" y placeholder
                $('#label-diagnostico').html('Solución: <span class="text-danger">*</span>');
                $('#diagnostico').attr('placeholder', 'Describa la solución aplicada');
            } else {
                // Mostrar todos los campos para otros tipos de equipo
                $('#col-problemas, #col-fotos').show();

                // Restaurar el ancho de las columnas original
                $('#col-diagnostico, #col-observaciones').removeClass('col-md-6').addClass('col-md-4');

                // Restaurar el texto "Diagnóstico" y placeholder original
                $('#label-diagnostico').html('Diagnóstico: <span class="text-danger">*</span>');
                $('#diagnostico').attr('placeholder', 'Describa el diagnóstico técnico');
            }
        }

        function buscarMantenimiento() {
            const claveAgenda = $('#numeroOrden').val().trim();
            if (!claveAgenda) {
                mostrarAlerta('Campo requerido', 'Por favor ingrese un número de orden válido', 'warning');
                return;
            }

            $('#btnBuscarOrden').prop('disabled', true).html('<i class="bi bi-hourglass"></i> Buscando...');
            // Ocultar el formulario si se realiza una nueva búsqueda
            $('#form-body, #footer-form').hide();

            $.get('/Repositorio/BuscarPorNumeroOrden', { claveAgenda: claveAgenda })
                .done(function(response) {
                    if (response.success) {
                        // Llenar datos
                        $('#infoNumOrden').text(response.data.numOrden);
                        $('#infoNumActFijo').text(response.data.numActFijo);
                        $('#infoFechaProgramada').text(response.data.fechaProgramada);
                        $('#infoTipoMantenimiento').text(response.data.tipoMantenimiento);
                        $('#infoTipoEquipo').text(response.data.tipoEquipo);
                        $('#infoEstatus').text(response.data.estatus);
                        $('#infoZona').text(response.data.zona);
                        $('#infoAgencia').text(response.data.agencia);
                        $('#infoCentro').text(response.data.centro);

                        // Mostrar u ocultar número de cajero según el tipo de equipo
                        if (response.data.tipoEquipo === "CFEMÁTICO" && response.data.numCajero && response.data.numCajero !== "N/A") {
                            $('#infoNumCajero').text(response.data.numCajero);
                            $('#filaNumCajero').show();
                        } else {
                            $('#filaNumCajero').hide();
                        }

                        // Ajustar vista según el tipo de equipo
                        ajustarVistaSegunTipoEquipo(response.data.tipoEquipo);

                        // Dejar fecha de atención vacía
                        $('#fechaAtencion').val('');

                        // Mostrar el cuerpo del formulario y el footer
                        $('#form-body, #footer-form').show();

                    } else {
                        mostrarAlerta('Búsqueda sin resultados', response.message, 'info');
                    }
                })
                .fail(function() {
                    mostrarAlerta('Error de conexión', 'Error al conectar con el servidor', 'error');
                })
                .always(function() {
                    $('#btnBuscarOrden').prop('disabled', false).html('<i class="bi bi-search"></i> Buscar');
                });
        }

        function validarAntesDeConfirmar() {
            // 1. Validar campos de texto obligatorios - PROBLEMAS (solo si NO es impresora)
            if (!esImpresora) {
                const problemas = $('#problemas').val().trim();
                if (!problemas) {
                    mostrarAlerta('Campo requerido', 'El campo "Problemas" es obligatorio', 'warning');
                    $('#problemas').focus();
                    return;
                }
                if (problemas.length > 300) {
                    mostrarAlerta('Texto demasiado largo', 'El campo "Problemas" no debe exceder los 300 caracteres', 'warning');
                    $('#problemas').focus();
                    return;
                }
            }

            // 2. Validar campos de texto obligatorios - DIAGNÓSTICO/SOLUCIÓN (SIEMPRE obligatorio)
            const diagnostico = $('#diagnostico').val().trim();
            if (!diagnostico) {
                // Cambiar el mensaje según si es impresora o no
                const campoNombre = esImpresora ? 'Solución' : 'Diagnóstico';
                mostrarAlerta('Campo requerido', `El campo "${campoNombre}" es obligatorio`, 'warning');
                $('#diagnostico').focus();
                return;
            }
            if (diagnostico.length > 300) {
                const campoNombre = esImpresora ? 'Solución' : 'Diagnóstico';
                mostrarAlerta('Texto demasiado largo', `El campo "${campoNombre}" no debe exceder los 300 caracteres`, 'warning');
                $('#diagnostico').focus();
                return;
            }

            // 3. Validar campos de texto obligatorios - OBSERVACIONES (SIEMPRE obligatorio)
            const observaciones = $('#observaciones').val().trim();
            if (!observaciones) {
                mostrarAlerta('Campo requerido', 'El campo "Observaciones" es obligatorio', 'warning');
                $('#observaciones').focus();
                return;
            }
            if (observaciones.length > 300) {
                mostrarAlerta('Texto demasiado largo', 'El campo "Observaciones" no debe exceder los 300 caracteres', 'warning');
                $('#observaciones').focus();
                return;
            }

            // 4. Validar FOTOS (solo si NO es impresora)
            if (!esImpresora) {
                // Validar FOTO ANTES
                const fotoAntes = $('#fotoAntes')[0].files[0];
                if (!fotoAntes) {
                    mostrarAlerta('Archivo requerido', 'La foto "Antes" del mantenimiento es obligatoria', 'warning');
                    $('#fotoAntes').focus();
                    return;
                }
                const extensionAntes = fotoAntes.name.split('.').pop().toLowerCase();
                const extensionesPermitidas = ['jpg', 'jpeg', 'png', 'gif', 'bmp'];
                if (!extensionesPermitidas.includes(extensionAntes)) {
                    mostrarAlerta('Formato incorrecto', 'La foto "Antes" no es una imagen válida. Formatos permitidos: JPG, JPEG, PNG, GIF, BMP', 'warning');
                    return;
                }
                if (fotoAntes.size > 5 * 1024 * 1024) {
                    mostrarAlerta('Imagen muy grande', 'La foto "Antes" no debe exceder los 5MB', 'warning');
                    return;
                }

                // Validar FOTO DURANTE
                const fotoDurante = $('#fotoDurante')[0].files[0];
                if (!fotoDurante) {
                    mostrarAlerta('Archivo requerido', 'La foto "Durante" del mantenimiento es obligatoria', 'warning');
                    $('#fotoDurante').focus();
                    return;
                }
                const extensionDurante = fotoDurante.name.split('.').pop().toLowerCase();
                if (!extensionesPermitidas.includes(extensionDurante)) {
                    mostrarAlerta('Formato incorrecto', 'La foto "Durante" no es una imagen válida. Formatos permitidos: JPG, JPEG, PNG, GIF, BMP', 'warning');
                    return;
                }
                if (fotoDurante.size > 5 * 1024 * 1024) {
                    mostrarAlerta('Imagen muy grande', 'La foto "Durante" no debe exceder los 5MB', 'warning');
                    return;
                }

                // Validar FOTO DESPUÉS
                const fotoDespues = $('#fotoDespues')[0].files[0];
                if (!fotoDespues) {
                    mostrarAlerta('Archivo requerido', 'La foto "Después" del mantenimiento es obligatoria', 'warning');
                    $('#fotoDespues').focus();
                    return;
                }
                const extensionDespues = fotoDespues.name.split('.').pop().toLowerCase();
                if (!extensionesPermitidas.includes(extensionDespues)) {
                    mostrarAlerta('Formato incorrecto', 'La foto "Después" no es una imagen válida. Formatos permitidos: JPG, JPEG, PNG, GIF, BMP', 'warning');
                    return;
                }
                if (fotoDespues.size > 5 * 1024 * 1024) {
                    mostrarAlerta('Imagen muy grande', 'La foto "Después" no debe exceder los 5MB', 'warning');
                    return;
                }
            }

            // 5. Validar HOJA DE SERVICIO (PDF) (SIEMPRE obligatorio)
            const archivoPdf = $('#archivoPdf')[0].files[0];
            if (!archivoPdf) {
                mostrarAlerta('Archivo requerido', 'La hoja de servicio es obligatoria', 'warning');
                $('#archivoPdf').focus();
                return;
            }
            const extensionPdf = archivoPdf.name.split('.').pop().toLowerCase();
            if (extensionPdf !== 'pdf') {
                mostrarAlerta('Formato incorrecto', 'Solo se permiten archivos PDF', 'warning');
                return;
            }
            if (archivoPdf.size > 5 * 1024 * 1024) {
                mostrarAlerta('Archivo muy grande', 'La hoja de servicio no debe exceder los 5MB', 'warning');
                return;
            }

            // 6. Validar FECHA DE ATENCIÓN (SIEMPRE obligatorio)
            const fechaAtencion = $('#fechaAtencion').val();
            if (!fechaAtencion) {
                mostrarAlerta('Campo requerido', 'Por favor seleccione la fecha de atención', 'warning');
                $('#fechaAtencion').focus();
                return;
            }

            // Si todas las validaciones pasan, proceder con la confirmación
            confirmarTerminacion();
        }

        function confirmarTerminacion() {
            var titulo = esImpresora ?
                '¿Desea terminar este mantenimiento de impresora?' :
                '¿Desea terminar este mantenimiento?';

            var texto = esImpresora ?
                "Esta acción registrará el mantenimiento de la impresora." :
                "Esta acción no se puede deshacer.";

            Swal.fire({
                title: titulo,
                text: texto,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, terminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: { confirmButton: 'btn btn-success mx-2', cancelButton: 'btn btn-danger mx-2' },
                buttonsStyling: false,
            }).then((result) => {
                if (result.isConfirmed) {
                    terminarMantenimiento();
                }
            });
        }

        function terminarMantenimiento() {
            const formData = new FormData();
            formData.append('numOrden', $('#numeroOrden').val());
            formData.append('fechaAtencion', $('#fechaAtencion').val());

            // Solo agregar problemas si NO es impresora
            if (!esImpresora) {
                formData.append('problemas', $('#problemas').val());
            } else {
                formData.append('problemas', ''); // Enviar vacío para impresoras
            }

            // Nota: El campo sigue llamándose "diagnostico" en el servidor, aunque en la vista se muestre como "Solución"
            formData.append('diagnostico', $('#diagnostico').val());
            formData.append('observaciones', $('#observaciones').val());

            const pdf = $('#archivoPdf')[0].files[0];
            if (pdf) formData.append('archivoPdf', pdf);

            // Solo agregar fotos si NO es impresora
            if (!esImpresora) {
                const fotoAntes = $('#fotoAntes')[0].files[0];
                if (fotoAntes) formData.append('fotoAntes', fotoAntes);

                const fotoDurante = $('#fotoDurante')[0].files[0];
                if (fotoDurante) formData.append('fotoDurante', fotoDurante);

                const fotoDespues = $('#fotoDespues')[0].files[0];
                if (fotoDespues) formData.append('fotoDespues', fotoDespues);
            }

            $('#btnTerminar').prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando...');

            $.ajax({
                url: '/Repositorio/TerminarMantenimiento',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        mostrarAlertaExito('¡Éxito!', response.message);
                        setTimeout(() => { location.reload(); }, 2000);
                    } else {
                        mostrarAlerta('Error', response.message, 'error');
                    }
                },
                error: function(xhr) {
                    mostrarAlerta('Error', xhr.responseJSON?.message || 'Error al terminar el mantenimiento', 'error');
                },
                complete: function() {
                    $('#btnTerminar').prop('disabled', false).html('<i class="bi bi-check-circle"></i> Terminar');
                }
            });
        }

        function mostrarAlerta(titulo, mensaje, tipo) {
            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: tipo,
                confirmButtonText: 'Aceptar',
                customClass: { confirmButton: 'btn btn-primary' },
                buttonsStyling: false
            });
        }

        function mostrarAlertaExito(titulo, mensaje) {
            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: 'success',
                confirmButtonText: 'Aceptar',
                customClass: { confirmButton: 'btn btn-success' },
                buttonsStyling: false
            });
        }
    </script>
}