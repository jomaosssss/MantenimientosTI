@model MantenimientosTI.Models.Impresora

@{
    // Obtener datos adicionales del ViewBag
    var claveAgenda = ViewBag.NumeroDeOrden as int?;
    var impresoraMantenimiento = ViewBag.ImpresoraMantenimiento as MantenimientosTI.Models.ImpresoraMantenimiento;
}

<div class="row">
    <div class="col-md-6">
        <h5>Información del equipo</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Número de activo cijo:</strong> @Model.NumActFijo</li>
            <li class="list-group-item"><strong>Tipo de equipo:</strong> Impresora</li>
            <li class="list-group-item"><strong>ID equipo:</strong> @Model.IdEquipo</li>
            <li class="list-group-item"><strong>Folio llave:</strong> @Model.FolioLlave</li>
            <li class="list-group-item"><strong>Número de serie:</strong> @Model.NumSerie</li>
            <li class="list-group-item"><strong>Modelo:</strong> @Model.Modelo</li>
            <li class="list-group-item"><strong>Tipo de impresión:</strong> @Model.TipoImpresion</li>
            <li class="list-group-item"><strong>IP de la impresora:</strong> @Model.IpImpresora</li>
            <li class="list-group-item"><strong>Responsable:</strong> @Model.Responsable</li>
            <li class="list-group-item"><strong>Teléfono:</strong> @(string.IsNullOrEmpty(Model.Telefono) ? "N/A" : Model.Telefono)</li>
            <li class="list-group-item"><strong>Extensión:</strong> @(string.IsNullOrEmpty(Model.Extension) ? "N/A" : Model.Extension)</li>
            <li class="list-group-item"><strong>Correo:</strong> @(string.IsNullOrEmpty(Model.Correo) ? "N/A" : Model.Correo)</li>
        </ul>
    </div>
    <div class="col-md-6">
        <h5>Ubicación</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Zona:</strong> @Model.NumActFijoNavigation?.CatCentro?.CatAgencium?.CatZona?.NombreZona ?? "N/A"</li>
            <li class="list-group-item"><strong>Agencia:</strong> @Model.NumActFijoNavigation?.CatCentro?.CatAgencium?.NombreAgencia ?? "N/A"</li>
            <li class="list-group-item"><strong>Centro:</strong> @Model.NumActFijoNavigation?.CatCentro?.NombreCentro ?? "N/A"</li>
        </ul>

        @if (impresoraMantenimiento != null)
        {
            <h5 class="mt-3">Información del reporte</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Número de orden:</strong> @claveAgenda</li>
                <li class="list-group-item"><strong>Folio de atención:</strong> @impresoraMantenimiento.FolioAtencion</li>
                <li class="list-group-item"><strong>RPE:</strong> @impresoraMantenimiento.Rpe</li>
                <li class="list-group-item"><strong>Usuario que reporta:</strong> @impresoraMantenimiento.UsuarioReporta</li>
                <li class="list-group-item"><strong>Correo:</strong> @impresoraMantenimiento.Correo</li>
                <li class="list-group-item"><strong>Fecha de reporte:</strong> @impresoraMantenimiento.FechaReporte.ToString("dd/MM/yyyy")</li>
                <li class="list-group-item"><strong>Fecha de captura:</strong> @impresoraMantenimiento.FechaCaptura.ToString("dd/MM/yyyy HH:mm")</li>
            </ul>

            <h5 class="mt-3">Detalles del reporte</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Problemática:</strong></li>
                <li class="list-group-item">@impresoraMantenimiento.Problematica</li>
                <li class="list-group-item"><strong>Observaciones:</strong></li>
                <li class="list-group-item">@impresoraMantenimiento.Observaciones</li>
            </ul>
        }
        else
        {
            <h5 class="mt-3">Información del reporte</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Número de orden:</strong> @claveAgenda</li>
                <li class="list-group-item"><strong>Información de mantenimiento no disponible</strong></li>
            </ul>
        }
    </div>
</div>