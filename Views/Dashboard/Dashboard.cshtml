@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Estilos para las tarjetas de conteo */
    .hover-scale {
        transition: all 0.3s ease;
    }

        .hover-scale:hover {
            transform: translateY(-5px);
        }

    /* Efecto para tarjeta azul */
    .card-bg-primary:hover {
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2) !important;
    }

    /* Efecto para tarjeta verde */
    .card-bg-success:hover {
        box-shadow: 0 10px 20px rgba(40, 167, 69, 0.2) !important;
    }

    /* Efecto para tarjeta amarilla */
    .card-bg-warning:hover {
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.2) !important;
    }

    /* Efecto para tarjeta gris */
    .card-bg-secondary:hover {
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2) !important;
    }

    .icon-shape {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-count {
        border-radius: 15px;
        min-height: 120px;
        border: none;
    }
</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Dashboard</h3>
        </div>

        <div class="card-body">
            <!-- Primera fila: Tarjetas de conteo estilizadas -->
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 h-100 hover-scale card-count card-bg-primary" style="background-color: #0d6efd;">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-white text-primary mb-1 fw-bold" style="font-size: 0.75rem;">TARJETA DE CONTEO #1</span>
                                    <h2 class="text-white mb-0" style="font-size: 1.75rem;">0</h2>
                                </div>
                                <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-chart-line text-primary" style="font-size: 1.5rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 h-100 hover-scale card-count card-bg-success" style="background-color: #28a745;">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-white text-success mb-1 fw-bold" style="font-size: 0.75rem;">TARJETA DE CONTEO #2</span>
                                    <h2 class="text-white mb-0" style="font-size: 1.75rem;">0</h2>
                                </div>
                                <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-chart-bar text-success" style="font-size: 1.5rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 h-100 hover-scale card-count card-bg-warning" style="background-color: #ffc107;">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-white text-warning mb-1 fw-bold" style="font-size: 0.75rem;">TARJETA DE CONTEO #3</span>
                                    <h2 class="text-white mb-0" style="font-size: 1.75rem;">0</h2>
                                </div>
                                <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-chart-pie text-warning" style="font-size: 1.5rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 h-100 hover-scale card-count card-bg-secondary" style="background-color: #808080;">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-white text-black-50 mb-1 fw-bold" style="font-size: 0.75rem;">TARJETA DE CONTEO #4</span>
                                    <h2 class="text-white mb-0" style="font-size: 1.75rem;">0</h2>
                                </div>
                                <div class="icon-shape bg-white rounded-circle p-2 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-calendar-alt text-black-50" style="font-size: 1.5rem;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Segunda fila: Envío de reporte y gráfica de líneas -->
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">Envío de Reporte</h5>
                        </div>
                        <div class="card-body">
                            <div id="mensajeResultado" class="mt-3"></div>

                            <!-- Selector de Rango de Fechas -->
                            <div class="mb-3">
                                <label class="form-label"><strong>Rango de Fechas del Reporte</strong></label>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small">Fecha Inicio</label>
                                        <input type="date" class="form-control" id="fechaInicio">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small">Fecha Fin</label>
                                        <input type="date" class="form-control" id="fechaFin">
                                    </div>
                                </div>
                            </div>

                            <!-- Programación de Envío -->
                            <div class="mb-3">
                                <label class="form-label"><strong>Programar Envío</strong></label>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="toggleProgramarEnvio">
                                    <label class="form-check-label" for="toggleProgramarEnvio">
                                        Programar envío automático
                                    </label>
                                </div>

                                <div id="programacionContainer" style="display: none;">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">Fecha</label>
                                            <input type="date" class="form-control" id="fechaProgramada">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">Hora</label>
                                            <input type="time" class="form-control" id="horaProgramada">
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted" id="infoProgramacion"></small>
                                    </div>
                                </div>
                            </div>

                            <!-- Botones de Acción -->
                            <div class="d-grid gap-2">
                                <button id="btnEnviarCorreo" class="btn btn-success btn-md">
                                    <i class="fas fa-paper-plane me-2"></i>Enviar Reporte Ahora
                                </button>
                                <button id="btnProgramarEnvio" class="btn btn-outline-primary btn-md" style="display: none;">
                                    <i class="fas fa-clock me-2"></i>Programar Envío
                                </button>
                            </div>

                            <!-- Información del Reporte -->
                            <div class="mt-3 p-2 bg-light rounded">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span id="infoReporte">Selecciona un rango de fechas para generar el reporte</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-light text-dark">
                            <h5 class="mb-0">Gráfica de líneas</h5>
                        </div>
                        <div class="card-body text-center">
                            <div class="chart-container" style="position: relative; height:300px;">
                                <canvas id="lineChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tercera fila: Gráficas de pastel y barras -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-light text-dark">
                            <h5 class="mb-0">Gráfica de pastel</h5>
                        </div>
                        <div class="card-body text-center">
                            <div class="chart-container" style="position: relative; height:300px;">
                                <canvas id="pieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-light text-dark">
                            <h5 class="mb-0">Gráfica de barras</h5>
                        </div>
                        <div class="card-body text-center">
                            <div class="chart-container" style="position: relative; height:300px;">
                                <canvas id="barChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Incluir Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>


        $(document).ready(function() {

                    // Función para enviar correo (mejorada)
        $('#btnEnviarCorreo').click(function() {
            const btn = $(this);
            const fechaInicio = $('#fechaInicio').val();
            const fechaFin = $('#fechaFin').val();

            // Validar fechas
            if (!fechaInicio || !fechaFin) {
                mostrarAlerta('Por favor, selecciona el rango de fechas para el reporte.', 'warning');
                return;
            }

            if (new Date(fechaInicio) > new Date(fechaFin)) {
                mostrarAlerta('La fecha de inicio no puede ser mayor a la fecha fin.', 'warning');
                return;
            }

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Enviando...');
            $('#mensajeResultado').html('');

            const datos = {
                fechaInicio: fechaInicio,
                fechaFin: fechaFin
            };

            $.ajax({
                url: '@Url.Action("EnviarCorreoPrueba", "Dashboard")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(datos),
                success: function(response) {
                    if (response.success) {
                        $('#mensajeResultado').html(
                            '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                            '<i class="fas fa-check-circle me-2"></i>' + response.message +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                            '</div>'
                        );
                    } else {
                        $('#mensajeResultado').html(
                            '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                            '<i class="fas fa-exclamation-circle me-2"></i>' + response.message +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                            '</div>'
                        );
                    }
                },
                error: function(xhr, status, error) {
                    let mensajeError = 'Error de conexión. Intente nuevamente.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        mensajeError = xhr.responseJSON.message;
                    }
                    $('#mensajeResultado').html(
                        '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                        '<i class="fas fa-exclamation-circle me-2"></i>' + mensajeError +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                        '</div>'
                    );
                },
                complete: function() {
                    btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Enviar Reporte Ahora');
                }
            });
        });

        // Toggle para programar envío
        $('#toggleProgramarEnvio').change(function() {
            const programar = $(this).is(':checked');
            if (programar) {
                $('#programacionContainer').slideDown();
                $('#btnProgramarEnvio').show();
                $('#btnEnviarCorreo').hide();

                // Establecer valores por defecto para la programación
                const ahora = new Date();
                const fechaManana = new Date(ahora);
                fechaManana.setDate(ahora.getDate() + 1);

                $('#fechaProgramada').val(fechaManana.toISOString().split('T')[0]);
                $('#horaProgramada').val('09:00');
                actualizarInfoProgramacion();
            } else {
                $('#programacionContainer').slideUp();
                $('#btnProgramarEnvio').hide();
                $('#btnEnviarCorreo').show();
            }
        });

        // Actualizar información de programación
        function actualizarInfoProgramacion() {
            const fecha = $('#fechaProgramada').val();
            const hora = $('#horaProgramada').val();

            if (fecha && hora) {
                const fechaHora = new Date(`${fecha}T${hora}`);
                const opciones = {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                };
                const fechaFormateada = fechaHora.toLocaleDateString('es-ES', opciones);
                $('#infoProgramacion').text(`El reporte se enviará el: ${fechaFormateada}`);
            }
        }

        // Eventos para actualizar la información
        $('#fechaProgramada, #horaProgramada').change(actualizarInfoProgramacion);

        // Función para programar envío (pendiente de implementar en el backend)
        $('#btnProgramarEnvio').click(function() {
            const btn = $(this);
            const fechaInicio = $('#fechaInicio').val();
            const fechaFin = $('#fechaFin').val();
            const fechaProgramada = $('#fechaProgramada').val();
            const horaProgramada = $('#horaProgramada').val();

            // Validaciones
            if (!fechaInicio || !fechaFin) {
                mostrarAlerta('Por favor, selecciona el rango de fechas para el reporte.', 'warning');
                return;
            }

            if (!fechaProgramada || !horaProgramada) {
                mostrarAlerta('Por favor, completa la fecha y hora programada.', 'warning');
                return;
            }

            const fechaHoraProgramada = new Date(`${fechaProgramada}T${horaProgramada}`);
            const ahora = new Date();

            if (fechaHoraProgramada <= ahora) {
                mostrarAlerta('La fecha y hora programada debe ser futura.', 'warning');
                return;
            }

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Programando...');

            const datos = {
                fechaInicio: fechaInicio,
                fechaFin: fechaFin,
                fechaProgramada: fechaProgramada,
                horaProgramada: horaProgramada
            };

            // Aquí llamaríamos al endpoint para programar el envío
            // Por ahora mostramos un mensaje informativo
            setTimeout(() => {
                mostrarAlerta('Funcionalidad de programación en desarrollo. Por ahora usa "Enviar Reporte Ahora".', 'info');
                btn.prop('disabled', false).html('<i class="fas fa-clock me-2"></i>Programar Envío');
            }, 1000);
        });

        // Actualizar información del reporte cuando cambien las fechas
        function actualizarInfoReporte() {
            const fechaInicio = $('#fechaInicio').val();
            const fechaFin = $('#fechaFin').val();

            if (fechaInicio && fechaFin) {
                const inicio = new Date(fechaInicio);
                const fin = new Date(fechaFin);
                const diffTime = Math.abs(fin - inicio);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

                $('#infoReporte').text(`Reporte generará datos desde ${fechaInicio} hasta ${fechaFin} (${diffDays} días)`);
            } else {
                $('#infoReporte').text('Selecciona un rango de fechas para generar el reporte');
            }
        }

        // Establecer valores por defecto para el rango de fechas (mes actual)
        function establecerFechasPorDefecto() {
            const ahora = new Date();
            const primerDiaMes = new Date(ahora.getFullYear(), ahora.getMonth(), 1);
            const ultimoDiaMes = new Date(ahora.getFullYear(), ahora.getMonth() + 1, 0);

            $('#fechaInicio').val(primerDiaMes.toISOString().split('T')[0]);
            $('#fechaFin').val(ultimoDiaMes.toISOString().split('T')[0]);

            actualizarInfoReporte();
        }

        // Eventos para actualizar la información del reporte
        $('#fechaInicio, #fechaFin').change(actualizarInfoReporte);

        // Inicializar al cargar la página
        $(document).ready(function() {
            establecerFechasPorDefecto();

// Gráfica de Líneas
            var lineCtx = document.getElementById('lineChart').getContext('2d');
            var lineChart = new Chart(lineCtx, {
                type: 'line',
                data: {
                    labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
                    datasets: [{
                        label: 'My First Dataset',
                        data: [65, 59, 80, 81, 56, 55, 40],
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: 'rgba(54, 162, 235, 1)',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: false,
                            min: 40,
                            max: 85,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Trend Data Over Time'
                        },
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    }
                }
            });

            // Gráfica de Pastel
            var pieCtx = document.getElementById('pieChart').getContext('2d');
            var pieChart = new Chart(pieCtx, {
                type: 'pie',
                data: {
                    labels: ['Producto A', 'Producto B', 'Producto C', 'Producto D'],
                    datasets: [{
                        data: [30, 25, 20, 25],
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        },
                        title: {
                            display: true,
                            text: 'Distribución de Ventas'
                        }
                    }
                }
            });

            // Gráfica de Barras
            var barCtx = document.getElementById('barChart').getContext('2d');
            var barChart = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio'],
                    datasets: [{
                        label: 'Ventas 2023',
                        data: [65, 59, 80, 81, 56, 55],
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Ventas 2024',
                        data: [28, 48, 40, 19, 86, 27],
                        backgroundColor: 'rgba(255, 99, 132, 0.7)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Ventas Mensuales'
                        }
                    }
                }
            });        });

        });
    </script>
}