@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model MantenimientosTI.Controllers.DashboardViewModel
@using System.Globalization

<style>
    /* Estilos originales de tarjetas (Hover scale, etc.) */
    .hover-scale {
        transition: all 0.3s ease;
    }

        .hover-scale:hover {
            transform: translateY(-5px);
        }

    .card-bg-primary:hover {
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2) !important;
    }

    .card-bg-success:hover {
        box-shadow: 0 10px 20px rgba(40, 167, 69, 0.2) !important;
    }

    .card-bg-warning:hover {
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.2) !important;
    }

    .card-bg-secondary:hover {
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2) !important;
    }

    .icon-shape {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-count {
        border-radius: 15px;
        min-height: 120px;
        border: none;
    }

    /* ESTILOS MEJORADOS PARA LAS NUEVAS TARJETAS */
    .stats-card {
        border-radius: 12px;
        min-height: 100px;
        border: none;
        transition: all 0.3s ease;
        flex: 1;
        min-width: 0;
    }

    .stats-card-content {
        padding: 0.9rem;
    }

    .stats-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
        font-weight: 600;
    }

    .stats-number {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .stats-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .cards-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Colores tarjetas nuevas */
    .card-orange {
        background-color: #fd7e14;
    }

    .card-blue {
        background-color: #0d6efd;
    }

    .card-green {
        background-color: #28a745;
    }

    .card-yellow {
        background-color: #ffc107;
    }

    .card-gray {
        background-color: #808080;
    }

    .text-orange {
        color: #fd7e14 !important;
    }

    /* Efectos hover tarjetas nuevas */
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    }

    .card-orange:hover {
        box-shadow: 0 6px 15px rgba(253, 126, 20, 0.25) !important;
    }

    .card-blue:hover {
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.25) !important;
    }

    .card-green:hover {
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.25) !important;
    }

    .card-yellow:hover {
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.25) !important;
    }

    .card-gray:hover {
        box-shadow: 0 6px 15px rgba(108, 117, 125, 0.25) !important;
    }

    /* Estilos para el selector de hora personalizado */
    .input-group .form-select {
        border-radius: 0;
    }

        .input-group .form-select:first-child {
            border-top-left-radius: 0.375rem;
            border-bottom-left-radius: 0.375rem;
        }

        .input-group .form-select:last-child {
            border-top-right-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        font-weight: 600;
    }

    /* Estilos para las gráficas */
    .color-box {
        width: 12px;
        height: 12px;
        border-radius: 2px;
        display: inline-block;
    }

    .legend-container {
        border-top: 1px solid #f0f0f0;
        padding-top: 8px;
    }

    .chart-container {
        position: relative;
        height: 160px;
        min-height: 160px;
    }

    /* Asegurar que la tarjeta de reportes no se estire */
    .card-reportes {
        height: auto !important;
        min-height: auto;
    }

    /* Agrega esto en tu sección de estilos */
    .chart-container {
        position: relative;
        height: 160px;
        min-height: 160px;
    }

    .position-absolute {
        z-index: 1;
    }

    /* Estilos para los controles de filtro de gráficas */
    .filtro-graficas {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        border: 1px solid #e9ecef;
    }

    .card-header .form-control-sm {
        font-size: 0.8rem;
    }

    .card-header .btn-sm {
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
    }

    /* Estilos para animaciones de gráficas */
    .chart-fade-in {
        animation: chartFadeIn 1s ease-out;
    }

    @@keyframes chartFadeIn {
        from {
            opacity: 0;
            transform: scale(0.8);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .card-fade-in {
        animation: cardFadeIn 0.6s ease-out;
    }

    @@keyframes cardFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Media queries para responsividad */
    @@media (max-width: 768px) {
        .cards-container {
            gap: 8px;
        }

        .stats-card {
            min-height: 90px;
            flex: 1 1 calc(50% - 8px);
        }

        .stats-number {
            font-size: 1.5rem;
        }

        .stats-icon {
            width: 38px;
            height: 38px;
            font-size: 1.1rem;
        }

        .stats-badge {
            font-size: 0.7rem;
        }

        .filtro-graficas .d-flex {
            flex-direction: column;
            gap: 10px;
        }

            .filtro-graficas .d-flex > * {
                width: 100%;
            }
    }

    @@media (max-width: 576px) {
        .stats-card-content {
            padding: 0.7rem;
        }

        .stats-number {
            font-size: 1.4rem;
        }

        .stats-card {
            flex: 1 1 100%;
            min-height: 85px;
        }

        .cards-container {
            gap: 6px;
        }

        .stats-badge {
            font-size: 0.68rem;
        }
    }

    @@media (min-width: 1200px) {
        .stats-card {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Dashboard</h3>
        </div>

        <div class="card-body">
            <div class="cards-container mb-4">
                @{
                    var culturaEs = new CultureInfo("es-ES");
                    var mesActual = DateTime.Now.ToString("MMMM", culturaEs).ToUpper();
                    var mesSiguiente = DateTime.Now.AddMonths(1).ToString("MMMM", culturaEs).ToUpper();
                    var mesAnterior = DateTime.Now.AddMonths(-1).ToString("MMMM", culturaEs).ToUpper();
                }

                <div class="card stats-card card-orange">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-orange mb-1">PENDIENTES @mesAnterior</span>
                                <h2 class="stats-number text-white">@Model.PendientesMesAnteriorCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-exclamation-triangle text-orange"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-blue">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-primary mb-1">PROGRAMADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-green">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-success mb-1">TERMINADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.TerminadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-yellow">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-warning mb-1">PENDIENTES @mesActual</span>
                                <h2 class="stats-number text-white">@Model.PendientesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-spinner text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-gray">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-secondary mb-1">PROGRAMADOS @mesSiguiente</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosProximoMesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-check text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8 col-md-12">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light border-bottom">
                            <h5 class="mb-0 text-secondary"><i class="fas fa-chart-pie me-2"></i> Avances de mantenimientos</h5>
                        </div>
                        <div class="card-body">
                            <!-- Controles de filtro para gráficas -->
                            <div class="filtro-graficas">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <label class="form-label mb-0 text-nowrap">Rango de fechas:</label>
                                        <input type="date" class="form-control form-control-sm" id="filtroFechaInicio"
                                               style="max-width: 150px;" title="Fecha Inicio">
                                        <span class="text-muted">a</span>
                                        <input type="date" class="form-control form-control-sm" id="filtroFechaFin"
                                               style="max-width: 150px;" title="Fecha Fin">
                                        <label class="form-label mb-0 text-nowrap ms-3">Zona:</label>
                                        <select class="form-select form-select-sm" id="filtroZona" style="max-width: 150px;">
                                            <option value="TODAS">TODAS</option>
                                            @foreach (var zona in Model.Zonas)
                                            {
                                                <option value="@zona.ClaveZona">@zona.NombreZona</option>
                                            }
                                        </select>
                                    </div>
                                    <button id="btnFiltrarGraficas" class="btn btn-success btn-sm">
                                        <i class="fas fa-filter me-1"></i>Filtrar
                                    </button>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted" id="infoFiltroGraficas">
                                        Mostrando datos del mes actual para TODAS las zonas
                                    </small>
                                </div>
                            </div>

                            <!-- CONTENEDOR PARA MENSAJES DE GRÁFICAS -->
                            <div id="mensajeGraficas" class="mt-2 small"></div>

                            @{
                                var zonasConDatos = Model.GraficasZonas.Where(z => z.TieneDatos).ToList();
                            }

                            @if (zonasConDatos.Any())
                            {
                                <div class="row g-3" id="contenedorGraficas">
                                    @foreach (var zona in zonasConDatos)
                                    {
                                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 card-fade-in">
                                            <div class="card border-0 shadow-sm h-100">
                                                <div class="card-header bg-light py-2">
                                                    <h6 class="mb-0 text-center text-dark" style="font-size: 0.85rem; font-weight: normal;">@zona.NombreZona</h6>
                                                </div>
                                                <div class="card-body p-2 d-flex flex-column">
                                                    <div class="chart-container flex-grow-1 position-relative">
                                                        <canvas id="chart-@zona.Zona"
                                                                data-item='@Json.Serialize(zona)'
                                                                data-tiene-datos="true"
                                                                data-tipo="zonas"></canvas>
                                                    </div>
                                                    <div class="legend-container mt-2">
                                                        <div class="d-flex justify-content-center flex-wrap gap-2">
                                                            <div class="d-flex align-items-center">
                                                                <div class="color-box bg-success me-1"></div>
                                                                <small class="text-muted">Terminados: @zona.Terminados</small>
                                                            </div>
                                                            <div class="d-flex align-items-center">
                                                                <div class="color-box bg-warning me-1"></div>
                                                                <small class="text-muted">Pendientes: @zona.Pendientes</small>
                                                            </div>
                                                            @if (zona.Otros > 0)
                                                            {
                                                                <div class="d-flex align-items-center">
                                                                    <div class="color-box bg-secondary me-1"></div>
                                                                    <small class="text-muted">Otros: @zona.Otros</small>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <span class="text-muted fst-italic">No hay datos disponibles para mostrar.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-12">
                    <div class="card shadow-sm card-reportes">
                        <div class="card-header bg-light border-bottom">
                            <h5 class="mb-0 text-secondary"><i class="fas fa-envelope me-2"></i>Gestión de reportes</h5>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="mb-3 pb-3 border-bottom">
                                <h6><i class="fas fa-paper-plane me-1 text-success"></i> Envío Manual</h6>

                                <!-- Botón para desplegar/contraer la lista de usuarios -->
                                <div class="mb-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 d-flex justify-content-between align-items-center" id="btnSeleccionarUsuarios">
                                        <span>
                                            <i class="fas fa-users me-1"></i> Seleccionar usuarios
                                        </span>
                                        <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>

                                <!-- Contenedor de la lista de usuarios (inicialmente oculto) -->
                                <div id="contenedorUsuarios" class="mt-2" style="display: none;">
                                    <div class="card">
                                        <div class="card-body py-2">
                                            <h6 class="card-title">Usuarios administradores</h6>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="seleccionarTodos">
                                                <label class="form-check-label" for="seleccionarTodos">
                                                    Seleccionar todos
                                                </label>
                                            </div>
                                            <hr class="my-2">
                                            <div id="listaUsuarios">
                                                <!-- Aquí se cargarán los usuarios dinámicamente -->
                                                <div class="text-center">
                                                    <div class="spinner-border spinner-border-sm" role="status">
                                                        <span class="visually-hidden">Cargando...</span>
                                                    </div>
                                                    <small class="text-muted">Cargando usuarios...</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div id="mensajeResultado" class="mt-2 small"></div>

                                <!-- El resto del formulario existente -->
                                <div class="mb-2 mt-2">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="date" class="form-control form-control-sm" id="fechaInicio" title="Fecha Inicio">
                                        </div>
                                        <div class="col-6">
                                            <input type="date" class="form-control form-control-sm" id="fechaFin" title="Fecha Fin">
                                        </div>
                                    </div>
                                    <div class="mt-2 px-2 py-1 bg-light rounded border">
                                        <small class="text-muted fst-italic" style="font-size: 0.8em;">
                                            <i class="fas fa-info-circle me-1"></i>
                                            <span id="infoReporte">Selecciona rango...</span>
                                        </small>
                                    </div>
                                </div>
                                <div class="d-grid">
                                    <button id="btnEnviarCorreo" class="btn btn-success btn-sm">
                                        <i class="fas fa-paper-plane me-1"></i>Enviar Ahora
                                    </button>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <h6><i class="fas fa-clock me-1 text-success"></i> Programación Semanal</h6>
                                <div id="mensajeProgramacion" class="mt-2 small"></div>

                                <div class="mb-2 mt-2">
                                    <!-- Día de la semana -->
                                    <div class="row g-2 mb-2">
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Día de envío:</label>
                                            <select class="form-select form-select-sm" id="diaSemanaProgramado">
                                                <option value="Monday">Lunes</option>
                                                <option value="Tuesday">Martes</option>
                                                <option value="Wednesday">Miércoles</option>
                                                <option value="Thursday">Jueves</option>
                                                <option value="Friday">Viernes</option>
                                                <option value="Saturday">Sábado</option>
                                                <option value="Sunday">Domingo</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Primer horario -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Primer envío:</label>
                                            <div class="input-group input-group-sm">
                                                <select class="form-select" id="horaProgramadaHoras1" style="min-width: 55px;">
                                                    <option value="01">01</option>
                                                    <option value="02">02</option>
                                                    <option value="03">03</option>
                                                    <option value="04">04</option>
                                                    <option value="05">05</option>
                                                    <option value="06">06</option>
                                                    <option value="07">07</option>
                                                    <option value="08">08</option>
                                                    <option value="09">09</option>
                                                    <option value="10">10</option>
                                                    <option value="11">11</option>
                                                    <option value="12">12</option>
                                                </select>
                                                <span class="input-group-text px-1">:</span>
                                                <select class="form-select" id="horaProgramadaMinutos1" style="min-width: 55px;">
                                                    <option value="00">00</option>
                                                    <option value="15">15</option>
                                                    <option value="30">30</option>
                                                    <option value="45">45</option>
                                                </select>
                                                <select class="form-select" id="horaProgramadaPeriodo1" style="min-width: 55px;">
                                                    <option value="AM">AM</option>
                                                    <option value="PM">PM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Segundo horario -->
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Segundo envío (opcional):</label>
                                            <div class="input-group input-group-sm">
                                                <select class="form-select" id="horaProgramadaHoras2" style="min-width: 55px;">
                                                    <option value="">--</option>
                                                    <option value="01">01</option>
                                                    <option value="02">02</option>
                                                    <option value="03">03</option>
                                                    <option value="04">04</option>
                                                    <option value="05">05</option>
                                                    <option value="06">06</option>
                                                    <option value="07">07</option>
                                                    <option value="08">08</option>
                                                    <option value="09">09</option>
                                                    <option value="10">10</option>
                                                    <option value="11">11</option>
                                                    <option value="12">12</option>
                                                </select>
                                                <span class="input-group-text px-1">:</span>
                                                <select class="form-select" id="horaProgramadaMinutos2" style="min-width: 55px;">
                                                    <option value="00">00</option>
                                                    <option value="15">15</option>
                                                    <option value="30">30</option>
                                                    <option value="45">45</option>
                                                </select>
                                                <select class="form-select" id="horaProgramadaPeriodo2" style="min-width: 55px;">
                                                    <option value="AM">AM</option>
                                                    <option value="PM">PM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-1">
                                        <small class="text-muted fst-italic" id="infoProgramacion" style="font-size: 0.8em;"></small>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 mb-3">
                                    <button id="btnProgramarEnvio" class="btn btn-success btn-sm">
                                        <i class="fas fa-save me-1"></i>Guardar Programación
                                    </button>
                                    <button id="btnEliminarProgramacion" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash me-1"></i>Eliminar Programación
                                    </button>
                                </div>

                                <div class="p-2 bg-light rounded border">
                                    <small class="text-muted" style="font-size: 0.8em;">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Actual: <span id="infoConfiguracion" class="fw-bold text-dark">Cargando...</span>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Agregar Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function() {
            // --- FUNCIONES AUXILIARES ---
            function mostrarAlerta(mensaje, tipo, contenedor = '#mensajeResultado') {
                $(contenedor).empty();
                const icono = (tipo === 'success') ? 'fa-check-circle' : 'fa-exclamation-circle';
                const claseAlerta = `alert-${tipo}`;

                const alertaHtml = `
