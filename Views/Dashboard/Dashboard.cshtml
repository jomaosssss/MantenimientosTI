@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model MantenimientosTI.Controllers.DashboardViewModel
@using System.Globalization

<style>
    /* Estilos originales de tarjetas (Hover scale, etc.) */
    .hover-scale {
        transition: all 0.3s ease;
    }

        .hover-scale:hover {
            transform: translateY(-5px);
        }

    .card-bg-primary:hover {
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2) !important;
    }

    .card-bg-success:hover {
        box-shadow: 0 10px 20px rgba(40, 167, 69, 0.2) !important;
    }

    .card-bg-warning:hover {
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.2) !important;
    }

    .card-bg-secondary:hover {
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2) !important;
    }

    .icon-shape {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-count {
        border-radius: 15px;
        min-height: 120px;
        border: none;
    }

    /* ESTILOS MEJORADOS PARA LAS NUEVAS TARJETAS */
    .stats-card {
        border-radius: 12px;
        min-height: 100px;
        border: none;
        transition: all 0.3s ease;
        flex: 1;
        min-width: 0;
    }

    .stats-card-content {
        padding: 0.9rem;
    }

    .stats-badge {
        font-size: 0.75rem;
        padding: 0.35em 0.6em;
        font-weight: 600;
    }

    .stats-number {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .stats-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .cards-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    /* Colores tarjetas nuevas */
    .card-orange {
        background-color: #fd7e14;
    }

    .card-blue {
        background-color: #0d6efd;
    }

    .card-green {
        background-color: #28a745;
    }

    .card-yellow {
        background-color: #ffc107;
    }

    .card-gray {
        background-color: #808080;
    }
    /* Usando gris más oscuro */
    .text-orange {
        color: #fd7e14 !important;
    }
    /* Para texto naranja */
    /* Efectos hover tarjetas nuevas */
    .stats-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    }

    .card-orange:hover {
        box-shadow: 0 6px 15px rgba(253, 126, 20, 0.25) !important;
    }

    .card-blue:hover {
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.25) !important;
    }

    .card-green:hover {
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.25) !important;
    }

    .card-yellow:hover {
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.25) !important;
    }

    .card-gray:hover {
        box-shadow: 0 6px 15px rgba(108, 117, 125, 0.25) !important;
    }
    /* Sombra gris */

    /* Estilos para el selector de hora personalizado */
    .input-group .form-select {
        border-radius: 0;
    }

        .input-group .form-select:first-child {
            border-top-left-radius: 0.375rem;
            border-bottom-left-radius: 0.375rem;
        }

        .input-group .form-select:last-child {
            border-top-right-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        font-weight: 600;
    }

    /* Media queries para responsividad */
    @@media (max-width: 768px) {
        .cards-container {
            gap: 8px;
        }

        .stats-card {
            min-height: 90px;
            flex: 1 1 calc(50% - 8px);
        }

        .stats-number {
            font-size: 1.5rem;
        }

        .stats-icon {
            width: 38px;
            height: 38px;
            font-size: 1.1rem;
        }

        .stats-badge {
            font-size: 0.7rem;
        }
    }

    @@media (max-width: 576px) {
        .stats-card-content {
            padding: 0.7rem;
        }

        .stats-number {
            font-size: 1.4rem;
        }

        .stats-card {
            flex: 1 1 100%;
            min-height: 85px;
        }

        .cards-container {
            gap: 6px;
        }

        .stats-badge {
            font-size: 0.68rem;
        }
    }

    @@media (min-width: 1200px) {
        .stats-card {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Dashboard</h3>
        </div>

        <div class="card-body">
            <div class="cards-container mb-4">
                @{
                    var culturaEs = new CultureInfo("es-ES");
                    var mesActual = DateTime.Now.ToString("MMMM", culturaEs).ToUpper();
                    var mesSiguiente = DateTime.Now.AddMonths(1).ToString("MMMM", culturaEs).ToUpper();
                    var mesAnterior = DateTime.Now.AddMonths(-1).ToString("MMMM", culturaEs).ToUpper();
                }

                <div class="card stats-card card-orange">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-orange mb-1">PENDIENTES @mesAnterior</span>
                                <h2 class="stats-number text-white">@Model.PendientesMesAnteriorCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-exclamation-triangle text-orange"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-blue">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-primary mb-1">PROGRAMADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-alt text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-green">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-success mb-1">TERMINADOS @mesActual</span>
                                <h2 class="stats-number text-white">@Model.TerminadosCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-yellow">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-warning mb-1">PENDIENTES @mesActual</span>
                                <h2 class="stats-number text-white">@Model.PendientesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-spinner text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stats-card card-gray">
                    <div class="card-body stats-card-content d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <span class="badge stats-badge bg-white text-secondary mb-1">PROGRAMADOS @mesSiguiente</span>
                                <h2 class="stats-number text-white">@Model.ProgramadosProximoMesCount</h2>
                            </div>
                            <div class="stats-icon bg-white ms-2 flex-shrink-0">
                                <i class="fas fa-calendar-check text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8 col-md-12">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light border-bottom">
                            <h5 class="mb-0 text-secondary"><i class="fas fa-chart-line me-2"></i> Gráficas de Avance de Mantenimientos</h5>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 300px;">
                            <span class="text-muted fst-italic">Proximamente.</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-12">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light border-bottom">
                            <h5 class="mb-0 text-secondary"><i class="fas fa-envelope me-2"></i>Gestión de Reportes</h5>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="mb-3 pb-3 border-bottom">
                                <h6><i class="fas fa-paper-plane me-1 text-success"></i> Envío Manual</h6>
                                <div id="mensajeResultado" class="mt-2 small"></div>
                                <div class="mb-2 mt-2">
@*                                     <label class="form-label small fw-bold mb-1">Rango de Fechas</label>
 *@                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="date" class="form-control form-control-sm" id="fechaInicio" title="Fecha Inicio">
                                        </div>
                                        <div class="col-6">
                                            <input type="date" class="form-control form-control-sm" id="fechaFin" title="Fecha Fin">
                                        </div>
                                    </div>
                                    <div class="mt-2 px-2 py-1 bg-light rounded border">
                                        <small class="text-muted fst-italic" style="font-size: 0.8em;">
                                            <i class="fas fa-info-circle me-1"></i>
                                            <span id="infoReporte">Selecciona rango...</span>
                                        </small>
                                    </div>
                                </div>
                                <div class="d-grid">
                                    <button id="btnEnviarCorreo" class="btn btn-success btn-sm">
                                        <i class="fas fa-paper-plane me-1"></i>Enviar Ahora
                                    </button>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <h6><i class="fas fa-clock me-1 text-success"></i> Programación Semanal</h6>
                                <div id="mensajeProgramacion" class="mt-2 small"></div>
                                <div class="mb-2 mt-2">
@*                                     <label class="form-label small fw-bold mb-1">¿Cuándo enviar?</label>
 *@                                    <div class="row g-2">
                                        <div class="col-6">
                                            <select class="form-select form-select-sm" id="diaSemanaProgramado">
                                                <option value="Monday">Lunes</option>
                                                <option value="Tuesday">Martes</option>
                                                <option value="Wednesday">Miércoles</option>
                                                <option value="Thursday">Jueves</option>
                                                <option value="Friday">Viernes</option>
                                                <option value="Saturday">Sábado</option>
                                                <option value="Sunday">Domingo</option>
                                            </select>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group input-group-sm">
                                                <select class="form-select" id="horaProgramadaHoras" style="min-width: 55px;">
                                                    <option value="07">07</option>
                                                    <option value="08">08</option>
                                                    <option value="09">09</option>
                                                    <option value="10">10</option>
                                                    <option value="11">11</option>
                                                    <option value="12">12</option>
                                                    <option value="13">13</option>
                                                    <option value="14">14</option>
                                                    <option value="15">15</option>
                                                    <option value="16">16</option>
                                                    <option value="17">17</option>
                                                    <option value="18">18</option>
                                                </select>
                                                <span class="input-group-text px-1">:</span>
                                                <select class="form-select" id="horaProgramadaMinutos" style="min-width: 55px;">
                                                    <option value="00">00</option>
                                                    <option value="15">15</option>
                                                    <option value="30">30</option>
                                                    <option value="45">45</option>
                                                </select>
                                                <select class="form-select" id="horaProgramadaPeriodo" style="min-width: 55px;">
                                                    <option value="AM">AM</option>
                                                    <option value="PM">PM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-1">
                                        <small class="text-muted fst-italic" id="infoProgramacion" style="font-size: 0.8em;"></small>
                                    </div>
                                </div>
                                <div class="d-grid gap-2 mb-3">
                                    <button id="btnProgramarEnvio" class="btn btn-success btn-sm">
                                        <i class="fas fa-save me-1"></i>Guardar Programación
                                    </button>
                                    <button id="btnEliminarProgramacion" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash me-1"></i>Eliminar Programación
                                    </button>
                                </div>
                                <div class="p-2 bg-light rounded border">
                                    <small class="text-muted" style="font-size: 0.8em;">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Actual: <span id="infoConfiguracion" class="fw-bold text-dark">Cargando...</span>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // --- FUNCIONES AUXILIARES ---
            function mostrarAlerta(mensaje, tipo, contenedor = '#mensajeResultado') {
                // Limpiar alertas anteriores en ese contenedor
                $(contenedor).empty();
                // Determinar icono y clase
                const icono = (tipo === 'success') ? 'fa-check-circle' : 'fa-exclamation-circle';
                const claseAlerta = `alert-${tipo}`;

                // Crear y mostrar la nueva alerta
                const alertaHtml = `
                    <div class="alert ${claseAlerta} alert-dismissible fade show" role="alert">
                        <i class="fas ${icono} me-2"></i>
                        ${mensaje}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                $(contenedor).html(alertaHtml);

                // Opcional: Desvanecer alerta de éxito después de unos segundos
                if (tipo === 'success') {
                    setTimeout(() => {
                        $(contenedor).find('.alert').fadeOut(500, function() { $(this).remove(); });
                    }, 5000); // 5 segundos
                }
            }

            // Función para obtener la hora del selector personalizado
            function obtenerHoraSeleccionada() {
                let horas = $('#horaProgramadaHoras').val();
                let minutos = $('#horaProgramadaMinutos').val();
                let periodo = $('#horaProgramadaPeriodo').val();

                // Convertir a formato 24 horas
                if (periodo === 'PM' && horas !== '12') {
                    horas = String(parseInt(horas) + 12);
                } else if (periodo === 'AM' && horas === '12') {
                    horas = '00';
                }

                return `${horas.padStart(2, '0')}:${minutos}`;
            }

            // --- CARGA INICIAL Y CONFIGURACIÓN ---
            function cargarConfiguracionActual() {
                $.get('@Url.Action("ObtenerConfiguracionProgramacion", "Dashboard")')
                    .done(function(response) {
                        if (response.success) {
                            $('#infoConfiguracion').text(response.configuracionActual);
                            if (response.programado) {
                                $('#btnEliminarProgramacion').show();
                            } else {
                                $('#btnEliminarProgramacion').hide();
                            }
                        } else {
                            $('#infoConfiguracion').text('Error al cargar');
                             mostrarAlerta(response.message || 'Error al cargar configuración.', 'danger', '#mensajeProgramacion');
                        }
                    })
                    .fail(function() {
                        $('#infoConfiguracion').text('Error de conexión');
                        mostrarAlerta('Error de conexión al cargar la configuración.', 'danger', '#mensajeProgramacion');
                    });
            }

            function actualizarInfoReporte() {
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();
                if (fechaInicio && fechaFin) {
                    try {
                        const inicio = new Date(fechaInicio + 'T00:00:00');
                        const fin = new Date(fechaFin + 'T00:00:00');
                        if (inicio > fin) {
                             $('#infoReporte').text('La fecha de inicio no puede ser mayor a la fecha fin.');
                             return;
                        }
                        const diffTime = Math.abs(fin - inicio);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; // +1 para incluir ambos días
                        $('#infoReporte').text(`Reporte del ${inicio.toLocaleDateString('es-ES')} hasta el ${fin.toLocaleDateString('es-ES')} (${diffDays} días)`);
                    } catch (e) {
                         $('#infoReporte').text('Fechas inválidas.');
                    }
                } else {
                    $('#infoReporte').text('Selecciona un rango de fechas para generar el reporte');
                }
            }

             function actualizarInfoProgramacion() {
                const diaVal = $('#diaSemanaProgramado').val();
                const hora = obtenerHoraSeleccionada();
                const diaTexto = $('#diaSemanaProgramado option:selected').text();

                if (diaVal && hora) {
                    try{
                        // Formatear hora a AM/PM
                        const horaDate = new Date(`1970-01-01T${hora}`);
                        const horaFormateada = horaDate.toLocaleTimeString('es-ES', {
                            hour: '2-digit', minute: '2-digit', hour12: true
                        });
                        $('#infoProgramacion').text(`El reporte se enviará cada ${diaTexto} a las ${horaFormateada}`);
                    } catch(e){
                         $('#infoProgramacion').text('Hora inválida.');
                    }
                } else {
                    $('#infoProgramacion').text('Selecciona día y hora.');
                }
            }

            function establecerValoresPorDefecto() {
                const ahora = new Date();
                // Mes actual para envío manual
                const primerDiaMes = new Date(ahora.getFullYear(), ahora.getMonth(), 1);
                const ultimoDiaMes = new Date(ahora.getFullYear(), ahora.getMonth() + 1, 0);
                $('#fechaInicio').val(primerDiaMes.toISOString().split('T')[0]);
                $('#fechaFin').val(ultimoDiaMes.toISOString().split('T')[0]);

                // Programación semanal por defecto (Viernes 7:30 AM)
                $('#diaSemanaProgramado').val('Friday');
                $('#horaProgramadaHoras').val('07');
                $('#horaProgramadaMinutos').val('30');
                $('#horaProgramadaPeriodo').val('AM');

                // Actualizar textos informativos
                actualizarInfoReporte();
                actualizarInfoProgramacion();
            }

            // --- MANEJADORES DE EVENTOS ---
            $('#fechaInicio, #fechaFin').change(actualizarInfoReporte);
            $('#diaSemanaProgramado, #horaProgramadaHoras, #horaProgramadaMinutos, #horaProgramadaPeriodo').change(actualizarInfoProgramacion);

            // Botón Enviar Manual
            $('#btnEnviarCorreo').click(function() {
                const btn = $(this);
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();

                if (!fechaInicio || !fechaFin) {
                    mostrarAlerta('Por favor, selecciona el rango de fechas.', 'warning', '#mensajeResultado'); return;
                }
                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    mostrarAlerta('La fecha de inicio no puede ser mayor a la fecha fin.', 'warning', '#mensajeResultado'); return;
                }

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Enviando...');
                $('#mensajeResultado').empty();

                $.ajax({
                    url: '@Url.Action("EnviarCorreoPrueba", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ fechaInicio: fechaInicio, fechaFin: fechaFin }),
                    success: function(response) {
                        mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeResultado');
                    },
                    error: function(xhr) {
                         const errorMsg = xhr.responseJSON?.message || 'Error de conexión al enviar el correo.';
                         mostrarAlerta(errorMsg, 'danger', '#mensajeResultado');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Enviar Ahora');
                    }
                });
            });

            // Botón Programar Semanal
            $('#btnProgramarEnvio').click(function() {
                const btn = $(this);
                const diaSemana = $('#diaSemanaProgramado').val();
                const horaProgramada = obtenerHoraSeleccionada();

                if (!diaSemana || !horaProgramada) {
                    mostrarAlerta('Por favor, selecciona el día y la hora.', 'warning', '#mensajeProgramacion'); return;
                }

                 // Validar formato de hora simple (HH:MM)
                 if (!/^\d{2}:\d{2}$/.test(horaProgramada)) {
                     mostrarAlerta('El formato de hora debe ser HH:mm (ej. 09:30).', 'warning', '#mensajeProgramacion'); return;
                 }


                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Programando...');
                $('#mensajeProgramacion').empty();

                $.ajax({
                    url: '@Url.Action("ProgramarEnvioCorreo", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ diaSemana: diaSemana, horaProgramada: horaProgramada }),
                    success: function(response) {
                        mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeProgramacion');
                        if(response.success) {
                             cargarConfiguracionActual();
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Error de conexión al programar.';
                         mostrarAlerta(errorMsg, 'danger', '#mensajeProgramacion');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-save me-2"></i>Guardar Programación');
                    }
                });
            });

            // Botón Eliminar Programación
            $('#btnEliminarProgramacion').click(function() {
                const btn = $(this);

                Swal.fire({
                    title: '¿Eliminar Programación?',
                    text: "Se quitará el envío semanal automático.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Eliminando...');
                        $('#mensajeProgramacion').empty();

                        $.ajax({
                            url: '@Url.Action("EliminarProgramacion", "Dashboard")',
                            type: 'POST',
                            success: function(response) {
                                mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeProgramacion');
                                if(response.success) {
                                     cargarConfiguracionActual(); // Actualizar la info y ocultar el botón
                                }
                            },
                            error: function(xhr) {
                                const errorMsg = xhr.responseJSON?.message || 'Error de conexión al eliminar.';
                                mostrarAlerta(errorMsg, 'danger', '#mensajeProgramacion');
                            },
                            complete: function() {
                                // El botón se ocultará si la eliminación fue exitosa (vía cargarConfiguracionActual),
                                // así que solo re-habilitamos si hubo error.
                                if (!$('#btnEliminarProgramacion').is(':hidden')) {
                                     btn.prop('disabled', false).html('<i class="fas fa-trash me-2"></i>Eliminar Programación');
                                }
                            }
                        });
                    }
                });
            });

            // --- INICIALIZACIÓN ---
            establecerValoresPorDefecto();
            cargarConfiguracionActual();
        });
    </script>
}