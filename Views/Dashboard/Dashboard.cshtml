            function actualizarGraficas(datosGraficas, tipo) {
                // Destruir gráficas existentes
                $('canvas[id^="chart-"]').each(function() {
                    const chart = Chart.getChart(this);
                    if (chart) {
                        chart.destroy();
                    }
                });

                // Limpiar contenedor de gráficas
                const contenedorGraficas = $('#contenedorGraficas');
                contenedorGraficas.empty();

                // Filtrar solo elementos con datos
                const datosConGraficas = datosGraficas.filter(item => item.tieneDatos);

                // Crear nuevas gráficas según el tipo
                if (datosConGraficas.length === 0) {
                    contenedorGraficas.html(`
                        <div class="col-12">
                            <div class="text-center py-4">
                                <span class="text-muted fst-italic">No hay datos disponibles para mostrar.</span>
                            </div>
                        </div>
                    `);
                    return;
                }

                datosConGraficas.forEach((item, index) => {
                    const id = tipo === 'agencias' ? item.agencia : (tipo === 'centros' ? item.centro : item.zona);
                    const nombre = tipo === 'agencias' ? item.nombreAgencia : (tipo === 'centros' ? item.nombreCentro : item.nombreZona);

                    const graficaHtml = `
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 card-fade-in" style="animation-delay: ${index * 0.1}s">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light py-2">
                                    <h6 class="mb-0 text-center text-dark" style="font-size: 0.85rem; font-weight: normal;">${nombre}</h6>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <div class="chart-container flex-grow-1 position-relative">
                                        <canvas id="chart-${id}"
                                                data-item='${JSON.stringify(item)}'
                                                data-tiene-datos="true"
                                                data-tipo="${tipo}"></canvas>
                                    </div>
                                    <div class="legend-container mt-2">
                                        <div class="d-flex justify-content-center flex-wrap gap-2">
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-success me-1"></div>
                                                <small class="text-muted">Terminados: ${item.terminados}</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-warning me-1"></div>
                                                <small class="text-muted">Pendientes: ${item.pendientes}</small>
                                            </div>
                                            ${item.otros > 0 ? `
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-secondary me-1"></div>
                                                <small class="text-muted">Otros: ${item.otros}</small>
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    contenedorGraficas.append(graficaHtml);
                });

                // Re-inicializar gráficas después de un pequeño delay para permitir la animación CSS
                setTimeout(inicializarGraficas, 300);
            }

            function inicializarGraficas() {
                $('canvas[id^="chart-"]').each(function(index) {
                    const canvas = $(this)[0];
                    const item = $(this).data('item');
                    const tieneDatos = $(this).data('tiene-datos');

                    // Solo inicializar si tiene datos
                    if (!tieneDatos || !item) {
                        return;
                    }

                    const total = item.terminados + item.pendientes + item.otros;
                    const data = {
                        labels: ['Terminados', 'Pendientes', 'Otros'],
                        datasets: [{
                            data: [item.terminados, item.pendientes, item.otros],
                            backgroundColor: [
                                '#28a745', // Verde
                                '#ffc107', // Amarillo
                                '#6c757d'  // Gris
                            ],
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    };

                    const config = {
                        type: 'pie',
                        data: data,
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const label = context.label || '';
                                            const value = context.raw || 0;
                                            const percentage = Math.round((value / total) * 100);
                                            return `${label}: ${value} (${percentage}%)`;
                                        }
                                    }
                                }
                            },
                            animation: {
                                duration: 1000,
                                easing: 'easeOutQuart',
                                animateScale: true,
                                animateRotate: true
                            }
                        }
                    };

                    // Destruir gráfica existente si hay una
                    const chartExistente = Chart.getChart(canvas);
                    if (chartExistente) {
                        chartExistente.destroy();
                    }

                    // Agregar delay escalonado para animaciones
                    setTimeout(() => {
                        new Chart(canvas, config);
                        $(canvas).addClass('chart-fade-in');
                    }, index * 200);
                });
            }

