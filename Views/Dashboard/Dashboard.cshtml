            function actualizarInfoFiltroGraficas() {
                const fechaInicio = $('#filtroFechaInicio').val();
                const fechaFin = $('#filtroFechaFin').val();
                const zonaSeleccionada = $('#filtroZona').val();
                const zonaTexto = $('#filtroZona option:selected').text();

