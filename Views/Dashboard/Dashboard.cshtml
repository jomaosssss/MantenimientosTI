@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function() {
            // Variables para almacenar las gráficas por tipo de equipo
            let chartCfematicos = null;
            let chartEquiposAC = null;
            let chartEquiposComputo = null;

            function mostrarAlerta(mensaje, tipo, contenedor = '#mensajeGraficas') {
                $(contenedor).empty();
                const icono = (tipo === 'success') ? 'fa-check-circle' : 'fa-exclamation-circle';
                const claseAlerta = `alert-${tipo}`;

                const alertaHtml = `
                    <div class="alert ${claseAlerta} alert-dismissible fade show" role="alert">
                        <i class="fas ${icono} me-2"></i>
                        ${mensaje}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                $(contenedor).html(alertaHtml);

                if (tipo === 'success') {
                    setTimeout(() => {
                        $(contenedor).find('.alert').fadeOut(500, function() { $(this).remove(); });
                    }, 5000);
                }
            }

            function cargarUsuariosAdministradores() {
                $.get('@Url.Action("ObtenerUsuariosAdministradores", "Dashboard")')
                    .done(function(response) {
                        if (response.success) {
                            actualizarListaUsuarios(response.usuarios);
                        } else {
                            $('#listaUsuarios').html('<div class="text-danger small">Error al cargar usuarios</div>');
                        }
                    })
                    .fail(function() {
                        $('#listaUsuarios').html('<div class="text-danger small">Error de conexión</div>');
                    });
            }

            function actualizarListaUsuarios(usuarios) {
                const listaUsuarios = $('#listaUsuarios');

                if (usuarios.length === 0) {
                    listaUsuarios.html('<div class="text-muted small">No hay usuarios administradores registrados</div>');
                    return;
                }

                let html = '';
                usuarios.forEach(usuario => {
                    const nombreCompleto = `${usuario.nombre} ${usuario.apellidoP} ${usuario.apellidoM}`;
                    html += `
                        <div class="form-check">
                            <input class="form-check-input usuario-checkbox" type="checkbox"
                                   value="${usuario.rpe}" id="usuario-${usuario.rpe}">
                            <label class="form-check-label" for="usuario-${usuario.rpe}">
                                ${nombreCompleto} <small class="text-muted">(${usuario.correo})</small>
                            </label>
                        </div>
                    `;
                });

                listaUsuarios.html(html);
            }

            function obtenerUsuariosSeleccionados() {
                const usuariosSeleccionados = [];
                $('.usuario-checkbox:checked').each(function() {
                    usuariosSeleccionados.push($(this).val());
                });
                return usuariosSeleccionados;
            }

            function obtenerHorasSeleccionadas() {
                const horas = [];

                // Primer horario (obligatorio)
                const hora1 = obtenerHoraSeleccionada(1);
                if (hora1) {
                    horas.push(hora1);
                }

                // Segundo horario (opcional)
                const hora2 = obtenerHoraSeleccionada(2);
                if (hora2) {
                    horas.push(hora2);
                }

                return horas;
            }

            function obtenerHoraSeleccionada(numero) {
                let horas = $(`#horaProgramadaHoras${numero}`).val();
                let minutos = $(`#horaProgramadaMinutos${numero}`).val();
                let periodo = $(`#horaProgramadaPeriodo${numero}`).val();

                // Si no se seleccionó hora para el segundo horario
                if (numero === 2 && !horas) {
                    return null;
                }

                // Convertir a número para operaciones matemáticas
                let horasNum = parseInt(horas);

                // Lógica de conversión AM/PM a 24 horas
                if (periodo === 'PM') {
                    if (horasNum !== 12) {
                        horasNum += 12;
                    }
                    // Si es 12 PM, se queda como 12 (mediodía)
                } else if (periodo === 'AM') {
                    if (horasNum === 12) {
                        horasNum = 0; // 12 AM = medianoche
                    }
                    // Para otras horas AM, se quedan igual
                }

                // Formatear a string con 2 dígitos
                return `${horasNum.toString().padStart(2, '0')}:${minutos}`;
            }

            function actualizarInfoProgramacion() {
                const diaVal = $('#diaSemanaProgramado').val();
                const horas = obtenerHorasSeleccionadas();
                const diaTexto = $('#diaSemanaProgramado option:selected').text();

                if (diaVal && horas.length > 0) {
                    try {
                        const horasFormateadas = horas.map(hora => {
                            // Validar formato de hora
                            if (!/^([01]?[0-9]|2[0-3]):[0-5][0-9]$/.test(hora)) {
                                throw new Error(`Formato de hora inválido: ${hora}`);
                            }

                            const [horasStr, minutosStr] = hora.split(':');
                            let horasNum = parseInt(horasStr);
                            const minutosNum = parseInt(minutosStr);

                            // Convertir a formato 12 horas para mostrar
                            let periodo = 'AM';
                            if (horasNum >= 12) {
                                periodo = 'PM';
                                if (horasNum > 12) {
                                    horasNum -= 12;
                                }
                            }
                            if (horasNum === 0) {
                                horasNum = 12; // Medianoche
                            }

                            return `${horasNum}:${minutosStr.toString().padStart(2, '0')} ${periodo}`;
                        });

                        let mensaje = `El reporte se enviará a todos los administradores cada ${diaTexto} `;

                        if (horasFormateadas.length === 1) {
                            mensaje += `a las ${horasFormateadas[0]}`;
                        } else {
                            mensaje += `a las ${horasFormateadas[0]} y ${horasFormateadas[1]}`;
                        }

                        $('#infoProgramacion').text(mensaje);
                    } catch(e) {
                        $('#infoProgramacion').text('Hora inválida. Verifica los horarios.');
                        console.error('Error al formatear horas:', e);
                    }
                } else {
                    $('#infoProgramacion').text('Selecciona día y al menos un horario.');
                }
            }

            // --- CARGA INICIAL Y CONFIGURACIÓN ---
            function cargarConfiguracionActual() {
                $.get('@Url.Action("ObtenerConfiguracionProgramacion", "Dashboard")')
                    .done(function(response) {
                        if (response.success) {
                            $('#infoConfiguracion').text(response.configuracionActual);
                            if (response.programado) {
                                $('#btnEliminarProgramacion').show();
                            } else {
                                $('#btnEliminarProgramacion').hide();
                            }
                        } else {
                            $('#infoConfiguracion').text('Error al cargar');
                             mostrarAlerta(response.message || 'Error al cargar configuración.', 'danger', '#mensajeProgramacion');
                        }
                    })
                    .fail(function() {
                        $('#infoConfiguracion').text('Error de conexión');
                        mostrarAlerta('Error de conexión al cargar la configuración.', 'danger', '#mensajeProgramacion');
                    });
            }

            function actualizarInfoReporte() {
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();
                if (fechaInicio && fechaFin) {
                    try {
                        const inicio = new Date(fechaInicio + 'T00:00:00');
                        const fin = new Date(fechaFin + 'T00:00:00');
                        if (inicio > fin) {
                             $('#infoReporte').text('La fecha de inicio no puede ser mayor a la fecha fin.');
                             return;
                        }
                        const diffTime = Math.abs(fin - inicio);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                        $('#infoReporte').text(`El reporte se enviará del ${inicio.toLocaleDateString('es-ES')} hasta el ${fin.toLocaleDateString('es-ES')} (${diffDays} días) a los usuarios seleccionados.`);
                    } catch (e) {
                         $('#infoReporte').text('Fechas inválidas.');
                    }
                } else {
                    $('#infoReporte').text('Selecciona un rango de fechas para generar el reporte');
                }
            }

            // --- FUNCIONES PARA FILTRAR GRÁFICAS ---
            function establecerFechasPorDefectoGraficas() {
                const hoy = new Date();
                const primerDiaMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
                const ultimoDiaMes = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0);

                $('#filtroFechaInicio').val(primerDiaMes.toISOString().split('T')[0]);
                $('#filtroFechaFin').val(ultimoDiaMes.toISOString().split('T')[0]);
                actualizarInfoFiltroGraficas();
            }

            function actualizarInfoFiltroGraficas() {
                const fechaInicio = $('#filtroFechaInicio').val();
                const fechaFin = $('#filtroFechaFin').val();
                const zonaSeleccionada = $('#filtroZona').val();
                const zonaTexto = $('#filtroZona option:selected').text();

                if (fechaInicio && fechaFin) {
                    try {
                        const inicio = new Date(fechaInicio + 'T00:00:00');
                        const fin = new Date(fechaFin + 'T00:00:00');
                        if (inicio > fin) {
                            $('#infoFiltroGraficas').text('La fecha de inicio no puede ser mayor a la fecha fin.');
                            return;
                        }
                        const diffTime = Math.abs(fin - inicio);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

                        if (zonaSeleccionada === 'TODAS') {
                            $('#infoFiltroGraficas').text(`Mostrando datos del ${inicio.toLocaleDateString('es-ES')} al ${fin.toLocaleDateString('es-ES')} (${diffDays} días) para TODAS las zonas`);
                        } else {
                            $('#infoFiltroGraficas').text(`Mostrando datos del ${inicio.toLocaleDateString('es-ES')} al ${fin.toLocaleDateString('es-ES')} (${diffDays} días) para la zona: ${zonaTexto}`);
                        }
                    } catch (e) {
                        $('#infoFiltroGraficas').text('Fechas inválidas.');
                    }
                } else {
                    if (zonaSeleccionada === 'TODAS') {
                        $('#infoFiltroGraficas').text(`Mostrando datos del mes actual para TODAS las zonas`);
                    } else {
                        $('#infoFiltroGraficas').text(`Mostrando datos del mes actual para la zona: ${zonaTexto}`);
                    }
                }
            }

            function cargarGraficasConFiltroCompleto(fechaInicio, fechaFin, zonaSeleccionada) {
                const btn = $('#btnFiltrarGraficas');
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>');

                // Limpiar mensajes anteriores
                $('#mensajeGraficas').empty();

                const url = '@Url.Action("ObtenerDatosGraficasFiltroCompleto", "Dashboard")';
                const data = {
                    fechaInicio: fechaInicio,
                    fechaFin: fechaFin,
                    zonaSeleccionada: zonaSeleccionada,
                    tipoEquipo: "TODOS"
                };

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            if (zonaSeleccionada === 'TODAS') {
                                // Mostrar gráficas por zona
                                $('#contenedorGraficasTipos').hide();
                                $('#contenedorGraficasZonas').show();
                                actualizarGraficas(response.datosGraficas, response.tipo);
                            } else {
                                // Mostrar gráficas por tipo de equipo
                                $('#contenedorGraficasZonas').hide();
                                $('#contenedorGraficasTipos').show();

                                // Agregar animación escalonada a las tarjetas de tipo de equipo
                                $('#contenedorGraficasTipos .tipo-equipo-card').each(function(index) {
                                    $(this).css({
                                        'opacity': '0',
                                        'transform': 'translateY(20px)',
                                        'animation-delay': (index * 0.1) + 's'
                                    });
                                });

                                setTimeout(() => {
                                    actualizarGraficasPorTipoEquipo(response.datosGraficas, zonaSeleccionada);
                                }, 300);
                            }
                        } else {
                            mostrarAlerta(response.message || 'Error al cargar las gráficas.', 'danger', '#mensajeGraficas');
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Error de conexión al cargar las gráficas.';
                        mostrarAlerta(errorMsg, 'danger', '#mensajeGraficas');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-search me-1"></i>');
                    }
                });
            }

        function actualizarGraficasPorTipoEquipo(datosGraficas, zonaSeleccionada) {
            // Destruir gráficas existentes
            if (chartCfematicos) chartCfematicos.destroy();
            if (chartEquiposAC) chartEquiposAC.destroy();
            if (chartEquiposComputo) chartEquiposComputo.destroy();

            // Procesar datos para cada tipo de equipo
            const datosCfematicos = datosGraficas.find(d => d.tipoEquipo === 'CFEMÁTICOS') || { programados: 0, terminados: 0, pendientes: 0, otros: 0 };
            const datosEquiposAC = datosGraficas.find(d => d.tipoEquipo === 'EQUIPOS_AC') || { programados: 0, terminados: 0, pendientes: 0, otros: 0 };
            const datosEquiposComputo = datosGraficas.find(d => d.tipoEquipo === 'EQUIPOS_COMPUTO') || { programados: 0, terminados: 0, pendientes: 0, otros: 0 };

            // Actualizar estadísticas de las tarjetas
            actualizarEstadisticas('cfematicos', datosCfematicos);
            actualizarEstadisticas('equipos-ac', datosEquiposAC);
            actualizarEstadisticas('equipos-computo', datosEquiposComputo);

            // Actualizar tabla de resumen
            actualizarTablaResumen(datosCfematicos, datosEquiposAC, datosEquiposComputo);

            // Crear nuevas gráficas con animación escalonada
            setTimeout(() => {
                chartCfematicos = crearGraficaPastel('chart-cfematicos', datosCfematicos, ['#28a745', '#ffc107', '#6c757d'], 'CFEMÁTICOS', zonaSeleccionada);
            }, 100);

            setTimeout(() => {
                chartEquiposAC = crearGraficaPastel('chart-equipos-ac', datosEquiposAC, ['#28a745', '#ffc107', '#6c757d'], 'EQUIPOS_AC', zonaSeleccionada);
            }, 300);

            setTimeout(() => {
                chartEquiposComputo = crearGraficaPastel('chart-equipos-computo', datosEquiposComputo, ['#28a745', '#ffc107', '#6c757d'], 'EQUIPOS_COMPUTO', zonaSeleccionada);
            }, 500);
        }

                // Nueva función para actualizar la tabla de resumen
        function actualizarTablaResumen(datosCfematicos, datosEquiposAC, datosEquiposComputo) {
            // CFEMÁTICOS
            const cfematicosProgramados = datosCfematicos.programados || 0;
            const cfematicosTerminados = datosCfematicos.terminados || 0;
            const cfematicosPendientes = datosCfematicos.pendientes || 0;
            const cfematicosPorcentaje = cfematicosProgramados > 0 ? Math.round((cfematicosTerminados / cfematicosProgramados) * 100) : 0;

            $('#tabla-cfematicos-programados').text(cfematicosProgramados);
            $('#tabla-cfematicos-terminados').text(cfematicosTerminados);
            $('#tabla-cfematicos-pendientes').text(cfematicosPendientes);
            $('#tabla-cfematicos-porcentaje').text(cfematicosPorcentaje + '%');

            // EQUIPOS DE ATENCIÓN A CLIENTES
            const equiposACProgramados = datosEquiposAC.programados || 0;
            const equiposACTerminados = datosEquiposAC.terminados || 0;
            const equiposACPendientes = datosEquiposAC.pendientes || 0;
            const equiposACPorcentaje = equiposACProgramados > 0 ? Math.round((equiposACTerminados / equiposACProgramados) * 100) : 0;

            $('#tabla-equipos-ac-programados').text(equiposACProgramados);
            $('#tabla-equipos-ac-terminados').text(equiposACTerminados);
            $('#tabla-equipos-ac-pendientes').text(equiposACPendientes);
            $('#tabla-equipos-ac-porcentaje').text(equiposACPorcentaje + '%');

            // EQUIPOS DE CÓMPUTO
            const equiposComputoProgramados = datosEquiposComputo.programados || 0;
            const equiposComputoTerminados = datosEquiposComputo.terminados || 0;
            const equiposComputoPendientes = datosEquiposComputo.pendientes || 0;
            const equiposComputoPorcentaje = equiposComputoProgramados > 0 ? Math.round((equiposComputoTerminados / equiposComputoProgramados) * 100) : 0;

            $('#tabla-equipos-computo-programados').text(equiposComputoProgramados);
            $('#tabla-equipos-computo-terminados').text(equiposComputoTerminados);
            $('#tabla-equipos-computo-pendientes').text(equiposComputoPendientes);
            $('#tabla-equipos-computo-porcentaje').text(equiposComputoPorcentaje + '%');

            // TOTALES
            const totalProgramados = cfematicosProgramados + equiposACProgramados + equiposComputoProgramados;
            const totalTerminados = cfematicosTerminados + equiposACTerminados + equiposComputoTerminados;
            const totalPendientes = cfematicosPendientes + equiposACPendientes + equiposComputoPendientes;
            const totalPorcentaje = totalProgramados > 0 ? Math.round((totalTerminados / totalProgramados) * 100) : 0;

            $('#tabla-total-programados').text(totalProgramados);
            $('#tabla-total-terminados').text(totalTerminados);
            $('#tabla-total-pendientes').text(totalPendientes);
            $('#tabla-total-porcentaje').text(totalPorcentaje + '%');
        }

        function actualizarEstadisticas(prefijo, datos) {
            const terminados = datos.terminados || 0;
            const pendientes = datos.pendientes || 0;

            // Actualizar elementos HTML de las tarjetas
            $(`#${prefijo}-terminados`).text(terminados);
            $(`#${prefijo}-pendientes`).text(pendientes);
        }

            function crearGraficaPastel(canvasId, datos, colores, tipoEquipo, zonaSeleccionada) {
                const ctx = document.getElementById(canvasId);
                const chartExistente = Chart.getChart(ctx);
                if (chartExistente) {
                    chartExistente.destroy();
                }

                // Aplicar animación al canvas
                $(ctx).addClass('chart-fade-in');

                const data = {
                    labels: ['Terminados', 'Pendientes', 'Otros'],
                    datasets: [{
                        data: [datos.terminados || 0, datos.pendientes || 0, datos.otros || 0],
                        backgroundColor: colores,
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                };

                const config = {
                    type: 'pie',
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                        return `${label}: ${value} (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        animation: {
                            duration: 1000,
                            easing: 'easeOutQuart',
                            animateScale: true,
                            animateRotate: true
                        },
                        // NUEVO: Evento para hacer clic en los segmentos (SOLO PARA GRÁFICAS DE TIPO DE EQUIPO)
                        onClick: (evt, elements, chart) => {
                            if (elements.length > 0) {
                                const segmentIndex = elements[0].index;
                                const estado = chart.data.labels[segmentIndex];
                                const cantidad = chart.data.datasets[0].data[segmentIndex];

                                // Obtener el nombre de la zona desde el dropdown
                                const zonaSeleccionada = $('#filtroZona').val();
                                let nombreZona = zonaSeleccionada;
                                if (zonaSeleccionada !== 'TODAS') {
                                    const option = $(`#filtroZona option[value="${zonaSeleccionada}"]`);
                                    if (option.length > 0) {
                                        nombreZona = option.text();
                                    }
                                } else {
                                    nombreZona = 'TODAS LAS ZONAS';
                                }

                                // Mostrar modal con los registros
                                mostrarRegistrosModal({
                                    tipo: "tiposEquipo",
                                    clave: tipoEquipo,
                                    nombre: tipoEquipo,
                                    estado: estado,
                                    cantidad: cantidad,
                                    fechaInicio: $('#filtroFechaInicio').val(),
                                    fechaFin: $('#filtroFechaFin').val(),
                                    zonaSeleccionada: zonaSeleccionada,
                                    nombreZona: nombreZona, // Agregar el nombre de la zona
                                    tipoEquipo: "TODOS"
                                });
                            }
                        }
                    }
                };

                return new Chart(ctx, config);
            }

            // NUEVA FUNCIÓN: Mostrar modal con registros
        function mostrarRegistrosModal(datos) {
            const modal = new bootstrap.Modal(document.getElementById('registrosModal'));
            const tituloModal = document.getElementById('registrosModalLabel');
            const subtituloModal = document.getElementById('modalSubtitulo');
            const cuerpoTabla = document.getElementById('cuerpoTablaRegistros');
            const sinRegistros = document.getElementById('modalSinRegistros');
            const cargando = document.getElementById('modalCargando');

            // Obtener el nombre de la zona desde el dropdown
            const zonaSeleccionada = datos.zonaSeleccionada;
            let nombreZona = zonaSeleccionada;

            // Buscar el nombre de la zona en el dropdown
            if (zonaSeleccionada !== 'TODAS') {
                const option = $(`#filtroZona option[value="${zonaSeleccionada}"]`);
                if (option.length > 0) {
                    nombreZona = option.text();
                }
            } else {
                nombreZona = 'TODAS LAS ZONAS';
            }

            // Configurar título y subtítulo del modal
            tituloModal.textContent = `ZONA ${nombreZona}`;
            subtituloModal.textContent = `${datos.estado}: ${datos.cantidad} mantenimientos`;

            // Mostrar estado de carga
            cargando.style.display = 'block';
            sinRegistros.style.display = 'none';
            cuerpoTabla.innerHTML = '';

            // Mostrar modal
            modal.show();

            // Obtener registros del servidor
            $.ajax({
                url: '@Url.Action("ObtenerRegistrosPorEstado", "Dashboard")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    tipo: datos.tipo,
                    clave: datos.clave,
                    estado: datos.estado,
                    fechaInicio: datos.fechaInicio,
                    fechaFin: datos.fechaFin,
                    zonaSeleccionada: datos.zonaSeleccionada,
                    tipoEquipo: datos.tipoEquipo
                }),
                success: function(response) {
                    cargando.style.display = 'none';

                    if (response.success && response.registros && response.registros.length > 0) {
                        // Construir tabla con registros
                        let html = '';
                        response.registros.forEach(registro => {
                            html += `
                                <tr>
                                    <td>${registro.numActFijo || 'N/A'}</td>
                                    <td>${registro.nombreAgencia || 'N/A'}</td>
                                    <td>${registro.nombreCentro || 'N/A'}</td>
                                    <td>${registro.fechaProgramada || 'N/A'}</td>
                                    <td>${registro.fechaTerminada || 'N/A'}</td>
                                    <td>
                                        <span class="badge ${obtenerClaseEstatus(registro.estatus)}">
                                            ${registro.estatus || 'N/A'}
                                        </span>
                                    </td>
                                    <td>${registro.tipoEquipo || 'N/A'}</td>
                                </tr>
                            `;
                        });
                        cuerpoTabla.innerHTML = html;
                        sinRegistros.style.display = 'none';
                    } else {
                        cuerpoTabla.innerHTML = '';
                        sinRegistros.style.display = 'block';
                    }
                },
                error: function(xhr) {
                    cargando.style.display = 'none';
                    cuerpoTabla.innerHTML = '';
                    sinRegistros.style.display = 'block';
                    console.error('Error al cargar registros:', xhr);
                }
            });
        }

            // Función auxiliar para determinar clase CSS del estatus
            function obtenerClaseEstatus(estatus) {
                if (!estatus) return 'bg-secondary';

                const estatusLower = estatus.toLowerCase();
                if (estatusLower.includes('terminado')) return 'bg-success';
                if (estatusLower.includes('pendiente') || estatusLower.includes('pre-cancelado')) return 'bg-warning';
                if (estatusLower.includes('cancelado')) return 'bg-danger';
                return 'bg-secondary';
            }

            // --- FUNCIONES ORIGINALES PARA GRÁFICAS POR ZONA ---
            function actualizarGraficas(datosGraficas, tipo) {
                // Destruir gráficas existentes
                $('canvas[id^="chart-"]').each(function() {
                    const chart = Chart.getChart(this);
                    if (chart) {
                        chart.destroy();
                    }
                });

                // Limpiar contenedor de gráficas
                const contenedorGraficas = $('#contenedorGraficas');
                contenedorGraficas.empty();

                // Filtrar solo elementos con datos
                const datosConGraficas = datosGraficas.filter(item => item.tieneDatos);

                // Crear nuevas gráficas según el tipo
                if (datosConGraficas.length === 0) {
                    contenedorGraficas.html(`
                        <div class="col-12">
                            <div class="text-center py-4">
                                <span class="text-muted fst-italic">No hay datos disponibles para mostrar con los filtros seleccionados.</span>
                            </div>
                        </div>
                    `);
                    return;
                }

                datosConGraficas.forEach((item, index) => {
                    const id = tipo === 'agencias' ? item.agencia : item.zona;
                    const nombre = tipo === 'agencias' ? item.nombreAgencia : item.nombreZona;

                    const graficaHtml = `
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 card-fade-in" style="animation-delay: ${index * 0.1}s">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light py-2">
                                    <h6 class="mb-0 text-center text-dark" style="font-size: 0.85rem; font-weight: normal;">${nombre}</h6>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <div class="chart-container flex-grow-1 position-relative">
                                        <canvas id="chart-${id}"
                                                data-item='${JSON.stringify(item)}'
                                                data-tiene-datos="true"
                                                data-tipo="${tipo}"></canvas>
                                    </div>
                                    <div class="legend-container mt-2">
                                        <div class="d-flex justify-content-center flex-wrap gap-2">
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-success me-1"></div>
                                                <small class="text-muted">Terminados: ${item.terminados}</small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-warning me-1"></div>
                                                <small class="text-muted">Pendientes: ${item.pendientes}</small>
                                            </div>
                                            ${item.otros > 0 ? `
                                            <div class="d-flex align-items-center">
                                                <div class="color-box bg-secondary me-1"></div>
                                                <small class="text-muted">Otros: ${item.otros}</small>
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    contenedorGraficas.append(graficaHtml);
                });

                // Re-inicializar gráficas después de un pequeño delay para permitir la animación CSS
                setTimeout(inicializarGraficas, 300);
            }

            function inicializarGraficas() {
                $('canvas[id^="chart-"]').each(function(index) {
                    const canvas = $(this)[0];
                    const item = $(this).data('item');
                    const tieneDatos = $(this).data('tiene-datos');
                    const tipo = $(this).data('tipo');

                    if (!tieneDatos || !item) {
                        return;
                    }

                    const total = item.terminados + item.pendientes + item.otros;
                    const data = {
                        labels: ['Terminados', 'Pendientes', 'Otros'],
                        datasets: [{
                            data: [item.terminados, item.pendientes, item.otros],
                            backgroundColor: [
                                '#28a745', // Verde
                                '#ffc107', // Amarillo
                                '#6c757d'  // Gris
                            ],
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    };

                    const config = {
                        type: 'pie',
                        data: data,
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const label = context.label || '';
                                            const value = context.raw || 0;
                                            const percentage = Math.round((value / total) * 100);
                                            return `${label}: ${value} (${percentage}%)`;
                                        }
                                    }
                                }
                            },
                            animation: {
                                duration: 1000,
                                easing: 'easeOutQuart',
                                animateScale: true,
                                animateRotate: true
                            }
                        }
                    };

                    const chartExistente = Chart.getChart(canvas);
                    if (chartExistente) {
                        chartExistente.destroy();
                    }

                    setTimeout(() => {
                        new Chart(canvas, config);
                        $(canvas).addClass('chart-fade-in');
                    }, index * 200);
                });
            }

            function establecerValoresPorDefecto() {
                const ahora = new Date();
                const primerDiaMes = new Date(ahora.getFullYear(), ahora.getMonth(), 1);
                const ultimoDiaMes = new Date(ahora.getFullYear(), ahora.getMonth() + 1, 0);
                $('#fechaInicio').val(primerDiaMes.toISOString().split('T')[0]);
                $('#fechaFin').val(ultimoDiaMes.toISOString().split('T')[0]);

                $('#diaSemanaProgramado').val('Friday');

                // Establecer valores por defecto más razonables
                $('#horaProgramadaHoras1').val('01');
                $('#horaProgramadaMinutos1').val('00');
                $('#horaProgramadaPeriodo1').val('PM');

                // Segundo horario vacío por defecto
                $('#horaProgramadaHoras2').val('');
                $('#horaProgramadaMinutos2').val('00');
                $('#horaProgramadaPeriodo2').val('PM');

                actualizarInfoReporte();
                actualizarInfoProgramacion();
            }


            // Eventos para el selector de usuarios
            $('#btnSeleccionarUsuarios').click(function() {
                const contenedor = $('#contenedorUsuarios');
                const iconoFlecha = $(this).find('i.fa-chevron-down, i.fa-chevron-up');

                if (contenedor.is(':visible')) {
                    contenedor.slideUp();
                    iconoFlecha.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                } else {
                    contenedor.slideDown();
                    iconoFlecha.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                    // Cargar usuarios si es la primera vez
                    if ($('#listaUsuarios').children().length === 1) {
                        cargarUsuariosAdministradores();
                    }
                }
            });

            // Seleccionar/deseleccionar todos
            $('#seleccionarTodos').change(function() {
                $('.usuario-checkbox').prop('checked', $(this).is(':checked'));
            });

            // Actualizar "Seleccionar todos" cuando se cambien checkboxes individuales
            $('#listaUsuarios').on('change', '.usuario-checkbox', function() {
                const totalCheckboxes = $('.usuario-checkbox').length;
                const checkedCount = $('.usuario-checkbox:checked').length;
                $('#seleccionarTodos').prop('checked', totalCheckboxes === checkedCount);
            });

            // Eventos para fechas y programación
            $('#fechaInicio, #fechaFin').change(actualizarInfoReporte);
            $('#diaSemanaProgramado, #horaProgramadaHoras1, #horaProgramadaMinutos1, #horaProgramadaPeriodo1, #horaProgramadaHoras2, #horaProgramadaMinutos2, #horaProgramadaPeriodo2').change(actualizarInfoProgramacion);
            $('#filtroFechaInicio, #filtroFechaFin, #filtroZona').change(actualizarInfoFiltroGraficas);

            // Botón Enviar Manual
            $('#btnEnviarCorreo').click(function() {
                const btn = $(this);
                const fechaInicio = $('#fechaInicio').val();
                const fechaFin = $('#fechaFin').val();
                const usuariosSeleccionados = obtenerUsuariosSeleccionados();

                if (!fechaInicio || !fechaFin) {
                    mostrarAlerta('Por favor, selecciona el rango de fechas.', 'warning', '#mensajeResultado');
                    return;
                }
                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    mostrarAlerta('La fecha de inicio no puede ser mayor a la fecha fin.', 'warning', '#mensajeResultado');
                    return;
                }

                // Si no se seleccionaron usuarios, usar los que tienen reportes activados por defecto
                if (usuariosSeleccionados.length === 0) {
                    if (!confirm('No has seleccionado usuarios específicos. ¿Deseas enviar el reporte a todos los administradores que tienen habilitados los reportes?')) {
                        return;
                    }
                }

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Enviando...');
                $('#mensajeResultado').empty();

                $.ajax({
                    url: '@Url.Action("EnviarCorreoPrueba", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        fechaInicio: fechaInicio,
                        fechaFin: fechaFin,
                        usuarios: usuariosSeleccionados
                    }),
                    success: function(response) {
                        mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeResultado');
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Error de conexión al enviar el correo.';
                        mostrarAlerta(errorMsg, 'danger', '#mensajeResultado');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Enviar Ahora');
                    }
                });
            });

            // Botón Programar Semanal (actualizado para múltiples horarios)
            $('#btnProgramarEnvio').click(function() {
                const btn = $(this);
                const diaSemana = $('#diaSemanaProgramado').val();
                const horasProgramadas = obtenerHorasSeleccionadas();

                if (!diaSemana || horasProgramadas.length === 0) {
                    mostrarAlerta('Por favor, selecciona el día y al menos un horario.', 'warning', '#mensajeProgramacion');
                    return;
                }

                // Validar formato de horas
                for (let hora of horasProgramadas) {
                    if (!/^\d{2}:\d{2}$/.test(hora)) {
                        mostrarAlerta('El formato de hora debe ser HH:mm (ej. 09:30).', 'warning', '#mensajeProgramacion');
                        return;
                    }
                }

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Programando...');
                $('#mensajeProgramacion').empty();

                $.ajax({
                    url: '@Url.Action("ProgramarEnvioCorreo", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        diaSemana: diaSemana,
                        horasProgramadas: horasProgramadas
                    }),
                    success: function(response) {
                        mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeProgramacion');
                        if(response.success) {
                            cargarConfiguracionActual();
                        }
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Error de conexión al programar.';
                        mostrarAlerta(errorMsg, 'danger', '#mensajeProgramacion');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-save me-2"></i>Guardar Programación');
                    }
                });
            });

            // Botón Eliminar Programación
            $('#btnEliminarProgramacion').click(function() {
                const btn = $(this);

                Swal.fire({
                    title: '¿Eliminar Programación?',
                    text: "Se quitará el envío semanal automático.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Eliminando...');
                        $('#mensajeProgramacion').empty();

                        $.ajax({
                            url: '@Url.Action("EliminarProgramacion", "Dashboard")',
                            type: 'POST',
                            success: function(response) {
                                mostrarAlerta(response.message, response.success ? 'success' : 'danger', '#mensajeProgramacion');
                                if(response.success) {
                                     cargarConfiguracionActual();
                                }
                            },
                            error: function(xhr) {
                                const errorMsg = xhr.responseJSON?.message || 'Error de conexión al eliminar.';
                                mostrarAlerta(errorMsg, 'danger', '#mensajeProgramacion');
                            },
                            complete: function() {
                                if (!$('#btnEliminarProgramacion').is(':hidden')) {
                                     btn.prop('disabled', false).html('<i class="fas fa-trash me-2"></i>Eliminar Programación');
                                }
                            }
                        });
                    }
                });
            });

            // Botón Filtrar Gráficas
            $('#btnFiltrarGraficas').click(function() {
                const fechaInicio = $('#filtroFechaInicio').val();
                const fechaFin = $('#filtroFechaFin').val();
                const zonaSeleccionada = $('#filtroZona').val();

                if (!fechaInicio || !fechaFin) {
                    mostrarAlerta('Por favor, selecciona el rango de fechas.', 'warning', '#mensajeGraficas');
                    return;
                }

                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    mostrarAlerta('La fecha de inicio no puede ser mayor a la fecha fin.', 'warning', '#mensajeGraficas');
                    return;
                }

                cargarGraficasConFiltroCompleto(fechaInicio, fechaFin, zonaSeleccionada);
            });

            // --- INICIALIZACIÓN ---
            establecerValoresPorDefecto();
            cargarConfiguracionActual();
            establecerFechasPorDefectoGraficas();

            // Inicializar gráficas con un delay para permitir animaciones
            setTimeout(inicializarGraficas, 800);

            // Cargar gráficas iniciales
            cargarGraficasConFiltroCompleto(
                $('#filtroFechaInicio').val(),
                $('#filtroFechaFin').val(),
                $('#filtroZona').val()
            );
        });
    </script>
}